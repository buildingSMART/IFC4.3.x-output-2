						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate id="i1392" GlobalId="3TyZQASiD68xaHz3JC4Xeu" Name="EnergySource" Description="Enumeration defining the energy source or fuel combusted to generate heat if applicable.  Note: hydronic heaters shall use UNSET; dual-use hydronic/electric heaters shall use ELECTRICITY." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_EnergySource">
