				<IfcPropertySetTemplate id="i385" GlobalId="1WqlIvvu96zedruLGqvnZ1" Name="Qto_BeamBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of beams." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcBeam">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i386" GlobalId="3HAJVhcK15aw_kd5ahVYMn" Name="Length" Description="Total length of the beam, not taking into account any cut-out&apos;s or other processing features." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i387" GlobalId="0PPnhNUJTDPeNa7OZnh4ij" Name="CrossSectionArea" Description="Total area of the cross section (or profile) of the beam." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i388" GlobalId="1979RC2snAGOJD0JG1bmlb" Name="OuterSurfaceArea" Description="Total area of the extruded surfaces of the beam (not taking into account the end cap areas), normally generated as perimeter * length." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i389" GlobalId="184cNPB754Ig7C0fjvOfSD" Name="GrossSurfaceArea" Description="Total area of the beam, normally generated as perimeter * length + 2 * cross section area. It is the sum of OuterSurfaceArea + (2 x CrossSectionArea) and shall only be given, if the OuterSurfaceArea and CrossSectionArea cannot be established separately." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i390" GlobalId="0AxNPioRr2f8eBaIvLf9Ep" Name="NetSurfaceArea" Description="Net surface area of the beam, normally generated as perimeter * length + 2 * cross section area taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses. " TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i391" GlobalId="1yO7vl54P1TQOXcUVdO$xX" Name="GrossVolume" Description="Total gross volume of the beam, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i392" GlobalId="19Q0M8kyH4v9Gbdu9MtQKp" Name="NetVolume" Description="Total net volume of the beam, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i393" GlobalId="2LSqYKQbr9uBpg1Y1sZLZ4" Name="GrossWeight" Description="Total gross weight of the beam without add-on parts, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
						<IfcSimplePropertyTemplate id="i394" GlobalId="3G4CRKBErADwaGyOSxpRYZ" Name="NetWeight" Description="Total net weight of the beam without add-on parts, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
					</HasPropertyTemplates>
