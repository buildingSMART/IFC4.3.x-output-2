						<IfcSimplePropertyTemplate id="i399" GlobalId="3azvi2X2n83u27ua2yTjY7" Name="CrossSectionArea" Description="Total area of the cross section (or profile) of the column." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i400" GlobalId="2bzs4tmt52fxOPREm6CF_J" Name="OuterSurfaceArea" Description="Total area of the extruded surfaces of the column (not taking into account the end cap areas), normally generated as perimeter * length." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i401" GlobalId="20Esv0DRX5ygqyDjBoU9UK" Name="GrossSurfaceArea" Description="Total area of the column, normally generated as perimeter * length + 2 * cross section area. It is the sum of OuterSurfaceArea + (2 x CrossSectionArea) and shall only be given, if the OuterSurfaceArea and CrossSectionArea cannot be established separately." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i402" GlobalId="1KDEyaMeH909yIpPWeAltl" Name="NetSurfaceArea" Description="Net surface area of the column, normally generated as perimeter * length + 2 * cross section area taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses. " TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i403" GlobalId="3OYqYJKmPDBO6hW164LcIC" Name="GrossVolume" Description="Total gross volume of the column, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i404" GlobalId="0ERrc84nT7dgK$K5D$GP2M" Name="NetVolume" Description="Total net volume of the column, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i405" GlobalId="0NZqCLyJL038dOoXtrPjvo" Name="GrossWeight" Description="Total gross weight of the column without add-on parts, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
						<IfcSimplePropertyTemplate id="i406" GlobalId="2nny49wjT6zvfybFrRK81A" Name="NetWeight" Description="Total net weight of the column without add-on parts, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
