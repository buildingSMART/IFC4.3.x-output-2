				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i411" GlobalId="2mL_7pbyzDRQzec4nXsUe8" Name="Qto_CurtainWallQuantities" Description="Base quantities that are common to the definition of all occurrences of curtain walls." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcCurtainWall">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i412" GlobalId="0r0CjuAFbF5ht38RfIA5VC" Name="Length" Description="Total length of the curtain wall along the cutain wall center line (even if different to the curtain wall path)." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i413" GlobalId="1KsfmdV9XDWPeiUZciB6O0" Name="Height" Description="Total height of the curtain wall. It should only be provided, if it is constant along the curtain wall path. " TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i414" GlobalId="1umP6DTx1ARBiyRaOC1gIU" Name="Width" Description="Thickness of the curtain wall. It should only be provided, if it is constant along the curtain wall path. " TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i415" GlobalId="1zC$OvtlX2yx3GZJuKLxl$" Name="GrossSideArea" Description="Area of the curtain wall as viewed by an elevation view of the middle plane of the curtain wall.  It does not take into account any curtain wall modifications. " TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i416" GlobalId="0FyqBJJ3P1O8EEKU9cgC1X" Name="NetSideArea" Description="Area of the curtain wall as viewed by an elevation view of the middle plane of the curtain wall. It does take into account all curtain wall modifications. " TemplateType="q_area" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i417" GlobalId="1AwqSBBljB1RN5AiAiBqI8" Name="Qto_DoorBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of doors." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcDoor">
