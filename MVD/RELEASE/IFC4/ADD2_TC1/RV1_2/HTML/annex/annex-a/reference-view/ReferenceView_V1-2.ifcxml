	</RelatedObjects>
	<RelatingLibrary>
		<IfcLibraryReference Location="" Name="AccessibleAuPublic" Description="Indique si l&apos;espace (par exemple des toilettes) est conçu pour être un espace accessible au public (TRUE) ou non (FALSE)." Language="fr-FR" />
	</RelatingLibrary>
</IfcRelAssociatesLibrary>
