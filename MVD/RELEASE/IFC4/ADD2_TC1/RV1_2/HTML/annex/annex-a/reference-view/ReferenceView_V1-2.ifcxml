									<IfcLabel-wrapper>NOTKNOWN</IfcLabel-wrapper>
									<IfcLabel-wrapper>UNSET</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate id="i1179" GlobalId="2cjWk3aRX68RyUsn0_27_l" Name="SprayType" Description="SprayFilled: Water is sprayed into airflow.
SplashTypeFill: water cascades over successive rows of splash bars.
FilmTypeFill: water flows in a thin layer over closely spaced sheets." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_CoolingTowerSprayType">
								<EnumerationValues>
									<IfcLabel-wrapper>SPRAYFILLED</IfcLabel-wrapper>
