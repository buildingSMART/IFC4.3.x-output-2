						<IfcSimplePropertyTemplate id="i1454" GlobalId="25twm0qXKHuO00025QrE$V" Name="IsolatorStaticDeflection" Description="Static deflection of the vibration isolator." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLengthMeasure" SecondaryMeasureType="" />
