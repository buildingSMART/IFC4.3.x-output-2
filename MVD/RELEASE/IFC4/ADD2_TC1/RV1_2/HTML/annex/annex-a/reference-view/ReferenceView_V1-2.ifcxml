	</RelatedObjects>
	<RelatingLibrary>
		<IfcLibraryReference Location="" Name="Reference" Description="Référence à l&apos;identifiant d&apos;un type spécifié dans le contexte du projet (exemple : &quot;type A1&quot;). Utilisé pour enregistrer un type sans recourir à une classification." Language="fr-FR" />
	</RelatingLibrary>
</IfcRelAssociatesLibrary>
