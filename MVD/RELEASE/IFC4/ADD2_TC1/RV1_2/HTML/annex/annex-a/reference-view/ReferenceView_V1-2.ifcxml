	</RelatedObjects>
	<RelatingLibrary>
		<IfcLibraryReference Location="" Name="Etat" Description="Etat de l&apos;élément, utilisé avant tout pour les projets de rénovation et réaménagement. L&apos;état assigné peut être &quot;Nouveau&quot; - l&apos;élément prévu pour du neuf, &quot;Existant&quot; - l&apos;élément existait et est maintenu, &quot;Démoli&quot; - l&apos;élément existait mais doit être démoli/supprimé, &quot;Provisoire&quot; - l&apos;élément existera à titre provisoire seulement (comme un support structurel par exemple)." Language="fr-FR" />
	</RelatingLibrary>
</IfcRelAssociatesLibrary>
