	</RelatedObjects>
	<RelatingLibrary>
		<IfcLibraryReference Location="" Identification="THERMOSTATIC" Name="Thermostatic" Description="A valve in which the ports are opened or closed to maintain a required predetermined temperature" Language="en" />
