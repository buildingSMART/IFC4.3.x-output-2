						<IfcSimplePropertyTemplate id="i313" GlobalId="2Xt540qWSHuO00025QrE$V" Name="Roughness" Description="A measure of the vertical deviations of the surface." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i314" GlobalId="2eQiY0qWSHuO00025QrE$V" Name="SurfaceColor" Description="The color of the surface." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
