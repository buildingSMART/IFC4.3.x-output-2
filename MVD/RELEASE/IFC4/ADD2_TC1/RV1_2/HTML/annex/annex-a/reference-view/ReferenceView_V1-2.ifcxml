				<IfcPropertySetTemplate id="i407" GlobalId="3chsxKUDb01fGyiSzCJuqu" Name="Qto_CoveringBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of coverings applied to spaces." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcCovering">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i408" GlobalId="11fv2IEvP6SP_YXmR3EWfq" Name="Width" Description="Nominal width (or thickness) of the plate. Only given, if the covering is prismatic (constant thickess). " TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i409" GlobalId="1v7Z5Yk4T0fu61b7WfpuHO" Name="GrossArea" Description="Sum of all gross areas of the covering facing the space. No opening that is included in the covering is subtracted." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i410" GlobalId="184ko6bvr3dxtoDs6$yNLT" Name="NetArea" Description="Sum of all net areas  of the covering facing the space. All openings that is included in the covering are subtracted." TemplateType="q_area" />
