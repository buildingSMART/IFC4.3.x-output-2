						<IfcSimplePropertyTemplate id="i325" GlobalId="0kXmy0qWWHuO00025QrE$V" Name="ThermalTransmittance" Description="Thermal transmittance coefficient (U-Value) of a material. Here the total thermal transmittance coefficient through the slab (including all materials)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermalTransmittanceMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i326" GlobalId="0x2sU0qWWHuO00025QrE$V" Name="LoadBearing" Description="Indicates whether the object is intended to carry loads (TRUE) or not (FALSE)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" />
