						<IfcSimplePropertyTemplate id="i1108" GlobalId="2j48m0qSaHuO00025QrE$V" Name="OperationalTemperatureRange" Description="Allowable operational air temperature range." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1109" GlobalId="2qq320qSaHuO00025QrE$V" Name="AirflowRateRange" Description="Possible range of airflow that can be delivered.  For cases where there is no airflow across the coil (e.g. electric coil in a floor slab), then the value is zero." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcVolumetricFlowRateMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1110" GlobalId="2xNgW0qSaHuO00025QrE$V" Name="NominalSensibleCapacity" Description="Nominal sensible capacity." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1111" GlobalId="308rm0qSaHuO00025QrE$V" Name="NominalLatentCapacity" Description="Nominal latent capacity." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1112" GlobalId="35WAQ0qSaHuO00025QrE$V" Name="NominalUA" Description="Nominal UA value." TemplateType="p_singlevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1113" GlobalId="14WgTqkfv9nhg9brb4cagJ" Name="PlacementType" Description="Indicates the placement of the coil.  
FLOOR indicates an under floor heater (if coil type is WATERHEATINGCOIL or ELECTRICHEATINGCOIL); 
CEILING indicates a cooling ceiling (if coil type is WATERCOOLINGCOIL);
UNIT indicates that the coil is part of a cooling or heating unit, like cooled beam, etc." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
