						<IfcSimplePropertyTemplate id="i1411" GlobalId="06cwc0qX0HuO00025QrE$V" Name="NominalCapacity" Description="The total nominal or design volumetric capacity of the tank." TemplateType="p_singlevalue" PrimaryMeasureType="IfcVolumeMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1412" GlobalId="0AnyS0qX0HuO00025QrE$V" Name="EffectiveCapacity" Description="The total effective or actual volumetric capacity of the tank." TemplateType="p_singlevalue" PrimaryMeasureType="IfcVolumeMeasure" SecondaryMeasureType="" />
