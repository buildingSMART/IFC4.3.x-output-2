						<IfcSimplePropertyTemplate id="i941" GlobalId="2hYjSZFQj5IO0cIqjFIKxt" Name="SwitchFunction" Description="Indicates types of switches which differs in functionality." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
