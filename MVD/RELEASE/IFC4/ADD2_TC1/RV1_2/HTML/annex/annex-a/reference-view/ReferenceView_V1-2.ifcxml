						<IfcSimplePropertyTemplate id="i1409" GlobalId="3tjFS0qWyHuO00025QrE$V" Name="NominalWidthOrDiameter" Description="The nominal width or, in the case of a horizontal cylindrical tank, the nominal diameter of the tank.

Note: Not required for a vertical cylindrical tank." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1410" GlobalId="3_t0K0qWyHuO00025QrE$V" Name="NominalDepth" Description="The nominal depth of the tank.

