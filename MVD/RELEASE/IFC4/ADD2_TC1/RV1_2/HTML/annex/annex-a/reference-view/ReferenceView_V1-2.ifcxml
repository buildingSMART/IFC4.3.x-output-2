				<IfcPropertySetTemplate id="i770" GlobalId="21wcI0qUeHuO00025QrE$V" Name="Pset_JunctionBoxTypeCommon" Description="A junction box is an enclosure within which cables are connected.

History: New in IFC4" TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcJunctionBox">
					<HasPropertyTemplates>
