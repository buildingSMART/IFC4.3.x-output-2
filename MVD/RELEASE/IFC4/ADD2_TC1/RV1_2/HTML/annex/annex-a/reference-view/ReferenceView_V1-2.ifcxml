	<RelatingLibrary>
		<IfcLibraryReference Location="" Name="Bauteiltyp" Description="Bezeichnung zur Zusammenfassung gleichartiger Bauteile zu einem Bauteiltyp (auch Konstruktionstyp genannt). Alternativ zum Namen des &quot;Typobjekts&quot;, insbesondere wenn die Software keine Typen unterstützt." Language="de-DE" />
