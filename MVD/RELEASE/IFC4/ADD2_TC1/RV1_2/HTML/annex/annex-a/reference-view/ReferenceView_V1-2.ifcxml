		<IfcSimplePropertyTemplate xsi:nil="true" href="i106" />
	</RelatedObjects>
	<RelatingLibrary>
		<IfcLibraryReference Location="" Name="公共アクセス可能性" Description="この部屋（空間）が公共アクセス空間かどうかを示すブーリアン値。例：公共トイレの場合TRUE。" Language="ja-JP" />
	</RelatingLibrary>
</IfcRelAssociatesLibrary>
<IfcRelAssociatesLibrary GlobalId="2MxwSTXLDDE8qkUL1Is0FM">
	<RelatedObjects>
		<IfcSimplePropertyTemplate xsi:nil="true" href="i106" />
	</RelatedObjects>
	<RelatingLibrary>
		<IfcLibraryReference Location="" Name="공공 액세스 가능성" Description="이 방 (공간)이 공공 액세스 공간 여부를 나타내는 부울 값입니다. 예 : 공공 화장실의 경우 TRUE." Language="ko-KR" />
	</RelatingLibrary>
</IfcRelAssociatesLibrary>
<IfcRelAssociatesLibrary GlobalId="06K4TSxdf8Jui26QFS6oDg">
	<RelatedObjects>
