				<IfcPropertySetTemplate id="i1588" GlobalId="0g1Ii0qVKHuO00025QrE$V" Name="Pset_PrecastSlab" Description="Layout and component information defining how prestressed slab components are laid out in a precast slab assembly. The values are global defaults for the slab as a whole, but can be overridden by local placements of the individual com" TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcSlab">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1589" GlobalId="0l_mm0qVKHuO00025QrE$V" Name="TypeDesignator" Description="Type designator for the precast concrete slab, expressing mainly the component type. Possible values are “Hollow-core”, “Double-tee”, “Flat plank”, etc." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1590" GlobalId="0sYOE0qVKHuO00025QrE$V" Name="ToppingType" Description="Defines if a topping is applied and what kind. Values are “Full topping”, “Perimeter Wash”, “None”" TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1591" GlobalId="0yVsI0qVKHuO00025QrE$V" Name="EdgeDistanceToFirstAxis" Description="The distance from the left (‘West’) edge of the slab (in the direction of span of the components) to the axis of the first component." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1592" GlobalId="133Tm0qVKHuO00025QrE$V" Name="DistanceBetweenComponentAxes" Description="The distance between the axes of the components, measured along the ‘South’ edge of the slab." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1593" GlobalId="1ADEe0qVKHuO00025QrE$V" Name="AngleToFirstAxis" Description="The angle of rotation of the axis of the first component relative to the ‘West’ edge of the slab." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPlaneAngleMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1594" GlobalId="1E_Pu0qVKHuO00025QrE$V" Name="AngleBetweenComponentAxes" Description="The angle between the axes of each pair of components." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPlaneAngleMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1595" GlobalId="1KLkY0qVKHuO00025QrE$V" Name="NominalThickness" Description="The nominal overall thickness of the slab." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
