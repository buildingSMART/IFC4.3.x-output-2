						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate id="i732" GlobalId="0f5Sw0qU0HuO00025QrE$V" Name="NominalSupplyVoltage" Description="The nominal voltage of the supply." TemplateType="p_singlevalue" PrimaryMeasureType="IfcElectricVoltageMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i733" GlobalId="0kSna0qU0HuO00025QrE$V" Name="NominalSupplyVoltageOffset" Description="The maximum and minimum allowed voltage of the supply e.g. boundaries of 380V/440V may be applied for a nominal voltage of 400V." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcElectricVoltageMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i734" GlobalId="0rcYS0qU0HuO00025QrE$V" Name="NominalFrequency" Description="The nominal frequency of the supply." TemplateType="p_singlevalue" PrimaryMeasureType="IfcFrequencyMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i735" GlobalId="3akcUK$ar8GRc1YER0WRht" Name="ConnectedConductorFunction" Description="Function of the conductors to which the load is connected." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_ConductorFunctionEnum">
