						<IfcSimplePropertyTemplate GlobalId="0zQBvuVW98lQnxrINKc$Sn" Name="LongitudinalBarSpacing" Description="The spacing between the longitudinal bars. Note: an even distribution of bars is presumed; other cases are handled by classification or property sets." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="2KbQjldnj9wA_k51rnQc00" Name="LongitudinalBarSurface" Description="Indicator for whether the bar surface is plain or textured." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_ReinforcementBarSurface">
								<EnumerationValues>
									<IfcLabel-wrapper>PLAIN</IfcLabel-wrapper>
									<IfcLabel-wrapper>TEXTURED</IfcLabel-wrapper>
									<IfcLabel-wrapper>OTHER</IfcLabel-wrapper>
									<IfcLabel-wrapper>USERDEFINED</IfcLabel-wrapper>
									<IfcLabel-wrapper>NOTDEFINED</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate GlobalId="0hUEFetq96aR$dOAQd$WVe" Name="LongitudinalBarBendingShapeCode" Description="If this mesh is bent longitudinal rather than planar, this attribute provides a shape code per a standard like ACI 315, ISO 3766, or a similar standard.  It is presumed that a single standard for defining the bar bending is used throughout the project and that this standard is referenced from the &lt;em&gt;IfcProject&lt;/em&gt; object through the &lt;em&gt;IfcDocumentReference&lt;/em&gt; mechanism." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="2ryyC1btrDFBeJEx2uaUMI" Name="LongitudinalBarBendingParameters" Description="If this mesh type is bent longitudinal rather than planar, this attribute provides bending shape parameters. Their meaning is defined by the bending shape code and the respective standard." TemplateType="p_listvalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="2pXxXg8PH4zRbXzhVTDrAk" Name="TransverseBarNominalDiameter" Description="The nominal diameter denoting the cross-section size of the transverse bars." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="1VnCDpQAj5Y9$nQc__Xtmu" Name="TransverseBarSpacing" Description="The spacing between the transverse bars. Note: an even distribution of bars is presumed; other cases are handled by classification or property sets." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="2KbQjldnj9wA_k51rnQc00" Name="TransverseBarSurface" Description="Indicator for whether the bar surface is plain or textured." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_ReinforcementBarSurface">
								<EnumerationValues>
									<IfcLabel-wrapper>PLAIN</IfcLabel-wrapper>
									<IfcLabel-wrapper>TEXTURED</IfcLabel-wrapper>
									<IfcLabel-wrapper>OTHER</IfcLabel-wrapper>
									<IfcLabel-wrapper>USERDEFINED</IfcLabel-wrapper>
									<IfcLabel-wrapper>NOTDEFINED</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate GlobalId="0OepHgUSb8ygLobAS7j8QC" Name="TransverseBarBendingShapeCode" Description="If this mesh is bent transversal rather than planar, this attribute provides a shape code per a standard like ACI 315, ISO 3766, or a similar standard. It is presumed that a single standard for defining the bar bending is used throughout the project and that this standard is referenced from the &lt;em&gt;IfcProject&lt;/em&gt; object through the &lt;em&gt;IfcDocumentReference&lt;/em&gt; mechanism." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="0$taXa9srEXB9I1d3ai9u4" Name="TransverseBarBendingParameters" Description="If this mesh type is bent transversal rather than planar, this attribute provides bending shape parameters. Their meaning is defined by the bending shape code and the respective standard." TemplateType="p_listvalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate GlobalId="051Tm39fD0WxifcMxVjaLo" Name="Pset_TendonAnchorCommon" Description="Properties common to the definition of all occurrences of IfcTendonAnchor." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcTendonAnchor">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1649" GlobalId="2rbnE3HtHD6hMy4aEGfmky" Name="Reference" Description="Reference ID for this specified type in this project (e.g. type &apos;A-1&apos;)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1650" GlobalId="2KCc_Rd5D99x5nZnZcj2$j" Name="Status" Description="Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_ElementStatus">
								<EnumerationValues>
									<IfcLabel-wrapper>NEW</IfcLabel-wrapper>
									<IfcLabel-wrapper>EXISTING</IfcLabel-wrapper>
									<IfcLabel-wrapper>DEMOLISH</IfcLabel-wrapper>
									<IfcLabel-wrapper>TEMPORARY</IfcLabel-wrapper>
									<IfcLabel-wrapper>OTHER</IfcLabel-wrapper>
									<IfcLabel-wrapper>NOTKNOWN</IfcLabel-wrapper>
									<IfcLabel-wrapper>UNSET</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate GlobalId="2rVgHL2grBiOiYDV2rgZw$" Name="Pset_TendonCommon" Description="Properties common to the definition of all occurrences of IfcTendon." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcTendon">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1651" GlobalId="1s$wXlplz2OAWsqC1oj_Ci" Name="Reference" Description="Reference ID for this specified type in this project (e.g. type &apos;A-1&apos;)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1652" GlobalId="2KCc_Rd5D99x5nZnZcj2$j" Name="Status" Description="Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_ElementStatus">
								<EnumerationValues>
									<IfcLabel-wrapper>NEW</IfcLabel-wrapper>
									<IfcLabel-wrapper>EXISTING</IfcLabel-wrapper>
									<IfcLabel-wrapper>DEMOLISH</IfcLabel-wrapper>
									<IfcLabel-wrapper>TEMPORARY</IfcLabel-wrapper>
									<IfcLabel-wrapper>OTHER</IfcLabel-wrapper>
									<IfcLabel-wrapper>NOTKNOWN</IfcLabel-wrapper>
									<IfcLabel-wrapper>UNSET</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate GlobalId="0A8c8X4yP2xOKuafrNBsaG" Name="NominalDiameter" Description="The nominal diameter defining the cross-section size of the prestressed part of the tendon." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="2bINAwQGv0JRbqIZPSxDEp" Name="SheathDiameter" Description="Diameter of the sheeth (duct) around the tendon, if there is one with this type of tendon." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="28NKzMd$HEURfxZA_E5HDd" Name="TensionForce" Description="The maximum allowed tension force that can be applied on the tendon." TemplateType="p_singlevalue" PrimaryMeasureType="IfcForceMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="0vGcAdKXjEbwPbt3MCzytQ" Name="PreStress" Description="The prestress to be applied on the tendon." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="2lBYXpeqH0fAOv4$AubOKe" Name="FrictionCoefficient" Description="The friction coefficient between tendon and tendon sheet while the tendon is unbonded." TemplateType="p_singlevalue" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="1tTPpM2Pv6Lfnq$Ysz1WN0" Name="AnchorageSlip" Description="The deformation of an anchor or slippage of tendons when the prestressing device is released." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="3ZxoiDz1X2twNZzftchRr$" Name="MinCurvatureRadius" Description="The smallest curvature radius calculated on the whole effective length of the tendon where the tension properties are still valid." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1653" GlobalId="0S8Fx9Ucb6dQcR8Wu0A85Z" Name="Qto_FootingBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of footings." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcFooting">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1654" GlobalId="21NkL6Eqj1Y9ibmbKT0sJZ" Name="Length" Description="Length of the footing, not taking into account any cut-out&apos;s or other processing features. For strip footings it is measured along the path, for other footings it is one of the horizontal dimensions. It should only be provided, if it is constant." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i1655" GlobalId="3iDhtJHuzC_gCAj5wdpWJh" Name="Width" Description="Total nominal width (or thickness) of the footing. For strip footings it is measured perpendicular to the footing path (or longitudial axis). For other footings it is one of the horizontal dimensions. It should only be provided, if it is constant." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i1656" GlobalId="2fZo2S2rzBOhweGqI3yt36" Name="Height" Description="Total nominal height of the footing. It should only be provided, if it is constant." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i1657" GlobalId="2$G4u$rCL82vYqsTtwoWn4" Name="CrossSectionArea" Description="Total area of the cross section (or profile) of the footing." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i1658" GlobalId="1MQJVdT3vDvO46QW5xymoP" Name="OuterSurfaceArea" Description="Total area of the extruded surfaces of the footing (not taking into account the end cap areas), normally generated as perimeter * length." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i1659" GlobalId="0hLLA7UuvCVPodj1bFWFtl" Name="GrossSurfaceArea" Description="Total area of the footing, normally generated as perimeter * length + 2 * cross section area. It is the sum of OuterSurfaceArea + (2 x CrossSectionArea) and shall only be given, if the OuterSurfaceArea and CrossSectionArea cannot be established separately." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i1660" GlobalId="3Wcqtil2n9iwS_wUu2QT78" Name="GrossVolume" Description="Total gross volume of the footing, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i1661" GlobalId="0$PYHARu5Fux5AkfGewlyK" Name="NetVolume" Description="Total net volume of the footing, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i1662" GlobalId="3_haAJs21108lznLPBkIMM" Name="GrossWeight" Description="Total gross weight of the footing without add-on parts, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
						<IfcSimplePropertyTemplate id="i1663" GlobalId="3X6e4PloT6uwGFdMcoS7$x" Name="NetWeight" Description="Total net weight of the footing without add-on parts, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1664" GlobalId="2G1lJVyMT9kvpPesdMi1jZ" Name="Qto_PileBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of piles." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcPile">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1665" GlobalId="2XuGBfa51FBAheQBk7g7Tw" Name="Length" Description="Total length of the pile not taking into account any cut-out&apos;s or other processing features." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i1666" GlobalId="0emE4jyCbE2fJiXgNRE_O9" Name="CrossSectionArea" Description="Total area of the cross section (or profile) of the pile." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i1667" GlobalId="2PoZ2InkrCWeWRYmdawrLU" Name="OuterSurfaceArea" Description="Total area of the extruded surfaces of the pile (not taking into account the end cap areas), normally generated as perimeter * length." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i1668" GlobalId="11MDrBp2P3uAraI7SKsVMq" Name="GrossSurfaceArea" Description="Total area of the pile, normally generated as perimeter * length + 2 * cross section area. It is the sum of OuterSurfaceArea + (2 x CrossSectionArea) and shall only be given, if the OuterSurfaceArea and CrossSectionArea cannot be established separately." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i1669" GlobalId="38iKg02F54r909_c7iOrrL" Name="GrossVolume" Description="Total gross volume of the pile, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i1670" GlobalId="1nK2mIiXXDEwjVfHsSPCXF" Name="NetVolume" Description="Total net volume of the pile, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i1671" GlobalId="0pK5JtwqjBqOGb7AJQkCo1" Name="GrossWeight" Description="Total gross weight of the pile without add-on parts, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
						<IfcSimplePropertyTemplate id="i1672" GlobalId="0c7KxPg89A2QfJ4F5cvaOv" Name="NetWeight" Description="Total net weight of the pile without add-on parts, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate GlobalId="1yBk2ygZz9TxxfkC_gyWZV" Name="Qto_ReinforcingElementBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of reinforcement." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcReinforcingElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate GlobalId="3CXRmexyLE4xZy3hpRnxmb" Name="Count" Description="Total count of reinforcing items." TemplateType="q_count" />
						<IfcSimplePropertyTemplate GlobalId="1E2FefAfrAtvyN5FmHjQ95" Name="Length" Description="Total length of reinforcing." TemplateType="q_length" />
						<IfcSimplePropertyTemplate GlobalId="2ueoe8QyrBduWuJHsi21zb" Name="Weight" Description="Total weight of reinforcing." TemplateType="q_weight" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1673" GlobalId="2lE180qUmHuO00025QrE$V" Name="Pset_MaterialCombustion" Description="A set of extended material properties of products of combustion generated by elements typically used within the context of building services and flow distribution systems." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1674" GlobalId="2szxQ0qUmHuO00025QrE$V" Name="SpecificHeatCapacity" Description="Specific heat of the products of combustion: heat energy absorbed per temperature unit." TemplateType="p_singlevalue" PrimaryMeasureType="IfcSpecificHeatCapacityMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1675" GlobalId="2yLG40qUmHuO00025QrE$V" Name="N20Content" Description="Nitrous oxide (N2O) content of the products of combustion. This is measured in weight of N2O per unit weight and is therefore unitless." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1676" GlobalId="31iak0qUmHuO00025QrE$V" Name="COContent" Description="Carbon monoxide (CO) content of the products of combustion. This is measured in weight of CO per unit weight and is therefore unitless." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1677" GlobalId="37g2o0qUmHuO00025QrE$V" Name="CO2Content" Description="Carbon dioxide (CO2) content of the products of combustion. This is measured in weight of CO2 per unit weight and is therefore unitless." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1678" GlobalId="3Eppg0qUmHuO00025QrE$V" Name="Pset_MaterialCommon" Description="A set of general material properties." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1679" GlobalId="3IOi60qUmHuO00025QrE$V" Name="MolecularWeight" Description="Molecular weight of material (typically gas)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcMolecularWeightMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1680" GlobalId="3OMAA0qUmHuO00025QrE$V" Name="Porosity" Description="The void fraction of the total volume occupied by material (Vbr - Vnet)/Vbr." TemplateType="p_singlevalue" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1681" GlobalId="3TjUq0qUmHuO00025QrE$V" Name="MassDensity" Description="Material mass density." TemplateType="p_singlevalue" PrimaryMeasureType="IfcMassDensityMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1682" GlobalId="3Zgyu0qUmHuO00025QrE$V" Name="Pset_MaterialConcrete" Description="A set of extended mechanical properties related to concrete materials." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial/Concrete">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1683" GlobalId="3gEaM0qUmHuO00025QrE$V" Name="CompressiveStrength" Description="The compressive strength of the concrete." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1684" GlobalId="3mC2Q0qUmHuO00025QrE$V" Name="MaxAggregateSize" Description="The maximum aggregate size of the concrete." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1685" GlobalId="3tLpI0qUmHuO00025QrE$V" Name="AdmixturesDescription" Description="Description of the admixtures added to the concrete mix." TemplateType="p_singlevalue" PrimaryMeasureType="IfcText" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1686" GlobalId="3yj7y0qUmHuO00025QrE$V" Name="Workability" Description="Description of the workability of the fresh concrete defined according to local standards." TemplateType="p_singlevalue" PrimaryMeasureType="IfcText" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1687" GlobalId="01UJC0qUqHuO00025QrE$V" Name="WaterImpermeability" Description="Description of the water impermeability denoting the water repelling properties." TemplateType="p_singlevalue" PrimaryMeasureType="IfcText" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1688" GlobalId="07RnG0qUqHuO00025QrE$V" Name="ProtectivePoreRatio" Description="The protective pore ratio indicating the frost-resistance of the concrete." TemplateType="p_singlevalue" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1689" GlobalId="0D$Ok0qUqHuO00025QrE$V" Name="Pset_MaterialEnergy" Description="A set of extended material properties for energy calculation purposes." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1690" GlobalId="0IAQa0qUqHuO00025QrE$V" Name="ViscosityTemperatureDerivative" Description="Viscosity temperature derivative." TemplateType="p_singlevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1691" GlobalId="0O7ue0qUqHuO00025QrE$V" Name="MoistureCapacityThermalGradient" Description="Thermal gradient coefficient for moisture capacity. Based on water vapor density." TemplateType="p_singlevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1692" GlobalId="0U5Mi0qUqHuO00025QrE$V" Name="ThermalConductivityTemperatureDerivative" Description="Thermal conductivity temperature derivative." TemplateType="p_singlevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1693" GlobalId="0YsXy0qUqHuO00025QrE$V" Name="SpecificHeatTemperatureDerivative" Description="Specific heat temperature derivative." TemplateType="p_singlevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1694" GlobalId="0eq000qUqHuO00025QrE$V" Name="VisibleRefractionIndex" Description="Index of refraction (visible) defines the &quot;bending&quot; of the sola! r ray in the visible spectrum when it passes from one medium into another." TemplateType="p_singlevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1695" GlobalId="0lNdU0qUqHuO00025QrE$V" Name="SolarRefractionIndex" Description="Index of refraction (solar) defines the &quot;bending&quot; of the solar ray when it passes from one medium into another." TemplateType="p_singlevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1696" GlobalId="0qky80qUqHuO00025QrE$V" Name="GasPressure" Description="Fill pressure (e.g. for between-pane gas fills): the pressure exerted by a mass of gas confined in a constant volume." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1697" GlobalId="0xIZc0qUqHuO00025QrE$V" Name="Pset_MaterialFuel" Description="A set of extended material properties of fuel energy typically used within the context of building services and flow distribution systems." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1698" GlobalId="0_tS20qUqHuO00025QrE$V" Name="CombustionTemperature" Description="Combustion temperature of the material when air is at 298 K and 100 kPa." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1699" GlobalId="14qw60qUqHuO00025QrE$V" Name="CarbonContent" Description="The carbon content in the fuel. This is measured in weight of carbon per unit weight of fuel and is therefore unitless." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1700" GlobalId="1ACEm0qUqHuO00025QrE$V" Name="LowerHeatingValue" Description="Lower Heating Value is defined as the amount of energy released (MJ/kg) when a fuel is burned completely, and H2O is in vapor form in the combustion products." TemplateType="p_singlevalue" PrimaryMeasureType="IfcHeatingValueMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1701" GlobalId="1EzQ00qUqHuO00025QrE$V" Name="HigherHeatingValue" Description="Higher Heating Value is defined as the amount of energy released (MJ/kg) when a fuel is burned completely, and H2O is in liquid form in the combustion products." TemplateType="p_singlevalue" PrimaryMeasureType="IfcHeatingValueMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1702" GlobalId="1LX1U0qUqHuO00025QrE$V" Name="Pset_MaterialHygroscopic" Description="A set of hygroscopic properties of materials." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1703" GlobalId="1P5vw0qUqHuO00025QrE$V" Name="UpperVaporResistanceFactor" Description="The vapor permeability relationship of air/material (typically value &gt; 1), measured in high relative humidity (typically in 95/50 % RH)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1704" GlobalId="1Tt5A0qUqHuO00025QrE$V" Name="LowerVaporResistanceFactor" Description="The vapor permeability relationship of air/material (typically value &gt; 1), measured in low relative humidity (typically in 0/50 % RH)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1705" GlobalId="1ZEPq0qUqHuO00025QrE$V" Name="IsothermalMoistureCapacity" Description="Based on water vapor density." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIsothermalMoistureCapacityMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1706" GlobalId="1d$b40qUqHuO00025QrE$V" Name="VaporPermeability" Description="The rate of water vapor transmission per unit area per unit of vapor pressure differential under test conditions." TemplateType="p_singlevalue" PrimaryMeasureType="IfcVaporPermeabilityMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1707" GlobalId="1iAcw0qUqHuO00025QrE$V" Name="MoistureDiffusivity" Description="Moisture diffusivity is a transport property that is frequently used in the hygrothermal analysis of building envelope components." TemplateType="p_singlevalue" PrimaryMeasureType="IfcMoistureDiffusivityMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1708" GlobalId="1o84_0qUqHuO00025QrE$V" Name="Pset_MaterialMechanical" Description="A set of mechanical material properties normally used for structural analysis purpose. It contains all properties which are independent of the actual material type." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1709" GlobalId="1sJ6q0qUqHuO00025QrE$V" Name="DynamicViscosity" Description="A measure of the viscous resistance of the material." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDynamicViscosityMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1710" GlobalId="1x4I40qUqHuO00025QrE$V" Name="YoungModulus" Description="A measure of the Young&apos;s modulus of elasticity of the material." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1711" GlobalId="20Rck0qUqHuO00025QrE$V" Name="ShearModulus" Description="A measure of the shear modulus of elasticity of the material." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1712" GlobalId="25Cn_0qUqHuO00025QrE$V" Name="PoissonRatio" Description="A measure of the lateral deformations in the elastic range." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1713" GlobalId="2BAG20qUqHuO00025QrE$V" Name="ThermalExpansionCoefficient" Description="A measure of the expansion coefficient for warming up the material about one Kelvin." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermalExpansionCoefficientMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1714" GlobalId="2HjtW0qUqHuO00025QrE$V" Name="Pset_MaterialOptical" Description="A set of optical properties of materials." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1715" GlobalId="2LIly0qUqHuO00025QrE$V" Name="VisibleTransmittance" Description="Transmittance at normal incidence (visible). Defines the fraction of the visible spectrum of solar radiation that passes through per unit area, perpendicular to the surface." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1716" GlobalId="2SSWq0qUqHuO00025QrE$V" Name="SolarTransmittance" Description="Transmittance at normal incidence (solar). Defines the fraction of solar radiation that passes through per unit area, perpendicular to the surface." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1717" GlobalId="2XprU0qUqHuO00025QrE$V" Name="ThermalIrTransmittance" Description="Thermal IR transmittance at normal incidence. Defines the fraction of thermal energy that passes through per unit area, perpendicular to the surface." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1718" GlobalId="2dBA80qUqHuO00025QrE$V" Name="ThermalIrEmissivityBack" Description="Thermal IR emissivity: back side. Defines the fraction of thermal energy emitted per unit area to &quot;blackbody&quot; at the same temperature, through the &quot;back&quot; side of the material." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1719" GlobalId="2iYUo0qUqHuO00025QrE$V" Name="ThermalIrEmissivityFront" Description="Thermal IR emissivity: front side. Defines the fraction of thermal energy emitted per unit area to &quot;blackbody&quot; at the same temperature, through the &quot;front&quot; side of the material." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1720" GlobalId="2tH860qUqHuO00025QrE$V" Name="VisibleReflectanceBack" Description="Reflectance at normal incidence (visible): back side. Defines the fraction of the solar ray in the visible spectrum that is reflected and not transmitted when the ray passes from one medium into another, at the &quot;back&quot; side of the other material, perpendicular to the surface. Dependent on material and surface characteristics." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1721" GlobalId="2zEcA0qUqHuO00025QrE$V" Name="VisibleReflectanceFront" Description="Reflectance at normal incidence (visible): front side. Defines the fraction of the solar ray in the visible spectrum that is reflected and not transmitted when the ray passes from one medium into another, at the &quot;front&quot; side of the other material, perpendicular to the surface. Dependent on material and surface characteristics." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1722" GlobalId="33C4E0qUqHuO00025QrE$V" Name="SolarReflectanceBack" Description="Reflectance at normal incidence (solar): back side. Defines the fraction of the solar ray that is reflected and not transmitted when the ray passes from one medium into another, at the &quot;back&quot; side of the other material, perpendicular to the surface. Dependent on material and surface characteristics." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1723" GlobalId="37zFU0qUqHuO00025QrE$V" Name="SolarReflectanceFront" Description="Reflectance at normal incidence (solar): front side. Defines the fraction of the solar ray that is reflected and not transmitted when the ray passes from one medium into another, at the &quot;front&quot; side of the other material, perpendicular to the surface. Dependent on material and surface characteristics." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1724" GlobalId="3EWsy0qUqHuO00025QrE$V" Name="Pset_MaterialSteel" Description="A set of extended mechanical properties related to steel (or other metallic and isotropic) materials." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial/Steel">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1725" GlobalId="3JuBc0qUqHuO00025QrE$V" Name="YieldStress" Description="A measure of the yield stress (or characteristic 0.2 percent proof stress) of the material." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1726" GlobalId="3Prfg0qUqHuO00025QrE$V" Name="UltimateStress" Description="A measure of the ultimate stress of the material." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1727" GlobalId="3VC_K0qUqHuO00025QrE$V" Name="UltimateStrain" Description="A measure of the (engineering) strain at the state of ultimate stress of the material." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1728" GlobalId="3aaI_0qUqHuO00025QrE$V" Name="HardeningModule" Description="A measure of the hardening module of the material (slope of stress versus strain curve after yield range)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1729" GlobalId="3fxde0qUqHuO00025QrE$V" Name="ProportionalStress" Description="A measure of the proportional stress of the material. It describes the stress before the first plastic deformation occurs and is commonly measured at a deformation of 0.01%." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1730" GlobalId="3lv5i0qUqHuO00025QrE$V" Name="PlasticStrain" Description="A measure of the permanent displacement, as in slip or twinning, which remains after the stress has been removed. Currently applied to a strain of 0.2% proportional stress of the material." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1731" GlobalId="3rGQM0qUqHuO00025QrE$V" Name="Relaxations" Description="Measures of decrease in stress over long time intervals resulting from plastic flow. Different relaxation values for different initial stress levels for a material may be given. It describes the time dependent relative relaxation value for a given initial stress level at constant strain.
Relating values are the &quot;RelaxationValue&quot;. Related values are the &quot;InitialStress&quot;" TemplateType="p_tablevalue" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="IfcNormalisedRatioMeasure" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1732" GlobalId="03Zy60qUuHuO00025QrE$V" Name="Pset_MaterialThermal" Description="A set of thermal material properties." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1733" GlobalId="078qY0qUuHuO00025QrE$V" Name="SpecificHeatCapacity" Description="Defines the specific heat of the material: heat energy absorbed per temperature unit." TemplateType="p_singlevalue" PrimaryMeasureType="IfcSpecificHeatCapacityMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1734" GlobalId="0Bv$o0qUuHuO00025QrE$V" Name="BoilingPoint" Description="The boiling point of the material (fluid)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1735" GlobalId="0HtTs0qUuHuO00025QrE$V" Name="FreezingPoint" Description="The freezing point of the material (fluid)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1736" GlobalId="0Nqxw0qUuHuO00025QrE$V" Name="ThermalConductivity" Description="The rate at which thermal energy is transmitted through the material." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermalConductivityMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1737" GlobalId="0ToP_0qUuHuO00025QrE$V" Name="Pset_MaterialWater" Description="A set of extended material properties for of water typically used within the context of building services and flow distribution systems." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1738" GlobalId="0XNIQ0qUuHuO00025QrE$V" Name="IsPotable" Description="If TRUE, then the water is considered potable." TemplateType="p_singlevalue" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1739" GlobalId="0dKmU0qUuHuO00025QrE$V" Name="Hardness" Description="Water hardness as positive, multivalent ion concentration in the water (usually concentrations of calcium and magnesium ions in terms of calcium carbonate)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIonConcentrationMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1740" GlobalId="0ii580qUuHuO00025QrE$V" Name="AlkalinityConcentration" Description="Maximum alkalinity concentration (maximum sum of concentrations of each of the negative ions substances measured as CaCO3)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIonConcentrationMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1741" GlobalId="0o3Po0qUuHuO00025QrE$V" Name="AcidityConcentration" Description="Maximum CaCO3 equivalent that would neutralize the acid." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIonConcentrationMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1742" GlobalId="0sERe0qUuHuO00025QrE$V" Name="ImpuritiesContent" Description="Fraction of impurities such as dust to the total amount of water. This is measured in weight of impurities per weight of water and is therefore unitless." TemplateType="p_singlevalue" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1743" GlobalId="0w$cu0qUuHuO00025QrE$V" Name="DissolvedSolidsContent" Description="Fraction of the dissolved solids to the total amount of water. This is measured in weight of dissolved solids per weight of water and is therefore unitless." TemplateType="p_singlevalue" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1744" GlobalId="0$mo80qUuHuO00025QrE$V" Name="PHLevel" Description="Maximum water PH in a range from 0-14." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPHMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1745" GlobalId="1586o0qUuHuO00025QrE$V" Name="Pset_MaterialWood" Description="This is a collection of properties applicable to wood-based materials that specify kind and grade of material as well as moisture related parameters." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial/Wood">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1746" GlobalId="19J8e0qUuHuO00025QrE$V" Name="Species" Description="Wood species of a solid wood or laminated wood product." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1747" GlobalId="1EgTI0qUuHuO00025QrE$V" Name="StrengthGrade" Description="Grade with respect to mechanical strength and stiffness." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1748" GlobalId="1K1ny0qUuHuO00025QrE$V" Name="AppearanceGrade" Description="Grade with respect to visual quality." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1749" GlobalId="1PP6c0qUuHuO00025QrE$V" Name="Layup" Description="Configuration of the lamination." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1750" GlobalId="1VMag0qUuHuO00025QrE$V" Name="Layers" Description="Number of layers." TemplateType="p_singlevalue" PrimaryMeasureType="IfcInteger" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1751" GlobalId="1ZXcW0qUuHuO00025QrE$V" Name="Plies" Description="Number of plies." TemplateType="p_singlevalue" PrimaryMeasureType="IfcInteger" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1752" GlobalId="1dieM0qUuHuO00025QrE$V" Name="MoistureContent" Description="Total weight of moisture relative to oven-dried weight of the wood." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1753" GlobalId="1htgC0qUuHuO00025QrE$V" Name="DimensionalChangeCoefficient" Description="Weighted dimensional change coefficient, relative to 1% change in moisture content." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1754" GlobalId="1merS0qUuHuO00025QrE$V" Name="ThicknessSwelling" Description="Swelling ratio relative to board depth." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i1755" GlobalId="1rQ0i0qUuHuO00025QrE$V" Name="Pset_MaterialWoodBasedBeam" Description="This is a collection of mechanical properties applicable to wood-based materials for beam-like products, especially laminated materials like glulam and LVL.
Anisotropy of such materials is taken into account by different properties according to grain direction and load types.

All values shall be given for a standardized service condition, a standardized load duration and a standardized reference size of the member according to local design codes.

NOTE: In cases where mechanical material properties are graduated for different given reference sizes, separate instances of IfcExtendedMaterialProperties and IfcMaterial have to be used for each required graduation. Mechanically differing versions of a material are treated as different materials.

References to the orientation of grain or lay-up correspond to material orientation given by geometrical or topological representation of element objects or types, especially IfcMemberType and IfcStructuralMember." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMaterial/Wood">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i1756" GlobalId="1uOlk0qUuHuO00025QrE$V" Name="ApplicableStructuralDesignMethod" Description="Determines whether mechanical material properties are applicable to &apos;ASD&apos; = allowable stress design (working stress design), &apos;LSD&apos; = limit state design, or &apos;LRFD&apos; = load and resistance factor design." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcComplexPropertyTemplate id="i1757" GlobalId="1zm4O0qUuHuO00025QrE$V" Name="InPlane" Description="Mechanical properties with respect to in-plane load, i.e. bending about the strong axis; tension zone of unbalanced layups is stressed in tension." UsageName="CP_MaterialMechanicalBeam" TemplateType="p_complex">
							<HasPropertyTemplates>
								<IfcSimplePropertyTemplate GlobalId="1HMLggJlb57v8ii$EHduxM" Name="YoungModulus" Description="Elastic modulus, mean value, α=0°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="2tQS09ZAPDug98trzpu7PS" Name="YoungModulusMin" Description="Elastic modulus, minimal value, α=0°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="1mmoX5pdz3LBznp4oPUJYs" Name="YoungModulusPerp" Description="Elastic modulus, mean value, α=90°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="0X8QZuXmT2JfERY_t1KRKN" Name="YoungModulusPerpMin" Description="Elastic modulus, minimal value, α=90°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="0LyBqEuor3xhVDmdpBBrhS" Name="ShearModulus" Description="Shear modulus, mean value." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="0BABvT9ifCweKQpbVbmW1v" Name="ShearModulusMin" Description="Shear modulus, minimal value." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="3Y5KkhnojDTerh9JKKXi0W" Name="BendingStrength" Description="Bending strength." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="2AKW2E71v4SwZRSf6Bjv2w" Name="TensileStrength" Description="Tensile strength, α=0°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="0j8x5DwHH4rgxxNUUYpaxH" Name="TensileStrengthPerp" Description="Tensile strength, α=90°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="0N455YE$f0Q9gp2KsnM8YB" Name="CompStrength" Description="Compressive strength, α=0°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="1nDJCoibTCpv6h14fhaGKZ" Name="CompStrengthPerp" Description="Compressive strength, α=90°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="1e6FFTtjLBgOZ8z29e$3k7" Name="RaisedCompStrengthPerp" Description="Alternative value for compressive strength, α=90°, which may be used under material and code dependent conditions (e.g. if deformation is tolerable, or far from ends of the member); conditions should be stated in SELF\IfcProperty.Description." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="0kjgupy_97avIlMZH_iBD4" Name="ShearStrength" Description="Shear strength." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="1EHJyVIez4GuVXUZSpQHn3" Name="TorsionalStrength" Description="Shear strength in torsion." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="2IRbhBomnFhx9eIoVOIJHC" Name="ReferenceDepth" Description="Depth in bending for which the mechanical properties are valid; provided as a means to check the integrity of material assignment." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="3RdbqocJXF8uEl6oXjVCGl" Name="InstabilityFactors" Description="Defining values: slenderness ratios; defined values: either factors or divisors of the strength, depending on the design method (if &lt;1: factors, if &gt;1: divisors)." TemplateType="p_tablevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="IfcPositiveRatioMeasure" />
							</HasPropertyTemplates>
						</IfcComplexPropertyTemplate>
						<IfcComplexPropertyTemplate id="i1758" GlobalId="3Ddmq0qUuHuO00025QrE$V" Name="InPlaneNegative" Description="Mechanical properties with respect to in-plane load, i.e. bending about the strong axis; compression zone of unbalanced layups is stressed in tension." UsageName="CP_MaterialMechanicalBeam" TemplateType="p_complex">
							<HasPropertyTemplates>
								<IfcSimplePropertyTemplate GlobalId="1hvsC0IWLEdB3xUkvrCHVI" Name="YoungModulus" Description="Elastic modulus, mean value, α=0°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="1GWNFoFaz07OonloBxZUIU" Name="YoungModulusMin" Description="Elastic modulus, minimal value, α=0°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="3yy5ZSDFD8jfjbdsMRuc1y" Name="YoungModulusPerp" Description="Elastic modulus, mean value, α=90°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="2carIhWoz99Po3SSzAJPct" Name="YoungModulusPerpMin" Description="Elastic modulus, minimal value, α=90°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="0FEmIVJej8$PCIj$EUMR5y" Name="ShearModulus" Description="Shear modulus, mean value." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="2cuG8RJdnEhhN8yxbhfbVX" Name="ShearModulusMin" Description="Shear modulus, minimal value." TemplateType="p_singlevalue" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="1mJcyU5FjEvPlHNmb60SjF" Name="BendingStrength" Description="Bending strength." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="2XtnNJoVnBmvn1bzc1UGu_" Name="TensileStrength" Description="Tensile strength, α=0°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="18d5bAXcjCAARdYXKP07Yn" Name="TensileStrengthPerp" Description="Tensile strength, α=90°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="3VTMcUo6XCeAAYmM_MZLrH" Name="CompStrength" Description="Compressive strength, α=0°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="3Q2AaIwNj5sfrocKwUvdtT" Name="CompStrengthPerp" Description="Compressive strength, α=90°." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="04LOOIhZr3DBc$B7zq9dxk" Name="RaisedCompStrengthPerp" Description="Alternative value for compressive strength, α=90°, which may be used under material and code dependent conditions (e.g. if deformation is tolerable, or far from ends of the member); conditions should be stated in SELF\IfcProperty.Description." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="2hFML4Q9j91f5aJi28rNwe" Name="ShearStrength" Description="Shear strength." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="0YBUxt_nfFj8QBbLScheNB" Name="TorsionalStrength" Description="Shear strength in torsion." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="21e1MA21r7PPjSW27cmYYl" Name="ReferenceDepth" Description="Depth in bending for which the mechanical properties are valid; provided as a means to check the integrity of material assignment." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
								<IfcSimplePropertyTemplate GlobalId="0xqstoxIX4bRDLvpeP1qs$" Name="InstabilityFactors" Description="Defining values: slenderness ratios; defined values: either factors or divisors of the strength, depending on the design method (if &lt;1: factors, if &gt;1: divisors)." TemplateType="p_tablevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="IfcPositiveRatioMeasure" />
							</HasPropertyTemplates>
						</IfcComplexPropertyTemplate>
						<IfcComplexPropertyTemplate id="i1759" GlobalId="0WUCI0qUyHuO00025QrE$V" Name="OutOfPlane" Description="Mechanical properties with respect to out-of-plane load, i.e. bending about the weak axis." UsageName="CP_MaterialMechanicalBeam" TemplateType="p_complex">
							<HasPropertyTemplates>
