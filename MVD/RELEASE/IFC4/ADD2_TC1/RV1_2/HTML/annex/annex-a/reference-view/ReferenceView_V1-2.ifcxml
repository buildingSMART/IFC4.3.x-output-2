						<IfcSimplePropertyTemplate id="i330" GlobalId="3eW7e0qWmHuO00025QrE$V" Name="NumberOfRiser" Description="Total number of the risers included in the stair." TemplateType="p_singlevalue" PrimaryMeasureType="IfcCountMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i331" GlobalId="3jHIu0qWmHuO00025QrE$V" Name="NumberOfTreads" Description="Total number of treads included in the stair." TemplateType="p_singlevalue" PrimaryMeasureType="IfcCountMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i332" GlobalId="3oedY0qWmHuO00025QrE$V" Name="RiserHeight" Description="Vertical distance from tread to tread. 
The riser height is supposed to be equal for all steps of a stair or stair flight." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i333" GlobalId="3w_hE0qWmHuO00025QrE$V" Name="TreadLength" Description="Horizontal distance from the front of the thread to the front of the next tread. 
The tread length is supposed to be equal for all steps of the stair or stair flight at the walking line." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i334" GlobalId="2fumLUaIP77AfA4OwuJ2TH" Name="NosingLength" Description="Horizontal distance from the front of the tread to the riser underneath. It is the overhang of the tread." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i335" GlobalId="2NNvZYNiXEJQrIeliihHby" Name="WalkingLineOffset" Description="Offset of the walking line from the inner side of the flight. 
Note: the walking line may have a own shape representation (in case of inconsistencies, the value derived from the shape representation shall take precedence)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i336" GlobalId="16YqziDXjCxOL5p4GBJOeT" Name="TreadLengthAtOffset" Description="Length of treads at a given offset.
Walking line position is given by the &apos;WalkingLineOffset&apos;. The resulting value should normally be identical with TreadLength, it may be given in addition, if the walking line offset for building code calculations is different from that used in design." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i337" GlobalId="2PbjRdz_nFkPSy0dxSVyGX" Name="TreadLengthAtInnerSide" Description="Minimum length of treads at the inner side of the winder. 
Only relevant in case of winding flights, for straight flights it is identical with IfcStairFlight.TreadLength. It is a pre-calculated value, in case of inconsistencies, the value derived from the shape representation shall take precedence." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i338" GlobalId="17ibcdsn96z8VizWIKOSnI" Name="WaistThickness" Description="Minimum thickness of the stair flight, measured perpendicular to the slope of the flight to the inner corner of riser and tread. It is a pre-calculated value, in case of inconsistencies, the value derived from the shape representation shall take precedence." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i339" GlobalId="04X1k0qWqHuO00025QrE$V" Name="RequiredHeadroom" Description="Required headroom clearance for the passageway according to the applicable building code or additional requirements." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i340" GlobalId="0Ct5Q0qWqHuO00025QrE$V" Name="HandicapAccessible" Description="Indication that this object is designed to be accessible by the handicapped. 
