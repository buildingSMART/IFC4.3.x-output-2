						<IfcSimplePropertyTemplate id="i1116" GlobalId="2Yqfie9CL0AAaLShyyDL6i" Name="CoilCoolant" Description="The fluid used for heating or cooling used by the hydronic coil." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
