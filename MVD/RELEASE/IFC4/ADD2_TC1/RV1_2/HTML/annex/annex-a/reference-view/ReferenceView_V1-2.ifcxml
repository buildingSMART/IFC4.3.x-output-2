				<IfcPropertySetTemplate id="i937" GlobalId="2Tip80qWqHuO00025QrE$V" Name="Pset_SwitchingDeviceTypeCommon" Description="A switching device is a device designed to make or break the current in one or more electric circuits." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcSwitchingDevice">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i938" GlobalId="2YT_O0qWqHuO00025QrE$V" Name="Reference" Description="Reference ID for this specified type in this project (e.g. type &apos;A-1&apos;), provided, if there is no classification reference to a recognized classification system used." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i939" GlobalId="2KCc_Rd5D99x5nZnZcj2$j" Name="Status" Description="Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
