						<IfcSimplePropertyTemplate id="i912" GlobalId="2uVAi0qViHuO00025QrE$V" Name="AdjustmentRangeStepValue" Description="Step value of current adjustment for an AdjustmentValueType = RANGE. Note that this property should not have a value for an  AdjustmentValueType = LIST." TemplateType="p_singlevalue" PrimaryMeasureType="IfcElectricCurrentMeasure" SecondaryMeasureType="" />
