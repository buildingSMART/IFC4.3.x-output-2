							</Enumerators>
						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate id="i1391" GlobalId="2qNI_vcq12xwqT1i2uLUj_" Name="HeatTransferMedium" Description="Enumeration defining the heat transfer medium if applicable." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_HeatTransferMedium">
