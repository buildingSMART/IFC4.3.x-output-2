									<IfcLabel-wrapper>OTHER</IfcLabel-wrapper>
									<IfcLabel-wrapper>NOTKNOWN</IfcLabel-wrapper>
									<IfcLabel-wrapper>UNSET</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate id="i799" GlobalId="3O2zU0qUiHuO00025QrE$V" Name="MaintenanceFactor" Description="The arithmetical allowance made for depreciation of lamps and reflective equipment from their initial values due to dirt, fumes, or age." TemplateType="p_singlevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i800" GlobalId="3U0RY0qUiHuO00025QrE$V" Name="MaximumPlenumSensibleLoad" Description="Maximum or Peak sensible thermal load contributed to return air plenum by the light fixture." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i801" GlobalId="3bACQ0qUiHuO00025QrE$V" Name="MaximumSpaceSensibleLoad" Description="Maximum or Peak sensible thermal load contributed to the conditioned space by the light fixture." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i802" GlobalId="3gXX40qUiHuO00025QrE$V" Name="SensibleLoadToRadiant" Description="Percent of sensible thermal load to radiant heat." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i803" GlobalId="27btY0qV4HuO00025QrE$V" Name="Pset_MotorConnectionTypeCommon" Description="Common properties for motor connections.  HISTORY: Added in IFC4." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMotorConnection">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i804" GlobalId="2CN2o0qV4HuO00025QrE$V" Name="Reference" Description="Reference ID for this specified type in this project (e.g. type &apos;A-1&apos;), provided, if there is no classification reference to a recognized classification system used." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i805" GlobalId="2KCc_Rd5D99x5nZnZcj2$j" Name="Status" Description="Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
