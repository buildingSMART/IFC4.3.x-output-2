						<IfcSimplePropertyTemplate id="i777" GlobalId="0zPQJ$1av4$fAetHdB4Rq5" Name="MountingType" Description="Method of mounting to be adopted for the type of junction box." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_JunctionBoxMountingType">
