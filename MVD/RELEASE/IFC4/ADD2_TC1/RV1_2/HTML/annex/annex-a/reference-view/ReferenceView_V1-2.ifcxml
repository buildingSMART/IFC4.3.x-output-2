	<RelatingLibrary>
		<IfcLibraryReference Location="" Name="정격전류" Description="정격 전류 [A]를 적어도 1 개의 값을 설정해야한다.   동일한 차단기부와 연결된 정격전류는세트 내의 임의의 값은 초과할 수 없다." Language="ko-KR" />
	</RelatingLibrary>
