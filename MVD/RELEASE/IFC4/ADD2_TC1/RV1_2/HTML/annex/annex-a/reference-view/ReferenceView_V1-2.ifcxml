						<IfcSimplePropertyTemplate id="i773" GlobalId="2TxWO0qUeHuO00025QrE$V" Name="NumberOfGangs" Description="Number of slots available for switches/outlets (most commonly 1, 2, 3, or 4)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcInteger" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i774" GlobalId="2ZIr20qUeHuO00025QrE$V" Name="ClearDepth" Description="Clear unobstructed depth available for cable inclusion within the junction box." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i775" GlobalId="2OGn2kTJr7heB0_dPyoY29" Name="ShapeType" Description="Shape of the junction box." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_JunctionBoxShapeType">
