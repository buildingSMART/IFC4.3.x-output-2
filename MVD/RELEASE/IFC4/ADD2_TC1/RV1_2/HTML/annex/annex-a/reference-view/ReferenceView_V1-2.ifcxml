						<IfcSimplePropertyTemplate id="i1120" GlobalId="0Gchc0qSeHuO00025QrE$V" Name="HeatExchangeSurfaceArea" Description="Heat exchange surface area associated with U-value." TemplateType="p_singlevalue" PrimaryMeasureType="IfcAreaMeasure" SecondaryMeasureType="" />
