				<IfcPropertySetTemplate id="i909" GlobalId="2aqKI0qViHuO00025QrE$V" Name="Pset_ProtectiveDeviceTrippingUnitCurrentAdjustment" Description="A set of current adjustment values that may be applied to an electronic or thermal tripping unit type." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcProtectiveDeviceTrippingUnit">
					<HasPropertyTemplates>
