						<IfcSimplePropertyTemplate GlobalId="1sRVDIkIP8QepwvE87UG0J" Name="BendingParameters" Description="If this mesh type is bent rather than planar, this attribute provides bending shape parameters. Their meaning is defined by the bending shape code and the respective standard." TemplateType="p_listvalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
