						<IfcSimplePropertyTemplate id="i1393" GlobalId="1FK6G0qWeHuO00025QrE$V" Name="BodyMass" Description="Overall body mass of the heater." TemplateType="p_singlevalue" PrimaryMeasureType="IfcMassMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1394" GlobalId="1Ng9y0qWeHuO00025QrE$V" Name="ThermalMassHeatCapacity" Description="Product of component mass and specific heat." TemplateType="p_singlevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1395" GlobalId="1Tde00qWeHuO00025QrE$V" Name="OutputCapacity" Description="Total nominal heat output as listed by the manufacturer." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1396" GlobalId="1Zb640qWeHuO00025QrE$V" Name="ThermalEfficiency" Description="Overall Thermal Efficiency is defined as gross energy output of the heat transfer device divided by the energy input." TemplateType="p_singlevalue" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1397" GlobalId="1j7Sa0qWeHuO00025QrE$V" Name="NumberOfPanels" Description="Number of panels." TemplateType="p_singlevalue" PrimaryMeasureType="IfcInteger" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1398" GlobalId="1oUnE0qWeHuO00025QrE$V" Name="NumberOfSections" Description="Number of vertical sections, measured in the direction of flow." TemplateType="p_singlevalue" PrimaryMeasureType="IfcInteger" SecondaryMeasureType="" />
