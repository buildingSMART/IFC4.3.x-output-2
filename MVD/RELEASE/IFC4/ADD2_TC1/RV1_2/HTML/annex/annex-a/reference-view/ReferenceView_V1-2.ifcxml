	<RelatedObjects>
		<IfcSimplePropertyTemplate xsi:nil="true" href="i785" />
	</RelatedObjects>
	<RelatingLibrary>
		<IfcLibraryReference Location="" Name="保守率" Description="回復不可能な光量減少が原因の光源自体の光束の低下、たとえば照明器具の老朽化や汚れによる光量の減少。" Language="ja-JP" />
	</RelatingLibrary>
</IfcRelAssociatesLibrary>
<IfcRelAssociatesLibrary GlobalId="0KOa6Rlgv148d8PCkzOyCR">
	<RelatedObjects>
		<IfcSimplePropertyTemplate xsi:nil="true" href="i785" />
	</RelatedObjects>
	<RelatingLibrary>
		<IfcLibraryReference Location="" Name="보수  비율" Description="복구할 수없는 광량 감소가 원인 광원 자체의 광속 저하, 예를 들어 조명기구의 노후화 및 오염에 의한 광량 감소." Language="ko-KR" />
	</RelatingLibrary>
</IfcRelAssociatesLibrary>
<IfcRelAssociatesLibrary GlobalId="1UAa49DYr8vgwLlF$u6arz">
