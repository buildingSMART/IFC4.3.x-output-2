<IfcRelAssociatesLibrary GlobalId="2k_p6lE2z27B4ZdBAnxb93">
	<RelatedObjects>
		<IfcSimplePropertyTemplate xsi:nil="true" href="i788" />
	</RelatedObjects>
	<RelatingLibrary>
		<IfcLibraryReference Location="" Name="色の見え方" Description="DIN（ドイツ規格協会）とCIE（国際照明委員会）の両方の規格で、人工照明は色の見え方で分類される。
人の目には全て白く見えてくる、その差異は直接比較することにより判別することが可能である。視機能は色の見え方の差異に直接影響はしない。" Language="ja-JP" />
	</RelatingLibrary>
</IfcRelAssociatesLibrary>
<IfcRelAssociatesLibrary GlobalId="1cb_Y74254LgNojQoYMZB4">
	<RelatedObjects>
