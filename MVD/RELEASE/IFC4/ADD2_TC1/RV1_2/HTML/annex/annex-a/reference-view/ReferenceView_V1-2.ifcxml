						<IfcSimplePropertyTemplate id="i341" GlobalId="0fU8w0qWqHuO00025QrE$V" Name="HasNonSkidSurface" Description="Indication whether the surface finish is designed to prevent slippery (TRUE) or not (FALSE)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i342" GlobalId="0JQiu0qWqHuO00025QrE$V" Name="IsExternal" Description="Indication whether the element is designed for use in the exterior (TRUE) or not (FALSE). If (TRUE) it is an external element and faces the outside of the building." TemplateType="p_singlevalue" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" />
