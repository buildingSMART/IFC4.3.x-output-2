						<IfcSimplePropertyTemplate id="i419" GlobalId="3x$bGOprDCQgg7xK4PC4OC" Name="Height" Description="Total outer heigth of the door lining. It should only be provided, if it is a rectangular door." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i420" GlobalId="2XDJ5oQ3X8wuL8puElvYFm" Name="Perimeter" Description="Total perimeter of the outer lining of the door." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i421" GlobalId="1cEbPpN7L4E8Pc7CR8aDZC" Name="Area" Description="Total area of the outer lining of the door." TemplateType="q_area" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i422" GlobalId="07wXL8A2r2yQeCTXi_Vopj" Name="Qto_MemberBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of members." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcMember">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i423" GlobalId="23VJ9cbmr7Z8nLCL2Ztv7T" Name="Length" Description="Total nominal length of the member, not taking into account any cut-out&apos;s or other processing features." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i424" GlobalId="1CJ9V2eIP2VOxFOXznhRyr" Name="CrossSectionArea" Description="Total area of the cross section (or profile) of the member." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i425" GlobalId="2L0loBn7rEgg3_kt6cKWME" Name="OuterSurfaceArea" Description="Total area of the extruded surfaces of the member (not taking into account the end cap areas), normally generated as perimeter * length." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i426" GlobalId="2p6SNTq5v2DwZaZ4YwQmqm" Name="GrossSurfaceArea" Description="Total area of the member, normally generated as perimeter * length + 2 * cross section area. It is the sum of OuterSurfaceArea + (2 x CrossSectionArea) and shall only be given, if the OuterSurfaceArea and CrossSectionArea cannot be established separately." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i427" GlobalId="2EIrVRpIv74w90Z74VC7Bq" Name="NetSurfaceArea" Description="Net surface area of the member, normally generated as perimeter * length + 2 * cross section area taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses. " TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i428" GlobalId="2lARuJES14dQ4cw2yiAyV3" Name="GrossVolume" Description="Total gross volume of the member, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i429" GlobalId="0zQ_lq_fzD3uXvq2fvIz0m" Name="NetVolume" Description="Total net volume of the member, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i430" GlobalId="1auc77qC52AhlGJuEOoQbg" Name="GrossWeight" Description="Total gross weight of the member without add-on parts, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
						<IfcSimplePropertyTemplate id="i431" GlobalId="0BZ0RgVvvB0Au49TCL2$Nc" Name="NetWeight" Description="Total net weight of the member without add-on parts, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
