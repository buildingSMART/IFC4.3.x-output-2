				<IfcPropertySetTemplate id="i432" GlobalId="3mesejfMT2DgXjJl$hxqFX" Name="Qto_PlateBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of plates." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcPlate">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i433" GlobalId="0kW6jQBc58jhiMYyLtUSuv" Name="Width" Description="Nominal width (or thickness) of the plate. Only given, if the plate is prismatic (constant thickess). " TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i434" GlobalId="1eSAm0Kv1BzBMLz0DB0cYZ" Name="Perimeter" Description="Perimeter measured along the outer boundaries of the plate. Only given, if the plate is prismatic (constant thickness)." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i435" GlobalId="2ZKkm9Tab4_QDxvaNB3E7K" Name="GrossArea" Description="Total area of the extruded area of the plate. Openings, recesses and projections are not taken into account. Only given, if the plate is prismatic." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i436" GlobalId="17ubdukNb0W9aXEckuuiud" Name="NetArea" Description="Total area of the extruded area of the plate. Openings and recesses are taken into account by subtraction, projections by addition. Only given, if the plate is prismatic." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i437" GlobalId="0eJM_AYGPDGBeQZ_tEdSxG" Name="GrossVolume" Description="Total gross volume of the plate. Openings, recesses, and projections are not taken into account. " TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i438" GlobalId="3NHg39Thz2q98XexF17J6L" Name="NetVolume" Description="Total net volume of the plate. Openings and recesses are taken into account by subtraction, projections by addition. " TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i439" GlobalId="07xyOpYN1ENPlFP$7E14qH" Name="GrossWeight" Description="Total gross weight of the plate without add-on parts, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
						<IfcSimplePropertyTemplate id="i440" GlobalId="3HPilonPX4eeqZc6gFTUVD" Name="NetWeight" Description="Total net weight of the plate without add-on parts, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i441" GlobalId="1Fh58OFtTD3fz8LEdf4$TK" Name="Qto_RailingBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of railings." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcRailing">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i442" GlobalId="25Uys$MQb2a8qWjqTa2SG7" Name="Length" Description="Total nominal length of the railing, not taking into account any cut-out&apos;s or other processing features." TemplateType="q_length" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i443" GlobalId="0rlWCYbyH02RREPFxBxj2G" Name="Qto_RampFlightBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of ramp flights." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcRampFlight">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i444" GlobalId="0mnhKv2352bP05kAyx9dZS" Name="Length" Description="Total length of the ramp flight along the walking line." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i445" GlobalId="2c$HEWc1b0ixiL$_rMctwP" Name="Width" Description="Thickness of the ramp flight. It should only be provided, if it is constant. " TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i446" GlobalId="2E$UHt0Ij2bhNKlWZRgc6b" Name="GrossArea" Description="Total area of the ramp flight (not the projected area). Openings, recesses and projections are not taken into account. Only given, if the ramp flight is prismatic." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i447" GlobalId="1Cm3Wf9gz6Pv9Yf5jcGsIz" Name="NetArea" Description="Total area of the ramp flight (not the projected area). Openings and recesses are taken into account by subtraction, projections by addition. Only given, if the ramp flight is prismatic." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i448" GlobalId="1jjfV2W558hg0ihu$no3sS" Name="GrossVolume" Description="Total gross volume of the ramp flight. Openings, recesses, and projections are not taken into account. " TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i449" GlobalId="3wYY9NR8r4IOia2k0qQWJm" Name="NetVolume" Description="Total net volume of the ramp flight. Openings and recesses are taken into account by subtraction, projections by addition. " TemplateType="q_volume" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i450" GlobalId="18$_auxt9FoeYNlFbaW7W1" Name="Qto_RoofBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of roof." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcRoof">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i451" GlobalId="3V2OMyAGXDUOZ$12fLJgCr" Name="GrossArea" Description="Total gross area of the outer surface of the roof. It is the sum of all roof slab gross areas. Roof openings, like sky windows and other openings and cut-outs are not taken into account." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i452" GlobalId="1ByOtKo4rDs8RprEsr6YLM" Name="NetArea" Description="Total net area of the outer surface of the roof. It is the suma of all roof slab net areas. Roof openings, like sky windows and other openings and cut-outs are taken into account." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i453" GlobalId="3fuF$itwL6PfQEQsct7uhL" Name="ProjectedArea" Description="Total gross area of the outer surfaces of the roof, projected tp the ground. It is the sum of all projected roof slab gross areas. Roof openings, like sky windows and other openings and cut-outs are not taken into account." TemplateType="q_area" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i454" GlobalId="3GbrjZQZ52SvxC6z0bkaIn" Name="Qto_SlabBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of slabs." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcSlab">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i455" GlobalId="030qr7WMT5MBD4pdKmjYUh" Name="Width" Description="Nominal width (or thickness) of the slab. Only given, if the slab is prismatic (constant thickess). " TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i456" GlobalId="3khYIfZeD0OuKusADQQdov" Name="Length" Description="Length (one direction of the non-projected foot print area) of the slab. It shall only be provided, if the slab is rectangular." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i457" GlobalId="1EfY1EUxjCYfMfDim4N8cC" Name="Depth" Description="Depth (one direction of the non-projected foot print area) of the slab. It shall only be provided, if the slab is rectangular.
&lt;blockquote class=&quot;note&quot;&gt;NOTE&amp;nbsp; Also refered to as width, but not to be confused with the &quot;Width&quot; quantity, that denotes the thickness in the context of the slab.&lt;/blockquote&gt;" TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i458" GlobalId="1sFKpDR$14zwRXxmfeKbrO" Name="Perimeter" Description="Perimeter measured along the outer boundaries of the slab. Only given, if the slab is prismatic (constant thickness)." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i459" GlobalId="2xt4x2$lzD8wZCrac3MEZ0" Name="GrossArea" Description="Total area of the extruded area of the slab. Openings, recesses and projections are not taken into account. Only given, if the slab is prismatic." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i460" GlobalId="29izq2o8PDM9ZgFTCAF4ra" Name="NetArea" Description="Total area of the extruded area of the slab. Openings and recesses are taken into account by subtraction, projections by addition. Only given, if the slab is prismatic." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i461" GlobalId="14RqdfQXT4qQ82_ZE93nfB" Name="GrossVolume" Description="Total gross volume of the slab. Openings, recesses, and projections are not taken into account. " TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i462" GlobalId="0VFGaSH455JRzx81I_y2ka" Name="NetVolume" Description="Total net volume of the slab. Openings and recesses are taken into account by subtraction, projections by addition. " TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i463" GlobalId="28SdjVtSj3qQ3gvIiqeUIa" Name="GrossWeight" Description="Total gross weight of the slab without add-on parts, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
						<IfcSimplePropertyTemplate id="i464" GlobalId="3pzRYkes59nwqFKndMTa2o" Name="NetWeight" Description="Total net weight of the slab without add-on parts, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i465" GlobalId="2BwuvS1U1EaPJectlvV02T" Name="Qto_StairFlightBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of stair flights." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcStairFlight">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i466" GlobalId="2kNfSScs5BTAVyaOQHdEQQ" Name="Length" Description="Total length of the stair flight along the walking line." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i467" GlobalId="14nohS8fbDaRUpazUdVSy5" Name="GrossVolume" Description="Total gross volume of the stair flight. Openings, recesses, and projections are not taken into account. " TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i468" GlobalId="22Y7WG9CXC9uU51QkMI8w7" Name="NetVolume" Description="Total net volume of the stair flight. Openings and recesses are taken into account by subtraction, projections by addition. " TemplateType="q_volume" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i469" GlobalId="2RAPiCqAX4jgXLCSyvEp5c" Name="Qto_WallBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of walls." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcWall">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i470" GlobalId="0tSm_oibzF$hmgsUBZDeIH" Name="Length" Description="Total nominal length of the wall along the wall center line (even if different to the wall path)." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i471" GlobalId="2ekc6Lw$vDfB57nG1Sm4wB" Name="Width" Description="Total nominal width (or thickness) of the wall measured perpendicular to the wall path. It should only be provided, if it is constant along the wall path." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i472" GlobalId="3WbJ7i_U9ArhOXaHfEfvFa" Name="Height" Description="Total nominal height of the wall. It should only be provided, if it is constant along the wall path. " TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i473" GlobalId="0P10Tj2OL2Wv_h8X9BES4K" Name="GrossFootprintArea" Description="Area of the wall as viewed by a ground floor view, not taking any wall modifications (like recesses) into account. It is also referred to as the foot print of the wall." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i474" GlobalId="08AeXBr_1BtfH8IkgbSECv" Name="NetFootprintArea" Description="Area of the wall as viewed by a ground floor view, taking all wall modifications (like recesses) into account. It is also referred to as the foot print of the wall. " TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i475" GlobalId="3T7_AKruz0TBm3ToQt0Naj" Name="GrossSideArea" Description="Area of the wall as viewed by an elevation view of the middle plane of the wall.  It does not take into account any wall modifications (such as openings). " TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i476" GlobalId="3dROH$uFj4vPNKtWkhmkoW" Name="NetSideArea" Description="Area of the wall as viewed by an elevation view of the middle plane. It does take into account all wall modifications (such as openings). " TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i477" GlobalId="33_HQffm1D28GEII3cbBRn" Name="GrossVolume" Description="Volume of the wall, without taking into account the openings and the connection geometry." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i478" GlobalId="0WOBpKa3L63h9k7gjdhvMQ" Name="NetVolume" Description="Volume of the wall, after subtracting the openings and after considering the connection geometry. " TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i479" GlobalId="0WGCvpd9TC1hpTeTokrgzm" Name="GrossWeight" Description="Total gross weight of the wall, without add-on parts, not taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
						<IfcSimplePropertyTemplate id="i480" GlobalId="32ZfEUaFj1$8OmykwIZY3k" Name="NetWeight" Description="Total net weight of the wall, without add-on parts, taking into account possible processing features (cut-out&apos;s, etc.) or openings and recesses." TemplateType="q_weight" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i481" GlobalId="1Kq1ZLuvbABfkiE3GFe6hP" Name="Qto_WindowBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of windows." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcWindow">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i482" GlobalId="18UcPG7iP4zfJktZU_maoy" Name="Width" Description="Total outer width of the window lining. It should only be provided, if it is a rectangular window." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i483" GlobalId="1hGPoGg2L09v1afkqhXBHH" Name="Height" Description="Total outer heigth of the window lining. It should only be provided, if it is a rectangular window." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i484" GlobalId="0vtU$HxUn5fR2RNi$2nSSt" Name="Perimeter" Description="Total perimeter of the outer lining of the window." TemplateType="q_length" />
						<IfcSimplePropertyTemplate id="i485" GlobalId="0ghx$p4BP9bPO6p1adKSEF" Name="Area" Description="Total area of the outer lining of the window." TemplateType="q_area" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i486" GlobalId="11oxU0qTCHuO00025QrE$V" Name="Pset_DistributionChamberElementCommon" Description="Common properties of all occurrences of IfcDistributionChamberElement." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcDistributionChamberElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i487" GlobalId="1KteU0qTCHuO00025QrE$V" Name="Reference" Description="Reference ID for this specific instance (e.g.  &apos;WWS/VS1/400/001&apos;, which indicates the occurrence belongs to system WWS, subsystems VSI/400, and has the component number 001)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i488" GlobalId="2KCc_Rd5D99x5nZnZcj2$j" Name="Status" Description="Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_ElementStatus">
								<EnumerationValues>
									<IfcLabel-wrapper>NEW</IfcLabel-wrapper>
									<IfcLabel-wrapper>EXISTING</IfcLabel-wrapper>
									<IfcLabel-wrapper>DEMOLISH</IfcLabel-wrapper>
									<IfcLabel-wrapper>TEMPORARY</IfcLabel-wrapper>
									<IfcLabel-wrapper>OTHER</IfcLabel-wrapper>
									<IfcLabel-wrapper>NOTKNOWN</IfcLabel-wrapper>
									<IfcLabel-wrapper>UNSET</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i489" GlobalId="2x5ze0qTGHuO00025QrE$V" Name="Pset_DistributionPortCommon" Description="Common attributes attached to an instance of IfcDistributionPort." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcDistributionPort">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i490" GlobalId="30TII0qTGHuO00025QrE$V" Name="PortNumber" Description="The port index for logically ordering the port within the containing element or element type." TemplateType="p_singlevalue" PrimaryMeasureType="IfcInteger" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i491" GlobalId="37d3A0qTGHuO00025QrE$V" Name="ColorCode" Description="Name of a color for identifying the connector, if applicable." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i492" GlobalId="1kpvY0qTeHuO00025QrE$V" Name="Pset_DistributionSystemCommon" Description="Distribution system occurrence attributes attached to an instance of IfcDistributionSystem." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcDistributionSystem">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i493" GlobalId="1qBEC0qTeHuO00025QrE$V" Name="Reference" Description="Reference ID for this specific instance of a distribution system, or sub-system (e.g. &apos;WWS/VS1&apos;, which indicates the system to be WWS, subsystems VSI/400). The reference values depend on the local code of practice." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i494" GlobalId="3jX000qV4HuO00025QrE$V" Name="Pset_OutsideDesignCriteria" Description="Outside air conditions used as the basis for calculating thermal loads at peak conditions, as well as the weather data location from which these conditions were obtained. HISTORY: New property set in IFC Release 1.0." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcBuilding">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i495" GlobalId="3ouKg0qV4HuO00025QrE$V" Name="HeatingDryBulb" Description="Outside dry bulb temperature for heating design." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i496" GlobalId="3urok0qV4HuO00025QrE$V" Name="HeatingWetBulb" Description="Outside wet bulb temperature for heating design." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i497" GlobalId="3_pGo0qV4HuO00025QrE$V" Name="HeatingDesignDay" Description="The month, day and time that has been selected for the heating design calculations." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDateTime" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i498" GlobalId="03aS20qV8HuO00025QrE$V" Name="CoolingDryBulb" Description="Outside dry bulb temperature for cooling design." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i499" GlobalId="08xmi0qV8HuO00025QrE$V" Name="CoolingWetBulb" Description="Outside wet bulb temperature for cooling design." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i500" GlobalId="0EJ5M0qV8HuO00025QrE$V" Name="CoolingDesignDay" Description="The month, day  and time that has been selected for the cooling design calculations." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDateTime" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i501" GlobalId="0J4Gc0qV8HuO00025QrE$V" Name="WeatherDataStation" Description="The site weather data station description or reference to the data source from which weather data was obtained for use in calculations." TemplateType="p_singlevalue" PrimaryMeasureType="IfcText" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i502" GlobalId="0ORbG0qV8HuO00025QrE$V" Name="WeatherDataDate" Description="The date for which the weather data was gathered." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDateTime" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i503" GlobalId="2uCLRUzMf22P6u_UD4pO42" Name="BuildingThermalExposure" Description="The thermal exposure expected by the building based on surrounding site conditions." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_BuildingThermalExposure">
								<EnumerationValues>
									<IfcLabel-wrapper>LIGHT</IfcLabel-wrapper>
									<IfcLabel-wrapper>MEDIUM</IfcLabel-wrapper>
									<IfcLabel-wrapper>HEAVY</IfcLabel-wrapper>
									<IfcLabel-wrapper>NOTKNOWN</IfcLabel-wrapper>
									<IfcLabel-wrapper>UNSET</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate id="i504" GlobalId="0dxPq0qV8HuO00025QrE$V" Name="PrevailingWindDirection" Description="The prevailing wind angle direction measured from True North (0 degrees) in a clockwise direction." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPlaneAngleMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i505" GlobalId="0jIkU0qV8HuO00025QrE$V" Name="PrevailingWindVelocity" Description="The design wind velocity coming from the direction specified by the PrevailingWindDirection attribute." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLinearVelocityMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i506" GlobalId="0K0cK0qWiHuO00025QrE$V" Name="Pset_SpaceThermalDesign" Description="Space or zone HVAC design requirements. HISTORY: New property set in IFC Release 1.0 (Pset_SpaceHvacInformation); renamed to Pset_SpaceThermalDesign and revised in IFC2x2." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcSpace">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i507" GlobalId="0P_4O0qWiHuO00025QrE$V" Name="CoolingDesignAirflow" Description="The air flowrate required during the peak cooling conditions." TemplateType="p_singlevalue" PrimaryMeasureType="IfcVolumetricFlowRateMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i508" GlobalId="0VxYS0qWiHuO00025QrE$V" Name="HeatingDesignAirflow" Description="The air flowrate required during the peak heating conditions, but could also be determined by minimum ventilation requirement or minimum air change requirements." TemplateType="p_singlevalue" PrimaryMeasureType="IfcVolumetricFlowRateMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i509" GlobalId="0bv0W0qWiHuO00025QrE$V" Name="TotalSensibleHeatGain" Description="The total sensible heat or energy gained by the space during the peak cooling conditions." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i510" GlobalId="0iSd_0qWiHuO00025QrE$V" Name="TotalHeatGain" Description="The total amount of heat or energy gained by the space at the time of the space&apos;s peak cooling conditions." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i511" GlobalId="0nDpE0qWiHuO00025QrE$V" Name="TotalHeatLoss" Description="The total amount of heat or energy lost by the space at the time of the space&apos;s peak heating conditions." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i512" GlobalId="0uNa60qWiHuO00025QrE$V" Name="CoolingDryBulb" Description="Inside dry bulb temperature for cooling design." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i513" GlobalId="0zkum0qWiHuO00025QrE$V" Name="CoolingRelativeHumidity" Description="Inside relative humidity for cooling design." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i514" GlobalId="13iMq0qWiHuO00025QrE$V" Name="HeatingDryBulb" Description="Inside dry bulb temperature for heating design." TemplateType="p_singlevalue" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i515" GlobalId="193hU0qWiHuO00025QrE$V" Name="HeatingRelativeHumidity" Description="Inside relative humidity for heating design." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i516" GlobalId="1FdIy0qWiHuO00025QrE$V" Name="VentilationAirFlowrate" Description="Ventilation outside air requirement for the space." TemplateType="p_singlevalue" PrimaryMeasureType="IfcVolumetricFlowRateMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i517" GlobalId="1K_dc0qWiHuO00025QrE$V" Name="ExhaustAirFlowrate" Description="Design exhaust air flow rate for the space." TemplateType="p_singlevalue" PrimaryMeasureType="IfcVolumetricFlowRateMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i518" GlobalId="1QLyG0qWiHuO00025QrE$V" Name="CeilingRAPlenum" Description="Ceiling plenum used for return air or not. TRUE = Yes, FALSE = No." TemplateType="p_singlevalue" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i519" GlobalId="1XVj80qWiHuO00025QrE$V" Name="BoundaryAreaHeatLoss" Description="Heat loss per unit area for the boundary object. This is a design input value for use in the absence of calculated load data." TemplateType="p_singlevalue" PrimaryMeasureType="IfcHeatFluxDensityMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i520" GlobalId="1efU00qWiHuO00025QrE$V" Name="Pset_SpaceThermalLoad" Description="The space thermal load defines all thermal losses and gains occurring within a space or zone.  The thermal load source attribute defines an enumeration of possible sources of the thermal load. The maximum, minimum, time series and app" TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcSpace">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i521" GlobalId="1k0og0qWiHuO00025QrE$V" Name="People" Description="Heat gains and losses from people." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i522" GlobalId="1qaQ80qWiHuO00025QrE$V" Name="Lighting" Description="Lighting loads." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i523" GlobalId="20VMG0qWiHuO00025QrE$V" Name="EquipmentSensible" Description="Heat gains and losses from equipment." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i524" GlobalId="272zk0qWiHuO00025QrE$V" Name="VentilationIndoorAir" Description="Ventilation loads from indoor air." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i525" GlobalId="2FP1Q0qWiHuO00025QrE$V" Name="VentilationOutdoorAir" Description="Ventilation loads from outdoor air." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i526" GlobalId="2N8xi0qWiHuO00025QrE$V" Name="RecirculatedAir" Description="Loads from recirculated air." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i527" GlobalId="2TiZA0qWiHuO00025QrE$V" Name="ExhaustAir" Description="Loads from exhaust air." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i528" GlobalId="2asK20qWiHuO00025QrE$V" Name="AirExchangeRate" Description="Loads from the air exchange rate." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i529" GlobalId="2$gxK0qWiHuO00025QrE$V" Name="DryBulbTemperature" Description="Loads from the dry bulb temperature." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i530" GlobalId="36qiC0qWiHuO00025QrE$V" Name="RelativeHumidity" Description="Loads from the relative humidity." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i531" GlobalId="3EacU0qWiHuO00025QrE$V" Name="InfiltrationSensible" Description="Heat gains and losses from infiltration." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i532" GlobalId="3MKWm0qWiHuO00025QrE$V" Name="TotalSensibleLoad" Description="Total energy added or removed from air that affects its temperature.  If a value is less than zero (negative), then the thermal load is lost from the space. If a value is greater than zero (positive), then the thermal load is a gain to the space." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i533" GlobalId="3U4R20qWiHuO00025QrE$V" Name="TotalLatentLoad" Description="Total energy added or removed from air that affects its humidity or concentration of water vapor.  If a value is less than zero (negative), then the thermal load is lost from the space. If a value is greater than zero (positive), then the thermal load is a gain to the space." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i534" GlobalId="3ep4M0qWiHuO00025QrE$V" Name="TotalRadiantLoad" Description="Total electromagnetic energy added or removed by emission or absorption.  If a value is less than zero (negative), then the thermal load is lost from the space. If a value is greater than zero (positive), then the thermal load is a gain to the space." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i535" GlobalId="3MeDO0qX0HuO00025QrE$V" Name="Pset_ThermalLoadAggregate" Description="The aggregated thermal loads experienced by one or many spaces, zones, or buildings. This aggregate thermal load information is typically addressed by a system or plant. HISTORY: New property set in IFC Release 1.0 (Pset_AggregateLoadInformation); renamed Pset_ThermalLoadAggregate in IFC2x2." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcSpatialElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i536" GlobalId="3VaQU0qX0HuO00025QrE$V" Name="TotalCoolingLoad" Description="The peak total cooling load for the building, zone or space." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i537" GlobalId="3axl80qX0HuO00025QrE$V" Name="TotalHeatingLoad" Description="The peak total heating load for the building, zone or space." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i538" GlobalId="3gvDC0qX0HuO00025QrE$V" Name="LightingDiversity" Description="Lighting diversity." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i539" GlobalId="3pFGu0qX0HuO00025QrE$V" Name="InfiltrationDiversitySummer" Description="Diversity factor for Summer infiltration." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i540" GlobalId="3vouM0qX0HuO00025QrE$V" Name="InfiltrationDiversityWinter" Description="Diversity factor for Winter infiltration." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i541" GlobalId="00MVq0qX4HuO00025QrE$V" Name="ApplianceDiversity" Description="Diversity of appliance load." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i542" GlobalId="06Jzu0qX4HuO00025QrE$V" Name="LoadSafetyFactor" Description="Load safety factor." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i543" GlobalId="0E3uA0qX4HuO00025QrE$V" Name="Pset_ThermalLoadDesignCriteria" Description="Building thermal load design data that are used for calculating thermal loads in a space or building. HISTORY: New property set in IFC Release 1.0 (Pset_LoadDesignCriteria); renamed Pset_ThermalLoadDesignCriteria in IFC2x2." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcSpatialElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i544" GlobalId="0OoXU0qX4HuO00025QrE$V" Name="OccupancyDiversity" Description="Diversity factor that may be applied to the number of people in the space." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i545" GlobalId="0Ul$Y0qX4HuO00025QrE$V" Name="OutsideAirPerPerson" Description="Design quantity of outside air to be provided per person in the space." TemplateType="p_singlevalue" PrimaryMeasureType="IfcVolumetricFlowRateMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i546" GlobalId="0ajTc0qX4HuO00025QrE$V" Name="ReceptacleLoadIntensity" Description="Average power use intensity of appliances and other non-HVAC equipment in the space per unit area.(PowerMeasure/IfcAreaMeasure)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i547" GlobalId="0ggxg0qX4HuO00025QrE$V" Name="AppliancePercentLoadToRadiant" Description="Percent of sensible load to radiant heat." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i548" GlobalId="0nEZ80qX4HuO00025QrE$V" Name="LightingLoadIntensity" Description="Average lighting load intensity in the space per unit area (PowerMeasure/IfcAreaMeasure)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i549" GlobalId="0toAc0qX4HuO00025QrE$V" Name="LightingPercentLoadToReturnAir" Description="Percent of lighting load to the return air plenum." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i550" GlobalId="1PbuJBYcPDDBcEG8o4osEB" Name="Qto_DistributionChamberElementBaseQuantities" Description="Base quantities that are common to the definition of all occurrences of distribution chamber elements." TemplateType="qto_occurrencedriven" ApplicableEntity="IfcDistributionChamberElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i551" GlobalId="120Q7UCrL28efVUqFX0kQ2" Name="GrossSurfaceArea" Description="Total gross area of the inner surface of the chamber, not taking into account openings such as for pipes, ducts, or cables." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i552" GlobalId="2KH2BOElTBH9NU2YAau8oC" Name="NetSurfaceArea" Description="Total net area of the inner surface of the chamber, subtracting any openings such as for pipes, ducts, or cables." TemplateType="q_area" />
						<IfcSimplePropertyTemplate id="i553" GlobalId="23Oh8d2BTDXxVHWoDjmHE8" Name="GrossVolume" Description="Total gross volume of the chamber, not taking into account any enclosed elements such as pipes, ducts, cables, or equipment." TemplateType="q_volume" />
						<IfcSimplePropertyTemplate id="i554" GlobalId="3YVB3yAvjBVh1KXE9$UEBr" Name="NetVolume" Description="Total net volume of the chamber, subtracting any enclosed elements such as pipes, ducts, cables, or equipment." TemplateType="q_volume" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i555" GlobalId="2yxvQ0qV0HuO00025QrE$V" Name="Pset_MechanicalFastenerAnchorBolt" Description="Properties common to different types of anchor bolts." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMechanicalFastener/ANCHORBOLT">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i556" GlobalId="33VWu0qV0HuO00025QrE$V" Name="AnchorBoltLength" Description="The length of the anchor bolt." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i557" GlobalId="3A38M0qV0HuO00025QrE$V" Name="AnchorBoltDiameter" Description="The nominal diameter of the anchor bolt bar(s)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i558" GlobalId="3Hp2e0qV0HuO00025QrE$V" Name="AnchorBoltThreadLength" Description="The length of the threaded part of the anchor bolt." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i559" GlobalId="3OypW0qV0HuO00025QrE$V" Name="AnchorBoltProtrusionLength" Description="The length of the protruding part of the anchor bolt." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i560" GlobalId="3YVA00qV0HuO00025QrE$V" Name="Pset_MechanicalFastenerBolt" Description="Properties related to bolt-type fasteners. The properties of a whole set with bolt, washers and nut may be provided. Note, it is usually not necessary to transmit these properties in case of standardized bolts. Instead, the standard is referred to." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcMechanicalFastener/BOLT">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i561" GlobalId="3dsUg0qV0HuO00025QrE$V" Name="ThreadDiameter" Description="Nominal diameter of the thread, if different from the bolt&apos;s overall nominal diameter" TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i562" GlobalId="3kQ680qV0HuO00025QrE$V" Name="ThreadLength" Description="Nominal length of the thread" TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i563" GlobalId="3qNaC0qV0HuO00025QrE$V" Name="NutsCount" Description="Count of nuts to be mounted on one bolt" TemplateType="p_singlevalue" PrimaryMeasureType="IfcCountMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i564" GlobalId="3wL2G0qV0HuO00025QrE$V" Name="WashersCount" Description="Count of washers to be mounted on one bolt" TemplateType="p_singlevalue" PrimaryMeasureType="IfcCountMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i565" GlobalId="3$6DW0qV0HuO00025QrE$V" Name="HeadShape" Description="Shape of the bolt&apos;s head, e.g. &apos;Hexagon&apos;, &apos;Countersunk&apos;, &apos;Cheese&apos;" TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i566" GlobalId="05fq_0qV4HuO00025QrE$V" Name="KeyShape" Description="If applicable, shape of the head&apos;s slot, e.g. &apos;Slot&apos;, &apos;Allen&apos;" TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i567" GlobalId="0BdJ20qV4HuO00025QrE$V" Name="NutShape" Description="Shape of the nut, e.g. &apos;Hexagon&apos;, &apos;Cap&apos;, &apos;Castle&apos;, &apos;Wing&apos;" TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i568" GlobalId="0TVjE0qV4HuO00025QrE$V" Name="WasherShape" Description="Shape of the washers, e.g. &apos;Standard&apos;, &apos;Square&apos;" TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate GlobalId="0Q51nV9iT0SR4hB7xR9muT" Name="Pset_MechanicalFastenerCommon" Description="Properties related to mechanical fasteners." ApplicableEntity="IfcMechanicalFastener">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate GlobalId="18BXd89sj1xRbNqTu43bvX" Name="NominalDiameter" Description="The nominal diameter describing the cross-section size of the fastener type." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate GlobalId="1zu$08e7f1bBfiI$1wPJDE" Name="NominalLength" Description="The nominal length describing the longitudinal dimensions of the fastener type." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i569" GlobalId="3H8Po0qSmHuO00025QrE$V" Name="Pset_Condition" Description="Determines the state or condition of an element at a particular point in time." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i570" GlobalId="3N5ts0qSmHuO00025QrE$V" Name="AssessmentDate" Description="Date on which the overall condition is assessed" TemplateType="p_singlevalue" PrimaryMeasureType="IfcDate" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i571" GlobalId="3Rt360qSmHuO00025QrE$V" Name="AssessmentCondition" Description="The overall condition of a product based on an assessment of the contributions to the overall condition made by the various criteria considered. The meanings given to the values of assessed condition should be agreed and documented by local agreements. For instance, is overall condition measured on a scale of 1 - 10 or by assigning names such as Good, OK, Poor." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i572" GlobalId="3XENm0qSmHuO00025QrE$V" Name="AssessmentDescription" Description="Qualitative description of the condition." TemplateType="p_singlevalue" PrimaryMeasureType="IfcText" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i573" GlobalId="3hQNE0qUWHuO00025QrE$V" Name="Pset_FurnitureTypeCommon" Description="Common properties for all types of furniture such as chair, desk, table, and file cabinet. HISTORY: First issued in IFC Release R1.5. Renamed from Pset_FurnitureCommon. IFC 2x4: &apos;IsBuiltIn&apos; property added" TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcFurniture">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate GlobalId="36T0J90GnF1AFJynwsfDWJ" Name="Reference" Description="" TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i574" GlobalId="2KCc_Rd5D99x5nZnZcj2$j" Name="Status" Description="" TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_ElementStatus">
								<EnumerationValues>
									<IfcLabel-wrapper>NEW</IfcLabel-wrapper>
									<IfcLabel-wrapper>EXISTING</IfcLabel-wrapper>
									<IfcLabel-wrapper>DEMOLISH</IfcLabel-wrapper>
									<IfcLabel-wrapper>TEMPORARY</IfcLabel-wrapper>
									<IfcLabel-wrapper>OTHER</IfcLabel-wrapper>
									<IfcLabel-wrapper>NOTKNOWN</IfcLabel-wrapper>
									<IfcLabel-wrapper>UNSET</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate id="i575" GlobalId="3tLJM0qUWHuO00025QrE$V" Name="Style" Description="Description of the furniture style." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i576" GlobalId="00HWS0qUaHuO00025QrE$V" Name="NominalHeight" Description="The nominal height of the furniture of this type. The size information is provided in addition to the shape representation and the geometric parameters used within. In cases of inconsistency between the geometric parameters and the size properties, provided in the attached property set, the geometric parameters take precedence." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i577" GlobalId="07RHK0qUaHuO00025QrE$V" Name="NominalLength" Description="The nominal length of the furniture of this type. The size information is provided in addition to the shape representation and the geometric parameters used within. In cases of inconsistency between the geometric parameters and the size properties, provided in the attached property set, the geometric parameters take precedence." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i578" GlobalId="0HZnE0qUaHuO00025QrE$V" Name="NominalDepth" Description="The nominal depth of the furniture of this type. The size information is provided in addition to the shape representation and the geometric parameters used within. In cases of inconsistency between the geometric parameters and the size properties, provided in the attached property set, the geometric parameters take precedence." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i579" GlobalId="0Pvqw0qUaHuO00025QrE$V" Name="MainColor" Description="The main color of the furniture of this type." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i580" GlobalId="0VtI_0qUaHuO00025QrE$V" Name="IsBuiltIn" Description="Indicates whether the furniture type is intended to be &apos;built in&apos; i.e. physically attached to a building or facility (= TRUE) or not i.e. Loose and movable (= FALSE)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i581" GlobalId="16wJ20qUmHuO00025QrE$V" Name="Pset_ManufacturerOccurrence" Description="Defines properties of individual instances of manufactured products that may be given by the manufacturer.
HISTORY: IFC 2x4: AssemblyPlace property added. This property does not need to be asserted if Pset_ManufacturerTypeInformation is allocated to the type and the AssemblyPlace property is asserted there." TemplateType="pset_occurrencedriven" ApplicableEntity="IfcElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i582" GlobalId="1BhUI0qUmHuO00025QrE$V" Name="AcquisitionDate" Description="The date that the manufactured item was purchased." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDate" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i583" GlobalId="1H2oy0qUmHuO00025QrE$V" Name="BarCode" Description="The identity of the bar code given to an occurrence of the product." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i584" GlobalId="1MQ7c0qUmHuO00025QrE$V" Name="SerialNumber" Description="The serial number assigned to an occurrence of a product." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i585" GlobalId="1SNbg0qUmHuO00025QrE$V" Name="BatchReference" Description="The identity of the batch reference from which an occurrence of a product is taken." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i586" GlobalId="0MGvUdjkLE4RaxB6gwe_EP" Name="AssemblyPlace" Description="Enumeration defining where the assembly is intended to take place, either in a factory, other offsite location or on the building site." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_AssemblyPlace">
								<EnumerationValues>
									<IfcLabel-wrapper>FACTORY</IfcLabel-wrapper>
									<IfcLabel-wrapper>OFFSITE</IfcLabel-wrapper>
									<IfcLabel-wrapper>SITE</IfcLabel-wrapper>
									<IfcLabel-wrapper>OTHER</IfcLabel-wrapper>
									<IfcLabel-wrapper>NOTKNOWN</IfcLabel-wrapper>
									<IfcLabel-wrapper>UNSET</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i587" GlobalId="1nquI0qUmHuO00025QrE$V" Name="Pset_ManufacturerTypeInformation" Description="Defines characteristics of types (ranges) of manufactured products that may be given by the manufacturer. Note that the term &apos;manufactured&apos; may also be used to refer to products that are supplied and identified by the supplier or that are assembled off site by a third party provider. 
HISTORY: This property set replaces the entity IfcManufacturerInformation from previous IFC releases. IFC 2x4: AssemblyPlace property added." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i588" GlobalId="1u_fA0qUmHuO00025QrE$V" Name="GlobalTradeItemNumber" Description="The Global Trade Item Number (GTIN) is an identifier for trade items developed by GS1 (www.gs1.org)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i589" GlobalId="1_Lzq0qUmHuO00025QrE$V" Name="ArticleNumber" Description="Article number or reference that is be applied to a configured product according to a standard scheme for article number definition as defined by the manufacturer. It is often used as the purchasing number." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i590" GlobalId="24vbI0qUmHuO00025QrE$V" Name="ModelReference" Description="The model number or designator of the product model (or product line) as assigned by the manufacturer of the manufactured item." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i591" GlobalId="2C3MA0qUmHuO00025QrE$V" Name="ModelLabel" Description="The descriptive model name of the product model (or product line) as assigned by the manufacturer of the manufactured item." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i592" GlobalId="2Icze0qUmHuO00025QrE$V" Name="Manufacturer" Description="The organization that manufactured and/or assembled the item." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i593" GlobalId="2OaRi0qUmHuO00025QrE$V" Name="ProductionYear" Description="The year of production of the manufactured item." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i594" GlobalId="0MGvUdjkLE4RaxB6gwe_EP" Name="AssemblyPlace" Description="Enumeration defining where the assembly is intended to take place, either in a factory or on the building site." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_AssemblyPlace">
								<EnumerationValues>
									<IfcLabel-wrapper>FACTORY</IfcLabel-wrapper>
									<IfcLabel-wrapper>OFFSITE</IfcLabel-wrapper>
									<IfcLabel-wrapper>SITE</IfcLabel-wrapper>
									<IfcLabel-wrapper>OTHER</IfcLabel-wrapper>
									<IfcLabel-wrapper>NOTKNOWN</IfcLabel-wrapper>
									<IfcLabel-wrapper>UNSET</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i595" GlobalId="0XOYG0qVWHuO00025QrE$V" Name="Pset_PropertyAgreement" Description="A property agreement is an agreement that enables the occupation of a property for a period of time.

The objective is to capture the information within an  agreement that is relevant to a facilities manager. Design and construction information associated with the property is not considered. A property agreement may be applied to an instance of IfcSpatialStructureElement including to compositions defined through the IfcSpatialStructureElement.Element.CompositionEnum.

Note that the associated actors are captured by the IfcOccupant class." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcSpatialStructureElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i596" GlobalId="3MxbCTj6D5WRRFNgwF85B2" Name="AgreementType" Description="Identifies the predefined types of property agreement from which the type required may be set." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_PropertyAgreementType">
								<EnumerationValues>
									<IfcLabel-wrapper>ASSIGNMENT</IfcLabel-wrapper>
									<IfcLabel-wrapper>LEASE</IfcLabel-wrapper>
									<IfcLabel-wrapper>TENANT</IfcLabel-wrapper>
									<IfcLabel-wrapper>OTHER</IfcLabel-wrapper>
									<IfcLabel-wrapper>NOTKNOWN</IfcLabel-wrapper>
									<IfcLabel-wrapper>UNSET</IfcLabel-wrapper>
								</EnumerationValues>
							</Enumerators>
						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate id="i597" GlobalId="16LfS0qVWHuO00025QrE$V" Name="Identifier" Description="The identifier assigned to the agreement for the purposes of tracking." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i598" GlobalId="1GU9M0qVWHuO00025QrE$V" Name="Version" Description="The version number of the agreement that is identified." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i599" GlobalId="1RCog0qVWHuO00025QrE$V" Name="VersionDate" Description="The date on which the version of the agreement became applicable." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDate" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i600" GlobalId="1ZYsM0qVWHuO00025QrE$V" Name="PropertyName" Description="Addressing details of the property as stated within the agreement." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i601" GlobalId="1kHVg0qVWHuO00025QrE$V" Name="CommencementDate" Description="Date on which the agreement commences." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDate" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i602" GlobalId="1tDim0qVWHuO00025QrE$V" Name="TerminationDate" Description="Date on which the agreement terminates." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDate" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i603" GlobalId="209vs0qVWHuO00025QrE$V" Name="Duration" Description="The period of time for the lease." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDuration" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i604" GlobalId="27vq80qVWHuO00025QrE$V" Name="Options" Description="A statement of the options available in the agreement." TemplateType="p_singlevalue" PrimaryMeasureType="IfcText" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i605" GlobalId="2Gs1E0qVWHuO00025QrE$V" Name="ConditionCommencement" Description="Condition of property provided on commencement of the agreement e.g. cold shell, warm lit shell, broom clean, turn-key." TemplateType="p_singlevalue" PrimaryMeasureType="IfcText" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i606" GlobalId="2QONk0qVWHuO00025QrE$V" Name="Restrictions" Description="Restrictions that may be placed by a  competent authority." TemplateType="p_singlevalue" PrimaryMeasureType="IfcText" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i607" GlobalId="2WLro0qVWHuO00025QrE$V" Name="ConditionTermination" Description="Condition of property required on termination of the agreement e.g. cold shell, warm lit shell, broom clean, turn-key." TemplateType="p_singlevalue" PrimaryMeasureType="IfcText" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i608" GlobalId="2zaoU0qWOHuO00025QrE$V" Name="Pset_ServiceLife" Description="Captures the period of time that an artifact will last.  HISTORY: Introduced in IFC2X4 as replacement for IfcServiceLife." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i609" GlobalId="3gtzM0qWOHuO00025QrE$V" Name="ServiceLifeDuration" Description="The length or duration of a service life.  

The lower bound indicates pessimistic service life, the upper bound indicates optimistic service life, and the setpoint indicates the typical service life." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcDuration" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i610" GlobalId="2EilHdaS92vxcNcMLf5IrF" Name="MeanTimeBetweenFailure" Description="The average time duration between instances of failure of a product." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDuration" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i611" GlobalId="1HchKxcpX8r9J3ol3Qo6YE" Name="Pset_ServiceLifeFactors" Description="Captures various factors that impact the expected service life of elements within the system or zone." TemplateType="pset_occurrencedriven" ApplicableEntity="IfcSystem">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i612" GlobalId="3LzIU75Rv2eBKvppy605JZ" Name="QualityOfComponents" Description="Adjustment of the service life resulting from the effect of the quality of components used." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i613" GlobalId="2DT$ZBabjC$RwaWm7qB8cW" Name="DesignLevel" Description="Adjustment of the service life resulting from the effect of design level employed." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i614" GlobalId="2iUDdWqvj3zAyiUtMMrWPd" Name="WorkExecutionLevel" Description="Adjustment of the service life resulting from the effect of the quality of work executed." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i615" GlobalId="2h9yA6q2T9ZfOglK_Wohce" Name="IndoorEnvironment" Description="Adjustment of the service life resulting from the effect of the indoor environment (where appropriate)." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i616" GlobalId="2PYAiYllv5oQiyb9SiORsG" Name="OutdoorEnvironment" Description="Adjustment of the service life resulting from the effect of the outdoor environment (where appropriate)" TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i617" GlobalId="0th9Dg6mf2lwF0z9cCob3a" Name="InUseConditions" Description="Adjustment of the service life resulting from the effect of the conditions in which components are operating." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i618" GlobalId="2Nvr9q12L4g9osMugKTcqm" Name="MaintenanceLevel" Description="Adjustment of the service life resulting from the effect of the level or degree of maintenance applied to dcomponents." TemplateType="p_boundedvalue" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i619" GlobalId="0HeWe0qWyHuO00025QrE$V" Name="Pset_SystemFurnitureElementTypeCommon" Description="Common properties for all systems furniture (I.e. modular furniture) element types (e.g. vertical panels, work surfaces, and storage). HISTORY: First issued in IFC Release R1.5. Renamed from Pset_FurnitureElementCommon" TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcSystemFurnitureElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i620" GlobalId="0M$rI0qWyHuO00025QrE$V" Name="IsUsed" Description="Indicates whether the element is being used in a workstation (= TRUE) or not.(= FALSE)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i621" GlobalId="0TZSm0qWyHuO00025QrE$V" Name="GroupCode" Description="e.g. panels, worksurfaces, storage, etc." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i622" GlobalId="0ajDe0qWyHuO00025QrE$V" Name="NominalWidth" Description="The nominal width of the system furniture elements of this type. The size information is provided in addition to the shape representation and the geometric parameters used within. In cases of inconsistency between the geometric parameters and the size properties, provided in the attached property set, the geometric parameters take precedence." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i623" GlobalId="0j3HK0qWyHuO00025QrE$V" Name="NominalHeight" Description="The nominal height of the system furniture elements of this type. The size information is provided in addition to the shape representation and the geometric parameters used within. In cases of inconsistency between the geometric parameters and the size properties, provided in the attached property set, the geometric parameters take precedence." TemplateType="p_singlevalue" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i624" GlobalId="0rPL00qWyHuO00025QrE$V" Name="Finishing" Description="The finishing applied to system furniture elements of this type e.g. walnut, fabric." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i625" GlobalId="01GLs0qXOHuO00025QrE$V" Name="Pset_Warranty" Description="An assurance given by the seller or provider of an artefact that the artefact is without defects and will operate as described for a defined period of time without failure and that if a defect does arise during that time, that it will be corrected by the seller or provider." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcElement">
					<HasPropertyTemplates>
						<IfcSimplePropertyTemplate id="i626" GlobalId="08Q6k0qXOHuO00025QrE$V" Name="WarrantyIdentifier" Description="The identifier assigned to a warranty." TemplateType="p_singlevalue" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i627" GlobalId="0EzkC0qXOHuO00025QrE$V" Name="WarrantyStartDate" Description="The date on which the warranty commences." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDate" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i628" GlobalId="0KL2s0qXOHuO00025QrE$V" Name="WarrantyEndDate" Description="The date on which the warranty expires." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDate" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i629" GlobalId="0PiNW0qXOHuO00025QrE$V" Name="IsExtendedWarranty" Description="Indication of whether this is an extended warranty whose duration is greater than that normally assigned to an artefact (=TRUE) or not (= FALSE)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i630" GlobalId="0Ws8O0qXOHuO00025QrE$V" Name="WarrantyPeriod" Description="The time duration during which a manufacturer or supplier guarantees or warrants the performance of an artefact." TemplateType="p_singlevalue" PrimaryMeasureType="IfcDuration" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i631" GlobalId="0gOUu0qXOHuO00025QrE$V" Name="WarrantyContent" Description="The content of the warranty." TemplateType="p_singlevalue" PrimaryMeasureType="IfcText" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i632" GlobalId="0cDT20qXOHuO00025QrE$V" Name="PointOfContact" Description="The organization that should be contacted for action under the terms of the warranty. Note that the role of the organization (manufacturer, supplier, installer etc.) is determined by the IfcActorRole attribute of IfcOrganization." TemplateType="p_singlevalue" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i633" GlobalId="0my6M0qXOHuO00025QrE$V" Name="Exclusions" Description="Items, conditions or actions that may be excluded from the warranty or that may cause the warranty to become void." TemplateType="p_singlevalue" PrimaryMeasureType="IfcText" SecondaryMeasureType="" />
					</HasPropertyTemplates>
				</IfcPropertySetTemplate>
				<IfcPropertySetTemplate id="i634" GlobalId="0ZMi60qRqHuO00025QrE$V" Name="Pset_ActuatorTypeCommon" Description="Actuator type common attributes." TemplateType="pset_typedrivenoverride" ApplicableEntity="IfcActuator">
					<HasPropertyTemplates>
