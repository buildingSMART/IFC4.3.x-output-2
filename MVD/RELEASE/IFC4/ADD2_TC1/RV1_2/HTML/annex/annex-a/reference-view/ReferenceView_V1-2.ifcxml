						</IfcSimplePropertyTemplate>
						<IfcSimplePropertyTemplate id="i1388" GlobalId="2QsvgNjVf3cvzMGb_fA7fz" Name="PlacementType" Description="Indicates how the space heater is designed to be placed." TemplateType="p_enumeratedvalue" PrimaryMeasureType="IfcLabel">
							<Enumerators Name="PEnum_SpaceHeaterPlacementType">
								<EnumerationValues>
									<IfcLabel-wrapper>BASEBOARD</IfcLabel-wrapper>
									<IfcLabel-wrapper>TOWELWARMER</IfcLabel-wrapper>
