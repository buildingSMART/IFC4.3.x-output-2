						<IfcSimplePropertyTemplate id="i1123" GlobalId="0cg7e0qSeHuO00025QrE$V" Name="TotalUACurves" Description="Total UA curves, UA - air and water velocities, UA = [(C1 * AirFlowRate^0.8)^-1 + (C2 * WaterFlowRate^0.8)^-1]^-1.  Note: as two variables are used, DefiningValues and DefinedValues are null, and values are stored in IfcTable in the following order: AirFlowRate,WaterFlowRate,UA.  The IfcTable is related to IfcPropertyTableValue using IfcMetric and IfcPropertyConstraintRelationship." TemplateType="p_tablevalue" PrimaryMeasureType="IfcReal" SecondaryMeasureType="IfcVolumetricFlowRateMeasure" />
						<IfcSimplePropertyTemplate id="i1124" GlobalId="0l0BK0qSeHuO00025QrE$V" Name="WaterPressureDropCurve" Description="Water pressure drop curve, pressure drop – flow rate curve, WaterPressureDrop = f(WaterflowRate)." TemplateType="p_tablevalue" PrimaryMeasureType="IfcVolumetricFlowRateMeasure" SecondaryMeasureType="IfcPressureMeasure" />
						<IfcSimplePropertyTemplate id="i1125" GlobalId="0tMF00qSeHuO00025QrE$V" Name="BypassFactor" Description="Fraction of air that is bypassed by the coil (0-1)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1126" GlobalId="0yjZg0qSeHuO00025QrE$V" Name="SensibleHeatRatio" Description="Air-side sensible heat ratio, or fraction of sensible heat transfer to the total heat transfer." TemplateType="p_singlevalue" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" />
						<IfcSimplePropertyTemplate id="i1127" GlobalId="12h1k0qSeHuO00025QrE$V" Name="WetCoilFraction" Description="Fraction of coil surface area that is wet (0-1)." TemplateType="p_singlevalue" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" />
