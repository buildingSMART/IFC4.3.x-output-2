						<IfcSimplePropertyTemplate GlobalId="03JspggTX8tub0GPwCT481" Name="CellEfficiency" Description="The ratio of power generated divided by incident solar power." TemplateType="p_singlevalue" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" />
