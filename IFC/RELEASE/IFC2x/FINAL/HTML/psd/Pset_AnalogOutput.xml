<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcHvacDomain"/>
  <Name>Pset_AnalogOutput</Name>
  <Definition>Definition from IAI: This property set is used to define the characteristics of an analog output.

HISTORY: New property set in IFC Release 2.0.

ISSUES: No issues to date.</Definition>
  <Typed>False</Typed>
  <TypedClass></TypedClass>
  <TypeName></TypeName>
  <PropertyDefs>
    <PropertyDef id="72">
      <Name>HighLimit</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcReal"/>
          <UnitType type="UserDefined"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
The high limit value for the analog output.
      </Definition>
    </PropertyDef>

    <PropertyDef id="73">
      <Name>LowLimit</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcReal"/>
          <UnitType type="UserDefined"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
The low limit value for the analog output.
      </Definition>
    </PropertyDef>

    <PropertyDef id="74">
      <Name>Deadband</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcReal"/>
          <UnitType type="UserDefined"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
The deadband value for the analog output.
      </Definition>
    </PropertyDef>

    <PropertyDef id="75">
      <Name>HighLimitEnable</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcBoolean"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="False"/>
        <MaxValue value="True"/>
        <DefaultValue value="False"/>
      </ValueDef>
      <Definition>
Is HighLimit validation enabled (TRUE) or not (FALSE).
      </Definition>
    </PropertyDef>

    <PropertyDef id="76">
      <Name>LowLimitEnable</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcBoolean"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="False"/>
        <MaxValue value="True"/>
        <DefaultValue value="False"/>
      </ValueDef>
      <Definition>
Is LowLimit validation enabled (TRUE) or not (FALSE).
      </Definition>
    </PropertyDef>

    <PropertyDef id="77">
      <Name>EventEnableEnum</Name>
      <PropertyType>
        <TypePropertyEnumeratedValue>
          <EnumList name="Pset_EventEnableEnum">
            <EnumItem>To-OffNormal</EnumItem>
            <EnumItem>To-Fault</EnumItem>
            <EnumItem>To-Normal</EnumItem>
            <EnumItem>Other</EnumItem>
            <EnumItem>NotKnown</EnumItem>
            <EnumItem>Unset</EnumItem>
          </EnumList>
        </TypePropertyEnumeratedValue>
      </PropertyType>
      <ValueDef>
        <MinValue value=""/>
        <MaxValue value=""/>
        <DefaultValue value=""/>
      </ValueDef>
      <Definition>
Enumeration that defines the type of event enabling
      </Definition>
    </PropertyDef>

    <PropertyDef id="78">
      <Name>NotifyTypeEnum</Name>
      <PropertyType>
        <TypePropertyEnumeratedValue>
          <EnumList name="Pset_NotifyTypeEnum">
            <EnumItem>Alarm</EnumItem>
            <EnumItem>Event</EnumItem>
            <EnumItem>AcknowledgeNotification</EnumItem>
            <EnumItem>Other</EnumItem>
            <EnumItem>NotKnown</EnumItem>
            <EnumItem>Unset</EnumItem>
          </EnumList>
        </TypePropertyEnumeratedValue>
      </PropertyType>
      <ValueDef>
        <MinValue value=""/>
        <MaxValue value=""/>
        <DefaultValue value=""/>
      </ValueDef>
      <Definition>
Enumeration that defines the notification type
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>