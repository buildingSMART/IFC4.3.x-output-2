<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcArchitectureDomain"/>
  <Name>Pset_PermeableCoveringGrill</Name>
  <Definition>Definition from IAI: Properties common to the definition of all types "Grill" of all IfcPermeableCovering.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcPermeableCovering</TypedClass>
  <TypeName>Grill</TypeName>
  <PropertyDefs>
    <PropertyDef id="556">
      <Name>HorizontalSpacing</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Spacing of the screening wire at the angle set by Orientation.
      </Definition>
    </PropertyDef>

    <PropertyDef id="557">
      <Name>VerticalSpacing</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Spacing of the screening wire at the angle perpendicular to that set by Orientation.
      </Definition>
    </PropertyDef>

    <PropertyDef id="558">
      <Name>FinWidth</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Width (when viewed from finished side) of the fins in this grill.
      </Definition>
    </PropertyDef>

    <PropertyDef id="559">
      <Name>FinDepth</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Depth (finished side to back side) of the fins in this grill.
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>