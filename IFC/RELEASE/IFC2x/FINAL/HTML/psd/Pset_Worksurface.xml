<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcSharedFacilitiesElements"/>
  <Name>Pset_Worksurface</Name>
  <Definition>Definition from IAI: A set of specific properties for work surfaces used in workstations.

HISTORY: {{new Pset in IFC Release R2.0}}

ISSUE:</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcSystemFurnitureElement</TypedClass>
  <TypeName>Worksurface</TypeName>
  <PropertyDefs>
    <PropertyDef id="761">
      <Name>UsePurpose</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="empty string"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
e.g. writing/reading, computer, meeting, printer, reference files, etc.
      </Definition>
    </PropertyDef>

    <PropertyDef id="760">
      <Name>SupportType</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="empty string"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
I.e. Freestanding or supported
      </Definition>
    </PropertyDef>

    <PropertyDef id="763">
      <Name>HungingHeight</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
The hanging height of the worksurface
      </Definition>
    </PropertyDef>

    <PropertyDef id="408">
      <Name>Thickness</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="4"/>
      </ValueDef>
      <Definition>
The thickness of the worksurface
      </Definition>
    </PropertyDef>

    <PropertyDef id="859">
      <Name>ShapeDescription</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="empty string"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
corner square, rectangle, etc.
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>