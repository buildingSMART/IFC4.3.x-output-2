<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcHvacDomain"/>
  <Name>Pset_RotationalActuator</Name>
  <Definition>Definition from IAI: This property set is used to define the characteristics of a rotational actuator.

HISTORY: New property set in IFC Release 2.0.

ISSUES: No issues to date.</Definition>
  <Typed>False</Typed>
  <TypedClass></TypedClass>
  <TypeName></TypeName>
  <PropertyDefs>
    <PropertyDef id="462">
      <Name>FailDirectionEnum</Name>
      <PropertyType>
        <TypePropertyEnumeratedValue>
          <EnumList name="Pset_LinearActuatorFailDirectionEnum">
            <EnumItem>FailIn</EnumItem>
            <EnumItem>FailOut</EnumItem>
            <EnumItem>Other</EnumItem>
            <EnumItem>NotKnown</EnumItem>
            <EnumItem>Unset</EnumItem>
          </EnumList>
        </TypePropertyEnumeratedValue>
      </PropertyType>
      <ValueDef>
        <MinValue value=""/>
        <MaxValue value=""/>
        <DefaultValue value=""/>
      </ValueDef>
      <Definition>
Enumeration that identifies the behavior of the actuator in case of power failure
      </Definition>
    </PropertyDef>

    <PropertyDef id="646">
      <Name>Torque</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcTorqueMeasure"/>
          <UnitType type="TorqueUnit"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Indicates the maximum close-off torque for the actuator
      </Definition>
    </PropertyDef>

    <PropertyDef id="647">
      <Name>RangeAngle</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPlaneAngleMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Indicates the maximum rotation the actuator must traverse
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>