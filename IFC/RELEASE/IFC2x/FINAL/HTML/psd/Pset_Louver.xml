<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcHvacDomain"/>
  <Name>Pset_Louver</Name>
  <Definition>Definition from IAI: This property set is used to define the characteristics of a louver.

HISTORY: New property set in IFC Release 2.0.

ISSUES: No issues to date.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcDamper</TypedClass>
  <TypeName>Louver</TypeName>
  <PropertyDefs>
    <PropertyDef id="100">
      <Name>FrameType</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
The type of frame used by the louver (e.g., Standard, Drainable, etc.)
      </Definition>
    </PropertyDef>

    <PropertyDef id="187">
      <Name>FrameThickness</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
The thickness of the louver frame
      </Definition>
    </PropertyDef>

    <PropertyDef id="182">
      <Name>BladeType</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
The type of blade used in the louver (e.g., "J", "K", Cheveron, Sightproof, Drainable, etc.)
      </Definition>
    </PropertyDef>

    <PropertyDef id="184">
      <Name>BladeThickness</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
The thickness of the louver blade
      </Definition>
    </PropertyDef>

    <PropertyDef id="480">
      <Name>ScreenType</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
The type of screen used in the louver (e.g., Birdscreen, Insect Screen, etc.)
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>