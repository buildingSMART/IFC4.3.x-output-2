<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcProductExtension"/>
  <Name>Pset_SpaceCommon</Name>
  <Definition>Definition from IAI: Properties common to the definition of all IfcSpace.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcSpace</TypedClass>
  <TypeName></TypeName>
  <PropertyDefs>
    <PropertyDef id="34">
      <Name>Description</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Description for this type of Space
      </Definition>
    </PropertyDef>

    <PropertyDef id="688">
      <Name>CodeUseType</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Occupancy type, as defined in the presiding building code.
      </Definition>
    </PropertyDef>

    <PropertyDef id="689">
      <Name>SpaceCatalogue</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Description of the space catalogue
      </Definition>
    </PropertyDef>

    <PropertyDef id="690">
      <Name>ReqSummerSpaceTemperature</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcThermodynamicTemperatureMeasure"/>
          <UnitType type="ThermodynamicTemperatureUnit"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Temperature for the hot (summer ) period, that is required from user/designer view point.
      </Definition>
    </PropertyDef>

    <PropertyDef id="691">
      <Name>ReqSummerSpaceHumidity</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcRatioMeasure"/>
          <UnitType type="UserDefined"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Humidity for the hot (summer ) period, that is required from user/designer view point.
      </Definition>
    </PropertyDef>

    <PropertyDef id="692">
      <Name>ReqWinterSpaceTemperature</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcThermodynamicTemperatureMeasure"/>
          <UnitType type="ThermodynamicTemperatureUnit"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Temperature for the cold (winter ) period, that is required from user/designer view point.
      </Definition>
    </PropertyDef>

    <PropertyDef id="693">
      <Name>ReqWinterSpaceHumidity</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcRatioMeasure"/>
          <UnitType type="UserDefined"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Humidity for the cold (winter ) period, that is required from user/designer view point.
      </Definition>
    </PropertyDef>

    <PropertyDef id="694">
      <Name>ReqIntermediateSpaceTemperature</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcReal"/>
          <UnitType type="ThermodynamicTemperatureUnit"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="n/a"/>
      </ValueDef>
      <Definition>
Temperature for the intermediate (spring, autumn ) period, that is required from user/designer view point.
      </Definition>
    </PropertyDef>

    <PropertyDef id="695">
      <Name>ReqIntermediateSpaceHumidity</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcRatioMeasure"/>
          <UnitType type="UserDefined"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Humidity for the intermediate (spring, autumn ) period, that is required from user/designer view point.
      </Definition>
    </PropertyDef>

    <PropertyDef id="696">
      <Name>ReqDiscontinuedHeating</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcBoolean"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="True"/>
        <MaxValue value="False"/>
        <DefaultValue value="False"/>
      </ValueDef>
      <Definition>
True if discontinued heating is required/desirable from user/designer view point.
      </Definition>
    </PropertyDef>

    <PropertyDef id="697">
      <Name>MainFireUse</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Main fire use for the space which is assigned from the Fire Use Classification.
      </Definition>
    </PropertyDef>

    <PropertyDef id="698">
      <Name>AncillaryFireUse</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Ancillary fire use for the space which is assigned from the Fire Use Classification.
      </Definition>
    </PropertyDef>

    <PropertyDef id="699">
      <Name>FireRiskFactor</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcInteger"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="1"/>
      </ValueDef>
      <Definition>
Fire Risk factor assigned to the space
      </Definition>
    </PropertyDef>

    <PropertyDef id="700">
      <Name>NaturalVentilation</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcBoolean"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="True"/>
      </ValueDef>
      <Definition>
Indication whether the space is ventilated natural (true) or mechanical (false).
      </Definition>
    </PropertyDef>

    <PropertyDef id="701">
      <Name>SprinklerProtection</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcBoolean"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="False"/>
      </ValueDef>
      <Definition>
Indication whether the space is sprinkler protected (true) or not (false).
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>