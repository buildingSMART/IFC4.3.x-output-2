<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcArchitectureDomain"/>
  <Name>Pset_SpaceProgramOccupiedStandard</Name>
  <Definition>Definition from IAI: Standard (repeating) program for multiple, like spaces to be occupied by humans.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcSpaceProgram</TypedClass>
  <TypeName>OccupiedSpaceProgramStandard</TypeName>
  <PropertyDefs>
    <PropertyDef id="743">
      <Name>EmployeeType</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Examples: manager, programmer, secretary, etc. IFCs don't define standardized employee types. The user should provide the company based terms for employee types.
      </Definition>
    </PropertyDef>

    <PropertyDef id="744">
      <Name>FurnitureStyle</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
The style of furniture for the space or workstation designed
      </Definition>
    </PropertyDef>

    <PropertyDef id="749">
      <Name>StandardLength</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Standard length for spaces of this type
      </Definition>
    </PropertyDef>

    <PropertyDef id="750">
      <Name>StandardWidth</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Standard width for spaces of this type
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>