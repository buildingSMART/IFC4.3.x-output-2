<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcSharedBldgElements"/>
  <Name>Pset_HardwareGroup</Name>
  <Definition>Definition from IAI: Properties common to the definition of all hardware groups as referred to by other property sets.</Definition>
  <Typed>False</Typed>
  <TypedClass></TypedClass>
  <TypeName></TypeName>
  <PropertyDefs>
    <PropertyDef id="102">
      <Name>Reference</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcIdentifier"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
User defined reference for this standard collection of hardware elements within this project.
      </Definition>
    </PropertyDef>

    <PropertyDef id="34">
      <Name>Description</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Specific description for this type of hardware within this project.
      </Definition>
    </PropertyDef>

    <PropertyDef id="431">
      <Name>Manufacturer</Name>
      <PropertyType>
        <TypePropertyReferenceValue reftype="IfcOrganization"/>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="n/a"/>
      </ValueDef>
      <Definition>
The organization that manufactured or assembled the item.
      </Definition>
    </PropertyDef>

    <PropertyDef id="432">
      <Name>ModelLabel</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
The model number and/or unit designator assigned by the manufacturer of the manufactured item.
      </Definition>
    </PropertyDef>

    <PropertyDef id="433">
      <Name>ModelDescription</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
A physical description of the manufactured item as provided by the manufacturer of the munufactured item.
      </Definition>
    </PropertyDef>

    <PropertyDef id="256">
      <Name>Finish</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Finish applied to hardware
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>