            <EnumItem>Pressure</EnumItem>
            <EnumItem>Temperature</EnumItem>
            <EnumItem>Gas</EnumItem>
            <EnumItem>Concentration</EnumItem>
            <EnumItem>Volts</EnumItem>
            <EnumItem>Amps</EnumItem>
            <EnumItem>Density</EnumItem>
            <EnumItem>Viscosity</EnumItem>
            <EnumItem>Energy</EnumItem>
            <EnumItem>Humidity</EnumItem>
            <EnumItem>Other</EnumItem>
            <EnumItem>NotKnown</EnumItem>
            <EnumItem>Unset</EnumItem>
          </EnumList>
        </TypePropertyEnumeratedValue>
      </PropertyType>
      <ValueDef>
        <MinValue value=""/>
        <MaxValue value=""/>
        <DefaultValue value=""/>
      </ValueDef>
      <Definition>
Enumeration that identifies the type of HVAC sensor
      </Definition>
    </PropertyDef>

