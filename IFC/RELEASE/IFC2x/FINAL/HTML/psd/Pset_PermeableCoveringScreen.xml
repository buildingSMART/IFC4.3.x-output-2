<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcArchitectureDomain"/>
  <Name>Pset_PermeableCoveringScreen</Name>
  <Definition>Definition from IAI: Properties common to the definition of all types "Screen" of all IfcPermeableCovering.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcPermeableCovering</TypedClass>
  <TypeName>Screen</TypeName>
  <PropertyDefs>
    <PropertyDef id="556">
      <Name>HorizontalSpacing</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Spacing of the screening wire at the angle set by Orientation.
      </Definition>
    </PropertyDef>

    <PropertyDef id="557">
      <Name>VerticalSpacing</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Spacing of the screening wire at the angle perpendicular to that set by Orientation.
      </Definition>
    </PropertyDef>

    <PropertyDef id="567">
      <Name>ScreenThickness</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="1"/>
      </ValueDef>
      <Definition>
Thickness of the screening wire
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>