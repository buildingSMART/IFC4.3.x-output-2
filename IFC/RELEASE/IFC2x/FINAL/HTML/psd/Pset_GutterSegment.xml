<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcSharedBldgServiceElements"/>
  <Name>Pset_GutterSegment</Name>
  <Definition>Definition from IAI: 

HISTORY: New property set in IFC Release 2.0.

ISSUES: No issues to date.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcFlowSegment</TypedClass>
  <TypeName>GutterSegment</TypeName>
  <PropertyDefs>
    <PropertyDef id="109">
      <Name>Slope</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPlaneAngleMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Angle of the gutter to allow for drainage
      </Definition>
    </PropertyDef>

    <PropertyDef id="425">
      <Name>FlowRating</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcVolumetricFlowRateMeasure"/>
          <UnitType type="VolumetricFlowrateUnit"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Actual flow capacity for the gutter. Value of 0.00 means this value has not been set.
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>