<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcSharedBldgElements"/>
  <Name>Pset_SlabRoof</Name>
  <Definition>Definition from IAI: Properties common to the definition of all types "Roof" of all IfcSlab.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcSlab</TypedClass>
  <TypeName>Roof</TypeName>
  <PropertyDefs>
    <PropertyDef id="670">
      <Name>RequiredSlope</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPlaneAngleMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Sloping angle of the roof slab as required by either building regulations or roofing material.
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>