<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcProductExtension"/>
  <Name>Pset_ManufactureOccurrence</Name>
  <Definition>Definition from IAI: Properties about the occurrence specific manufacturer information. Can be attached to all IfcElement.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcElement</TypedClass>
  <TypeName></TypeName>
  <PropertyDefs>
    <PropertyDef id="482">
      <Name>SerialNumber</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
The serial number assigned to the individual manufactured item
      </Definition>
    </PropertyDef>

    <PropertyDef id="483">
      <Name>AcquisitionDate</Name>
      <PropertyType>
        <TypePropertyReferenceValue reftype="IfcCalendarDate"/>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="NIL"/>
      </ValueDef>
      <Definition>
The date that the manufactured item was purchased
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>