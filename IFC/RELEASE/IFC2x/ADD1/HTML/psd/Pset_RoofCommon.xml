<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcSharedBldgElements"/>
  <Name>Pset_RoofCommon</Name>
  <Definition>Definition from IAI: Properties common to the definition of all IfcRoof.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcRoof</TypedClass>
  <TypeName></TypeName>
  <PropertyDefs>
    <PropertyDef id="102">
      <Name>Reference</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcIdentifier"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Reference ID for this roof type in this project (e.g. type 'A-1')
      </Definition>
    </PropertyDef>

    <PropertyDef id="34">
      <Name>Description</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Textual description for this roof type
      </Definition>
    </PropertyDef>

    <PropertyDef id="239">
      <Name>FireRating</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Time duration for fire resistence the roof assembly is rated
      </Definition>
    </PropertyDef>

  </PropertyDefs>
