<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcArchitectureDomain"/>
  <Name>Pset_SpaceProgramCommon</Name>
  <Definition>Definition from IAI: Set of properties common to all types of Space Programs.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcSpaceProgram</TypedClass>
  <TypeName></TypeName>
  <PropertyDefs>
    <PropertyDef id="721">
      <Name>ProgramSpaceDescription</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Description for this space in the Architectural Program (client brief)
      </Definition>
    </PropertyDef>

    <PropertyDef id="726">
      <Name>GeneralLocationDescription</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
General description of location (e.g. "third floor south")
      </Definition>
    </PropertyDef>

    <PropertyDef id="727">
      <Name>Function</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
How is this space to be used
      </Definition>
    </PropertyDef>

    <PropertyDef id="728">
      <Name>SecurityRequirements</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Client requirements for security
      </Definition>
    </PropertyDef>

    <PropertyDef id="729">
      <Name>SpecialRequirements</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Client special requirements
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>