      <Name>TotalCoolingLoad</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPowerMeasure"/>
          <UnitType type="PowerUnit"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
The peak total cooling load for the building.
      </Definition>
    </PropertyDef>

