<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcArchitectureDomain"/>
  <Name>Pset_PermeableCoveringCommon</Name>
  <Definition>Definition from IAI: Properties common to the definition of all IfcPermeableCovering.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcPermeableCovering</TypedClass>
  <TypeName></TypeName>
  <PropertyDefs>
    <PropertyDef id="551">
      <Name>Orientation</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPlaneAngleMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="360"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Orientation angle, when facing the finished side of installed louvers. Horzontal is taken to be zero ("0") angle. Angle is positive in counter-clockwise rotation.
      </Definition>
    </PropertyDef>

    <PropertyDef id="552">
      <Name>FreeAreaVentilation</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcAreaMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Actual usable Area.
      </Definition>
    </PropertyDef>

    <PropertyDef id="553">
      <Name>ClearanceSpace</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Distance needed for correct operation/air flow
      </Definition>
    </PropertyDef>

    <PropertyDef id="554">
      <Name>Operable</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcBoolean"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="False"/>
        <MaxValue value="True"/>
        <DefaultValue value="False"/>
      </ValueDef>
      <Definition>
Designation of operability of this cover
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>