            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3FKZGrWnL47wR1V9jblsAW" Name="PowerFactor" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The ratio between the rated electrical power and the product of the rated current and rated voltage</Description>
              <HasAssociations>
