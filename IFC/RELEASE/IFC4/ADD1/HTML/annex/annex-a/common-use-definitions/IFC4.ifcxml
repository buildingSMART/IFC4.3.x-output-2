                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3$0kC0qSGHuO00025QrE$V" Name="ConstructionMethod" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
