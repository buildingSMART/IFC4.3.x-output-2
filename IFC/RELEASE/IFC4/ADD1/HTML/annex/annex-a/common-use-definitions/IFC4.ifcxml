                    <Description>参照された断面での動圧に対する全圧損失の比を表わす流体抵抗の計算に使用される無次元の損失係数</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_REFERENCEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1FEcy0qTuHuO00025QrE$V" Name="AtmosphericPressure" PrimaryMeasureType="IfcTimeSeries" SecondaryMeasureType="IfcPressureMeasure" AccessState="READWRITE">
