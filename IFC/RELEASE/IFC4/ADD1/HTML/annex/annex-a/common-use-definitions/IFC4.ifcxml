            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0M$rI0qWyHuO00025QrE$V" Name="IsUsed" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Indicates whether the element is being used in a workstation (= TRUE) or not.(= FALSE).</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="21ZRGTRdz4UAz4SgN4eM7x">
