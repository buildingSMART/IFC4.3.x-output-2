              <Description>Local x,y coordinates of the point in which Thickness2 is given</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3GkWw$hKLAreABQMnJn3ZZ">
                  <RelatingLibrary Name="Location2 Local" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_LISTVALUE</TemplateType>
            </IfcPropertyTemplate>
