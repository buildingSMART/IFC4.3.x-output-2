        <IfcPropertySetTemplate GlobalId="3EJUTF8HXEb9xrTS8_yryZ" Name="Qto_FootingBaseQuantities" ApplicableEntity="IfcFooting">
          <Description>Base quantities that are common to the definition of all occurrences of footings.</Description>
          <HasAssociations />
          <PredefinedType>QTO_OCCURRENCEDRIVEN</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="12BA5KY5j0SgdqFTsH5vgg" Name="Length" AccessState="READWRITE">
              <Description>Length of the footing, not taking into account any cut-out's or other processing features. For strip footings it is measured along the path, for other footings it is one of the horizontal dimensions. It should only be provided, if it is constant.</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0y_tUGAofC3xWv4FcdNKKn" Name="Width" AccessState="READWRITE">
              <Description>Total nominal width (or thickness) of the footing. For strip footings it is measured perpendicular to the footing path (or longitudial axis). For other footings it is one of the horizontal dimensions. It should only be provided, if it is constant.</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1TD2kO$SDD_9f5LA6t6esI" Name="Height" AccessState="READWRITE">
              <Description>Total nominal height of the footing. It should only be provided, if it is constant.</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1Lnd_cCr15z9bLvzpyUbQN" Name="CrossSectionArea" AccessState="READWRITE">
              <Description>Total area of the cross section (or profile) of the footing.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3ZvcIV9mb4PhbZXOTYRxzR" Name="OuterSurfaceArea" AccessState="READWRITE">
              <Description>Total area of the extruded surfaces of the footing (not taking into account the end cap areas), normally generated as perimeter * length.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0KuRqOuOP5cAd2dR$qY7EL" Name="GrossSurfaceArea" AccessState="READWRITE">
              <Description>Total area of the footing, normally generated as perimeter * length + 2 * cross section area. It is the sum of OuterSurfaceArea + (2 x CrossSectionArea) and shall only be given, if the OuterSurfaceArea and CrossSectionArea cannot be established separately.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2Ms0t1wvXDY95DOPznnPUw" Name="GrossVolume" AccessState="READWRITE">
              <Description>Total gross volume of the footing, not taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2QETt2hSX1pO2sAe$0ABSg" Name="NetVolume" AccessState="READWRITE">
              <Description>Total net volume of the footing, taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0GsLPmzP13s9Yazm_faILV" Name="GrossWeight" AccessState="READWRITE">
              <Description>Total gross weight of the footing without add-on parts, not taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_WEIGHT</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2Ee9pp_2n2Gxuzp1qTqHVq" Name="NetWeight" AccessState="READWRITE">
              <Description>Total net weight of the footing without add-on parts, taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_WEIGHT</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="0TaLXYhBb2wxKMHoBL9iiN" Name="Qto_PileBaseQuantities" ApplicableEntity="IfcPile">
          <Description>Base quantities that are common to the definition of all occurrences of piles.</Description>
          <HasAssociations />
          <PredefinedType>QTO_OCCURRENCEDRIVEN</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3BPt2RkuDDSx$pKxM3$mP6" Name="Length" AccessState="READWRITE">
              <Description>Total length of the pile not taking into account any cut-out's or other processing features.</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3bUKZ2G_jBqQUc7265DKLf" Name="CrossSectionArea" AccessState="READWRITE">
              <Description>Total area of the cross section (or profile) of the pile.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0XPj$AVfH4APezXss5jS25" Name="OuterSurfaceArea" AccessState="READWRITE">
              <Description>Total area of the extruded surfaces of the pile (not taking into account the end cap areas), normally generated as perimeter * length.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3pBx_ouPT6mxYv0Bf9yhl6" Name="GrossSurfaceArea" AccessState="READWRITE">
              <Description>Total area of the pile, normally generated as perimeter * length + 2 * cross section area. It is the sum of OuterSurfaceArea + (2 x CrossSectionArea) and shall only be given, if the OuterSurfaceArea and CrossSectionArea cannot be established separately.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="07mwJYjA1BrPLsGTe0EARt" Name="GrossVolume" AccessState="READWRITE">
              <Description>Total gross volume of the pile, not taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2DkvC39yPBOeXIACu_rxPH" Name="NetVolume" AccessState="READWRITE">
              <Description>Total net volume of the pile, taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2S66OtuNb5u86nJgZs59hN" Name="GrossWeight" AccessState="READWRITE">
              <Description>Total gross weight of the pile without add-on parts, not taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_WEIGHT</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0rrWZVL2f0TRqu$BTK4LjP" Name="NetWeight" AccessState="READWRITE">
              <Description>Total net weight of the pile without add-on parts, taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_WEIGHT</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
