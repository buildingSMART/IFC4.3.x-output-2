            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1_Lzq0qUmHuO00025QrE$V" Name="ArticleNumber" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Article number or reference that is be applied to a configured product according to a standard scheme for article number definition as defined by the manufacturer. It is often used as the purchasing number.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3g3On8i6H2Wu12XZ76MAju">
                  <RelatingLibrary Name="Article Number" Language="en" />
                </IfcRelAssociatesLibrary>
