                  <RelatingLibrary Name="Expositionsklasse" Language="de-DE">
                    <Description>Klassifikation der Widerstandsfähigkeit gegenüber chemischen und physikalischen Einwirkungen gemäß der aktuellen, im Projekt angewandten, Norm.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2zeMq3zwP8CuYsw6bSeKej">
