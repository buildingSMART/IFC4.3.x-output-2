            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3G1MK0qVOHuO00025QrE$V" Name="ShearDeformationAreaZ" PrimaryMeasureType="IfcAreaMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Area of the profile for calculating the shear deformation due to a shear force parallel to zs. For example measured in mm². If given, the shear deformation area zs shall be non-negative.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0ijbkfeFrDsumwj0Qtus95">
