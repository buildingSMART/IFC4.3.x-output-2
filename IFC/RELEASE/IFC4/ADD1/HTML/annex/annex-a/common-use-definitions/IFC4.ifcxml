            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1MhaW0qTyHuO00025QrE$V" Name="IP_Code" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>IEC 60529 Classification of degrees of protection provided by enclosures (IP Code).</Description>
              <HasAssociations>
