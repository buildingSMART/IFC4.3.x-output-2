                  <RelatingLibrary Name="Anti dérapant" Language="fr-FR">
                    <Description>Indique si la finition est conçue pour être anti dérapante (VRAI) ou non (FAUX).</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="02iZVBBnjBUunGJgmBu3JD">
                  <RelatingLibrary Name="表面是否防滑" Language="zh-CN">
