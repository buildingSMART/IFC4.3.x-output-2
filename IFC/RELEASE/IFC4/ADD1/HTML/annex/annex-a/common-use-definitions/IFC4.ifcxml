                  <RelatingLibrary Name="Location1 Local" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_LISTVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0VB5hczAH7CvQQx$j1YIft" Name="Location1Global" PrimaryMeasureType="IfcLengthMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Global X,Y,Z coordinates of the point in which Thickness1 is given</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0g432wCTLFIhcgW8XjjY_g">
                  <RelatingLibrary Name="Location1 Global" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_LISTVALUE</TemplateType>
            </IfcPropertyTemplate>
