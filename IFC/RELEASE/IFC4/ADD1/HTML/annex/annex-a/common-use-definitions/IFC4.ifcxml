            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="21gPE0qW4HuO00025QrE$V" Name="AffectsSurroundings" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Indicates wether the risk affects only to the person assigned to that task (FALSE) or if it can also affect to the people in the surroundings (TRUE).

For example, the process of painting would affect all the people in the vicinity of the process.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2QBLSfax17$BfcMpWtahx3">
                  <RelatingLibrary Name="Affects Surroundings" Language="en" />
                </IfcRelAssociatesLibrary>
