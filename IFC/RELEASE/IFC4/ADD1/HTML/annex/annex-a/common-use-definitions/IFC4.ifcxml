            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2gDIxRw5j76vk96Ucw8BJM" Name="DuctSizingMethod" PrimaryMeasureType="IfcLabel" AccessState="READWRITE">
