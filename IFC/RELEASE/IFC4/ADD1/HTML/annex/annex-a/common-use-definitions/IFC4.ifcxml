            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2VoC40qWmHuO00025QrE$V" Name="AirConditioning" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
