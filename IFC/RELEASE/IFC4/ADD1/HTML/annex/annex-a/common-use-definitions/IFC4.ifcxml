            <IfcRelAssociatesLibrary GlobalId="0XcnILgLb7IAfnaZ1u30HE">
              <RelatingLibrary Language="zh-CN">
                <Description>所有PredefinedType设置为FLOORING的IfcCovering实例的定义中通用的属性。</Description>
              </RelatingLibrary>
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1Ytja0qT0HuO00025QrE$V" Name="HasNonSkidSurface" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Indication whether the surface finish is designed to prevent slippery (TRUE) or not (FALSE).</Description>
              <HasAssociations>
