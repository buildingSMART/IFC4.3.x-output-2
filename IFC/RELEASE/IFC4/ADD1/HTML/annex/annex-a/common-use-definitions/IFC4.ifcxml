                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2P_KGeLk5C8gmy8Yx1T8i2">
                  <RelatingLibrary Name="中央式空調" Language="ja-JP">
