                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0cTlsBvp17NxNlwtqnVDiM">
                  <RelatingLibrary Name="Handicap Accessible" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3PhfieURr108VPbGyT8$_M">
                  <RelatingLibrary Name="AccessibleHandicapes" Language="fr-FR">
                    <Description>Indique que cet objet est conçu pour être accessible aux handicapés. Indication donnée selon le Code National.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="27vq3k0TH7qvOETYc$x75g">
                  <RelatingLibrary Name="ハンディキャップアクセス可能性" Language="ja-JP">
                    <Description>この空間がハンディキャップ者向けの空間かどうかを示すブーリアン値。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2o2kRvP2H5rQ2dUxxlUIL4">
                  <RelatingLibrary Name="是否为无障碍设施" Language="zh-CN">
                    <Description>表示该构件是否设计为可供残疾人使用的无障碍设施。
该属性的根据为国家建筑规范。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1cFOa0qVyHuO00025QrE$V" Name="HasNonSkidSurface" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Indication whether the surface finish is designed to prevent slippery (TRUE) or not (FALSE).</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1aZvnjTUDDUPdvcKwnNrPi">
                  <RelatingLibrary Name="Nichtrutschende Oberfläche" Language="de-DE">
