                <IfcRelAssociatesLibrary GlobalId="2UhX8UI555VgSlOfJmyJ0p">
                  <RelatingLibrary Name="Rugosité" Language="fr-FR">
                    <Description>Une mesure des déviations verticales de la surface.</Description>
                  </RelatingLibrary>
