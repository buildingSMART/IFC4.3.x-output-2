                    <Description>[%]로 지정된 시간 / 특성 곡선의 허용 범위는 상기의 허용 전류 한계 1의 전류로 사용할 수 있습니다.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3vm8i0qVeHuO00025QrE$V" Name="IsTimeTolerancePositiveOnly" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Indication whether the value of  TimeTolerance1 is provided as a positive tolereance only  or not. If not, the value is proved as a pluss/minus tolerance.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1eawnI0PD0B8X6tUDn1c0Q">
                  <RelatingLibrary Name="Is Time Tolerance Positive Only" Language="en" />
                </IfcRelAssociatesLibrary>
