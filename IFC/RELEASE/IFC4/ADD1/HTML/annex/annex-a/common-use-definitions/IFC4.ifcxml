                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3FTic0qWeHuO00025QrE$V" Name="OccupancyNumber" PrimaryMeasureType="IfcCountMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Number of people required for the activity assigned to this space.</Description>
