              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3G1sG0qVeHuO00025QrE$V" Name="CurrentToleranceLimit1" PrimaryMeasureType="IfcTimeMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The time limit in [s] limiting the application of CurrentTolerance1, if any. If the value is set to 0, the value of the CurrentTolerance1 is valid for the whole time/current-curve.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3Gy3EQi4T5y9Mv9SksnPJl">
