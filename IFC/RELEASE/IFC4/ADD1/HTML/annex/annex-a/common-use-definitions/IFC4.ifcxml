            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1uRFQ0qW8HuO00025QrE$V" Name="CisternCapacity" PrimaryMeasureType="IfcVolumeMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Volumetric capacity of the cistern</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1noA_d7695fweA0F$QZKyH">
                  <RelatingLibrary Name="Cistern Capacity" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2Nd8nxoGbEwhy4NeWutNcR">
                  <RelatingLibrary Name="貯水タンク容量" Language="ja-JP">
                    <Description>貯水タンクの体積容量。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
