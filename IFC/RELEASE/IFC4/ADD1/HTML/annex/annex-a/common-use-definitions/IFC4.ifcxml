                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0it6Nu2hPAHRNHyMEtibkc">
                  <RelatingLibrary Name="日除け装置種別" Language="ja-JP">
                    <Description>日除け装置の種別を設定する。</Description>
