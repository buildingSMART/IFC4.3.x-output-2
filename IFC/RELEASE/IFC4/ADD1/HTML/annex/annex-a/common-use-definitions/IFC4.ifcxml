            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3c_uM0qVqHuO00025QrE$V" Name="Sensitivity" PrimaryMeasureType="IfcElectricCurrentMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The rated rms value of the vector sum of the instantaneous currents flowing in the main circuits of the device which causes the device to operate under specified conditions. (IEC 61008-1).</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0HM7rBxuf8Yu2Me9lCdsUn">
                  <RelatingLibrary Name="Sensitivity" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="06ztctY9X44elnkVbP2IdH">
                  <RelatingLibrary Name="感度" Language="ja-JP">
                    <Description>装置のメイン回路を流れる瞬時電流の合計ベクトルの関連する rms 値、特定の条件になると機器が動作するようになる（IEC 61008-1)。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="1joMLhOJfD9BlyFUX9OVZf">
                  <RelatingLibrary Name="감도" Language="ko-KR">
                    <Description>장치의 기본 회로를 흐르는 순간 전류의 합계 벡터 관련 rms 값이 특정 조건이되면 장치가 작동하게된다 (IEC 61008-1).</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
