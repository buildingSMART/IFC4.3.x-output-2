                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_ENUMERATEDVALUE</TemplateType>
              <Enumerators Name="PEnum_FuseDisconnectorType">
                <EnumerationValues>
                  <IfcLabel>
                    <Value>ENGINEPROTECTIONDEVICE</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>FUSEDSWITCH</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>HRC</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>OVERLOADPROTECTIONDEVICE</Value>
