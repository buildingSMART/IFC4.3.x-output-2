            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1H4Yk0qVeHuO00025QrE$V" Name="ExternalAdjusted" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
