          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1sJ6q0qUqHuO00025QrE$V" Name="DynamicViscosity" PrimaryMeasureType="IfcDynamicViscosityMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A measure of the viscous resistance of the material.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0C7ZFPeGjFOOoRQApey5_F">
                  <RelatingLibrary Name="Dynamic Viscosity" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1x4I40qUqHuO00025QrE$V" Name="YoungModulus" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A measure of the Young's modulus of elasticity of the material.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0kurV3EEvFERx8uZcA5IrG">
                  <RelatingLibrary Name="Young Modulus" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="20Rck0qUqHuO00025QrE$V" Name="ShearModulus" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A measure of the shear modulus of elasticity of the material.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="26rPs0pv14WvqCscd9GXeI">
                  <RelatingLibrary Name="Shear Modulus" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="25Cn_0qUqHuO00025QrE$V" Name="PoissonRatio" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A measure of the lateral deformations in the elastic range.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3V_kttR51EzPv1$6_MIi0N">
                  <RelatingLibrary Name="Poisson Ratio" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2BAG20qUqHuO00025QrE$V" Name="ThermalExpansionCoefficient" PrimaryMeasureType="IfcThermalExpansionCoefficientMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A measure of the expansion coefficient for warming up the material about one Kelvin.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2ZrnS1GeTCkBHwsGoYQvng">
                  <RelatingLibrary Name="Thermal Expansion Coefficient" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="2HjtW0qUqHuO00025QrE$V" Name="Pset_MaterialOptical" ApplicableEntity="IfcMaterial">
          <Description>A set of optical properties of materials.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="1ZJueydlz7j9x_IN$$Slrf">
              <RelatingLibrary Name="Material Optical" Language="en" />
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2LIly0qUqHuO00025QrE$V" Name="VisibleTransmittance" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Transmittance at normal incidence (visible). Defines the fraction of the visible spectrum of solar radiation that passes through per unit area, perpendicular to the surface.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0fOuhrZAPA79legqlbufDO">
                  <RelatingLibrary Name="Visible Transmittance" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2SSWq0qUqHuO00025QrE$V" Name="SolarTransmittance" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Transmittance at normal incidence (solar). Defines the fraction of solar radiation that passes through per unit area, perpendicular to the surface.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2c0FMTwJ1DZg1ZuqlVerSV">
                  <RelatingLibrary Name="Solar Transmittance" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2XprU0qUqHuO00025QrE$V" Name="ThermalIrTransmittance" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Thermal IR transmittance at normal incidence. Defines the fraction of thermal energy that passes through per unit area, perpendicular to the surface.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="07BplUs654hQ3gLtdAfV4q">
                  <RelatingLibrary Name="Thermal Ir Transmittance" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2dBA80qUqHuO00025QrE$V" Name="ThermalIrEmissivityBack" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Thermal IR emissivity: back side. Defines the fraction of thermal energy emitted per unit area to "blackbody" at the same temperature, through the "back" side of the material.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="23I0GgcPj4Q9jPCw_Yjz63">
                  <RelatingLibrary Name="Thermal Ir Emissivity Back" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2iYUo0qUqHuO00025QrE$V" Name="ThermalIrEmissivityFront" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Thermal IR emissivity: front side. Defines the fraction of thermal energy emitted per unit area to "blackbody" at the same temperature, through the "front" side of the material.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3t5BiIbl59MPBBMg0PNUs5">
                  <RelatingLibrary Name="Thermal Ir Emissivity Front" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2tH860qUqHuO00025QrE$V" Name="VisibleReflectanceBack" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Reflectance at normal incidence (visible): back side. Defines the fraction of the solar ray in the visible spectrum that is reflected and not transmitted when the ray passes from one medium into another, at the "back" side of the other material, perpendicular to the surface. Dependent on material and surface characteristics.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1Uni3oVjP9XedOWAQnHRSO">
                  <RelatingLibrary Name="Visible Reflectance Back" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2zEcA0qUqHuO00025QrE$V" Name="VisibleReflectanceFront" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Reflectance at normal incidence (visible): front side. Defines the fraction of the solar ray in the visible spectrum that is reflected and not transmitted when the ray passes from one medium into another, at the "front" side of the other material, perpendicular to the surface. Dependent on material and surface characteristics.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3ENvGTlb14fPxj2BimTbo7">
                  <RelatingLibrary Name="Visible Reflectance Front" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="33C4E0qUqHuO00025QrE$V" Name="SolarReflectanceBack" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Reflectance at normal incidence (solar): back side. Defines the fraction of the solar ray that is reflected and not transmitted when the ray passes from one medium into another, at the "back" side of the other material, perpendicular to the surface. Dependent on material and surface characteristics.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2C1KMPh6P9FB3kU_yXWG_E">
                  <RelatingLibrary Name="Solar Reflectance Back" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="37zFU0qUqHuO00025QrE$V" Name="SolarReflectanceFront" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Reflectance at normal incidence (solar): front side. Defines the fraction of the solar ray that is reflected and not transmitted when the ray passes from one medium into another, at the "front" side of the other material, perpendicular to the surface. Dependent on material and surface characteristics.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2hH8RgZV9EWuFtjjWjb0Zd">
                  <RelatingLibrary Name="Solar Reflectance Front" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="3EWsy0qUqHuO00025QrE$V" Name="Pset_MaterialSteel" ApplicableEntity="IfcMaterial/Steel">
          <Description>A set of extended mechanical properties related to steel (or other metallic and isotropic) materials.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="1vFi$fcIn4HxPXXwflwhSE">
              <RelatingLibrary Name="Material Steel" Language="en" />
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3JuBc0qUqHuO00025QrE$V" Name="YieldStress" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A measure of the yield stress (or characteristic 0.2 percent proof stress) of the material.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="049tDkKJH8$e3Ag1rjkwDK">
                  <RelatingLibrary Name="Yield Stress" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3Prfg0qUqHuO00025QrE$V" Name="UltimateStress" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A measure of the ultimate stress of the material.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3_Xp$DA49BdemZK3A4eGRJ">
                  <RelatingLibrary Name="Ultimate Stress" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3VC_K0qUqHuO00025QrE$V" Name="UltimateStrain" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A measure of the (engineering) strain at the state of ultimate stress of the material.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2A3vf$Kvz4FwaHPZF_TiaR">
                  <RelatingLibrary Name="Ultimate Strain" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3aaI_0qUqHuO00025QrE$V" Name="HardeningModule" PrimaryMeasureType="IfcModulusOfElasticityMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A measure of the hardening module of the material (slope of stress versus strain curve after yield range).</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0mBbW0Mmb2BwyQTUoX7cW3">
                  <RelatingLibrary Name="Hardening Module" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3fxde0qUqHuO00025QrE$V" Name="ProportionalStress" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A measure of the proportional stress of the material. It describes the stress before the first plastic deformation occurs and is commonly measured at a deformation of 0.01%.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="19VtNr__98fOIHaq$Fh6N5">
                  <RelatingLibrary Name="Proportional Stress" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3lv5i0qUqHuO00025QrE$V" Name="PlasticStrain" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A measure of the permanent displacement, as in slip or twinning, which remains after the stress has been removed. Currently applied to a strain of 0.2% proportional stress of the material.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2TOzAPd5L3B9yC6hqO8HlG">
                  <RelatingLibrary Name="Plastic Strain" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3rGQM0qUqHuO00025QrE$V" Name="Relaxations" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="IfcNormalisedRatioMeasure" AccessState="READWRITE">
              <Description>Measures of decrease in stress over long time intervals resulting from plastic flow. Different relaxation values for different initial stress levels for a material may be given. It describes the time dependent relative relaxation value for a given initial stress level at constant strain.
Relating values are the "RelaxationValue". Related values are the "InitialStress"</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2$Vu2RlRH90hazJT1JPCXG">
                  <RelatingLibrary Name="Relaxations" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_TABLEVALUE</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="03Zy60qUuHuO00025QrE$V" Name="Pset_MaterialThermal" ApplicableEntity="IfcMaterial">
          <Description>A set of thermal material properties.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="3lBvuoG_PFbPFAYvHnIW9g">
              <RelatingLibrary Name="Material Thermal" Language="en" />
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="078qY0qUuHuO00025QrE$V" Name="SpecificHeatCapacity" PrimaryMeasureType="IfcSpecificHeatCapacityMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Defines the specific heat of the material: heat energy absorbed per temperature unit.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0van8tV5f73BUISbb66kc3">
                  <RelatingLibrary Name="Specific Heat Capacity" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0Bv$o0qUuHuO00025QrE$V" Name="BoilingPoint" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The boiling point of the material (fluid).</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3saCH2KGHAWBlE7rKXtoME">
                  <RelatingLibrary Name="Boiling Point" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0HtTs0qUuHuO00025QrE$V" Name="FreezingPoint" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The freezing point of the material (fluid).</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0iCfZWVtz5$R9DPh0c0cIW">
                  <RelatingLibrary Name="Freezing Point" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0Nqxw0qUuHuO00025QrE$V" Name="ThermalConductivity" PrimaryMeasureType="IfcThermalConductivityMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The rate at which thermal energy is transmitted through the material.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2ODsMP$QD0mQIX1G_SEv4n">
                  <RelatingLibrary Name="Thermal Conductivity" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="0ToP_0qUuHuO00025QrE$V" Name="Pset_MaterialWater" ApplicableEntity="IfcMaterial">
          <Description>A set of extended material properties for of water typically used within the context of building services and flow distribution systems.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="39DaxwvoL9AxKf3KYllbs_">
              <RelatingLibrary Name="Material Water" Language="en" />
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0XNIQ0qUuHuO00025QrE$V" Name="IsPotable" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>If TRUE, then the water is considered potable.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2PgOud3PbBCQzwgJ_SFssu">
                  <RelatingLibrary Name="Is Potable" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0dKmU0qUuHuO00025QrE$V" Name="Hardness" PrimaryMeasureType="IfcIonConcentrationMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Water hardness as positive, multivalent ion concentration in the water (usually concentrations of calcium and magnesium ions in terms of calcium carbonate).</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0uoXlpI0bBt9KXLBX0mqvM">
                  <RelatingLibrary Name="Hardness" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0ii580qUuHuO00025QrE$V" Name="AlkalinityConcentration" PrimaryMeasureType="IfcIonConcentrationMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Maximum alkalinity concentration (maximum sum of concentrations of each of the negative ions substances measured as CaCO3).</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3bLTLTNj5CmApn74u128BF">
                  <RelatingLibrary Name="Alkalinity Concentration" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0o3Po0qUuHuO00025QrE$V" Name="AcidityConcentration" PrimaryMeasureType="IfcIonConcentrationMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Maximum CaCO3 equivalent that would neutralize the acid.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3tijZFsxr0NR6S5VE28wkA">
                  <RelatingLibrary Name="Acidity Concentration" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0sERe0qUuHuO00025QrE$V" Name="ImpuritiesContent" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Fraction of impurities such as dust to the total amount of water. This is measured in weight of impurities per weight of water and is therefore unitless.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3Ol1XsPPf2NB4MuZ4Ajdj4">
                  <RelatingLibrary Name="Impurities Content" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0w$cu0qUuHuO00025QrE$V" Name="DissolvedSolidsContent" PrimaryMeasureType="IfcNormalisedRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Fraction of the dissolved solids to the total amount of water. This is measured in weight of dissolved solids per weight of water and is therefore unitless.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0BNVNK7DH4YwV9AhjccpOk">
                  <RelatingLibrary Name="Dissolved Solids Content" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0$mo80qUuHuO00025QrE$V" Name="PHLevel" PrimaryMeasureType="IfcPHMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Maximum water PH in a range from 0-14.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1sIFupHBT9e9oyJO7vqhTv">
                  <RelatingLibrary Name="PHLevel" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="1586o0qUuHuO00025QrE$V" Name="Pset_MaterialWood" ApplicableEntity="IfcMaterial/Wood">
