            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0KUWm0qSaHuO00025QrE$V" Name="NominalHeatRejectionRate" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Sum of the refrigeration effect and the heat equivalent of the power input to the compressor.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1d_zbkXxL8mgQHcjdtH3aj">
