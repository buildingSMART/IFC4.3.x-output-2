              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="24vbI0qUmHuO00025QrE$V" Name="ModelReference" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The model number or designator of the product model (or product line) as assigned by the manufacturer of the manufactured item.</Description>
              <HasAssociations>
