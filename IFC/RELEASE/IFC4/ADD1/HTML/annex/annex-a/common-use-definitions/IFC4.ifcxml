            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2Lpv_0qSKHuO00025QrE$V" Name="SprinklerProtectionAutomatic" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Indication whether this object has an automatic sprinkler protection (TRUE) or not (FALSE).
It should only be given, if the property "SprinklerProtection" is set to TRUE.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1OqShWWPLCYAdjGEHsCWoN">
                  <RelatingLibrary Name="Sprinklerschutz automatisch" Language="de-DE">
