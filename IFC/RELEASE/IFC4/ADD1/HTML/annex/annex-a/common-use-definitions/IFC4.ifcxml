                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2eQiY0qWSHuO00025QrE$V" Name="SurfaceColor" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The color of the surface.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3$$GJANdD5DfSf7JTfujfR">
                  <RelatingLibrary Name="Oberflächenfarbe" Language="de-DE" />
