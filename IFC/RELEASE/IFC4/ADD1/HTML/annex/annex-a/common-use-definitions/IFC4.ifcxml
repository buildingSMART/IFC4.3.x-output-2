            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2zYok0qVOHuO00025QrE$V" Name="TorsionalConstantX" PrimaryMeasureType="IfcMomentOfInertiaMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Torsional constant about xs. For example measured in mm4.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="30wXqhlRrCp8dQtzUk0n2V">
                  <RelatingLibrary Name="Torsional Constant X" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
