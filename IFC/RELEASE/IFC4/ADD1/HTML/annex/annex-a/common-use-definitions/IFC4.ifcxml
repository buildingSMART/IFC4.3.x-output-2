                    <Description>Coefficient de transmission thermique (U) qui s'applique à l'ensemble de la plaque.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="17il27wx10jwsddXzTucYf">
                  <RelatingLibrary Name="熱貫流率" Language="ja-JP">
                    <Description>材料の熱貫流率（U値）。すべての扉部材に適応される。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2pViv6cqXFeQQGzEiYY_h9">
                  <RelatingLibrary Name="导热系数" Language="zh-CN">
                    <Description>材料的导热系数（U值）。
适用于门的整体结构。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
