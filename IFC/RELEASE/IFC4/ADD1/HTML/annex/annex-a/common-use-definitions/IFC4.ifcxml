            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2aoKY0qUiHuO00025QrE$V" Name="NumberOfSources" PrimaryMeasureType="IfcInteger" SecondaryMeasureType="" AccessState="READWRITE">
