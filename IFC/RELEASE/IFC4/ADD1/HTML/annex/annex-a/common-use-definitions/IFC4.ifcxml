              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1GilOdRzD87epnhoOJfW9A">
                  <RelatingLibrary Name="Nominal Power Consumption" Language="en" />
                </IfcRelAssociatesLibrary>
