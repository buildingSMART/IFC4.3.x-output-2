              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2I2440qVOHuO00025QrE$V" Name="CentreOfGravityInY" PrimaryMeasureType="IfcLengthMeasure" SecondaryMeasureType="" AccessState="READWRITE">
