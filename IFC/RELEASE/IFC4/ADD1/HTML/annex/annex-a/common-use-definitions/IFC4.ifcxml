                  </IfcLabel>
                </EnumerationValues>
              </Enumerators>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3jt4IIYfn2Iw24Zev1oSSa" Name="LampCompensationType" PrimaryMeasureType="IfcLabel" AccessState="READWRITE">
              <Description>Identifies the form of compensation used for power factor correction and radio suppression.</Description>
              <HasAssociations>
