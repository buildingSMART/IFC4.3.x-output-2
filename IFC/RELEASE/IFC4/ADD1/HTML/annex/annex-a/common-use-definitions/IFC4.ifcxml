        <IfcPropertySetTemplate GlobalId="3Ba7g0qVqHuO00025QrE$V" Name="Pset_ProtectiveDeviceTypeEarthLeakageCircuitBreaker" ApplicableEntity="IfcProtectiveDevice/EARTHLEAKAGECIRCUITBREAKER">
          <Description>An earth failure device acts to protect people and equipment from the effects of current leakage.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="0$HplxI5j6AQsfgjh7fm$k">
              <RelatingLibrary Name="Protective Device Type Earth Leakage Circuit Breaker" Language="en" />
