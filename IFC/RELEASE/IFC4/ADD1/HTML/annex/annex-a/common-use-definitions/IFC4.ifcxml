            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="00HWS0qUaHuO00025QrE$V" Name="NominalHeight" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The nominal height of the furniture of this type. The size information is provided in addition to the shape representation and the geometric parameters used within. In cases of inconsistency between the geometric parameters and the size properties, provided in the attached property set, the geometric parameters take precedence.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2W_iJrrI59EBJbfGWHYiJx">
                  <RelatingLibrary Name="Nominal Height" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
