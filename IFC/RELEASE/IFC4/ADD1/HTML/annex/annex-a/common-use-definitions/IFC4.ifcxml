                  <RelatingLibrary Name="허용전류한계1" Language="ko-KR">
                    <Description>허용 전류 1 제한 시간 제한. 값이 0이면 제한이 없다.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3PaCm0qVeHuO00025QrE$V" Name="CurrentTolerance2" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The tolerance for the current of time/current-curve in [%] valid for times above CurrentTolereanceLimit1.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1Q47JhfGb8lQ86T2mh2i5V">
