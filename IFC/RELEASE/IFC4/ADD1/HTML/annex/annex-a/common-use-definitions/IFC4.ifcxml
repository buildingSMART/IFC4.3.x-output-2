                <IfcRelAssociatesLibrary GlobalId="2hBM895pf3zPhpjlyKockx">
                  <RelatingLibrary Identification="UNSET" Name="(unset)" Language="en">
                    <Description>Value has not been specified.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_ENUMERATEDVALUE</TemplateType>
              <Enumerators Name="PEnum_BuildingThermalExposure">
                <EnumerationValues>
                  <IfcLabel>
                    <Value>LIGHT</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>MEDIUM</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>HEAVY</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>NOTKNOWN</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>UNSET</Value>
                  </IfcLabel>
                </EnumerationValues>
              </Enumerators>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0dxPq0qV8HuO00025QrE$V" Name="PrevailingWindDirection" PrimaryMeasureType="IfcPlaneAngleMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The prevailing wind angle direction measured from True North (0 degrees) in a clockwise direction.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="265zdrdhP2sRR1ThlpfQ72">
                  <RelatingLibrary Name="Prevailing Wind Direction" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="04zq3BGQzEzPiD59ke$yJA">
                  <RelatingLibrary Name="卓越風の風向" Language="ja-JP">
                    <Description>卓越風の風向、真北は0°、時計回り。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="1UcxMEI254beS_FVU6eGOH">
                  <RelatingLibrary Name="탁월한 방람의 풍향" Language="ko-KR">
                    <Description>탁월한 바람의 풍향, 북쪽은 0 ° 시계 방향.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0jIkU0qV8HuO00025QrE$V" Name="PrevailingWindVelocity" PrimaryMeasureType="IfcLinearVelocityMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The design wind velocity coming from the direction specified by the PrevailingWindDirection attribute.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1RHMIn6_94bxXwwAwq9u6v">
