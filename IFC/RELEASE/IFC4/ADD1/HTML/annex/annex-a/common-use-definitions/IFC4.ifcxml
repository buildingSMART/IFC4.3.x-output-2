            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="35usQ0qVOHuO00025QrE$V" Name="WarpingConstant" PrimaryMeasureType="IfcWarpingConstantMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Warping constant of the profile for torsional action. For example measured in mm6.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2BDP8U$izF3xxpIw55D2Qg">
                  <RelatingLibrary Name="Warping Constant" Language="en" />
