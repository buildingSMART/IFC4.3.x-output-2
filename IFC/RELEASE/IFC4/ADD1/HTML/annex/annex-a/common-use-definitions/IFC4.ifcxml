              <Description>Close off rating.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2dEICZXRvFxwwcGiG1FHFd">
                  <RelatingLibrary Name="Close Off Rating" Language="en" />
