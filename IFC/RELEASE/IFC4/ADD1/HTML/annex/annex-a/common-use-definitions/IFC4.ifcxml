                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0OndVwRXLAsP2$Agx0Mm1j">
                  <RelatingLibrary Name="Illuminance" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3GwZUthab68AipbSw3e4d2">
                  <RelatingLibrary Name="EclairementAttendu" Language="fr-FR">
                    <Description>Valeur de l'éclairement attendu pour la pièce.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="1UtZt1shP6ZOMXSq_HHmHv">
                  <RelatingLibrary Name="照度" Language="ja-JP">
                    <Description>領域に対しての必要とされる照度の値の平均値。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0GPYw9UK1CkB7q1wWap$3f">
                  <RelatingLibrary Name="조도" Language="ko-KR">
                    <Description>이 공간을 위해 필요한 평균 조도</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="32MTg0qWeHuO00025QrE$V" Name="Pset_SpaceOccupancyRequirements" ApplicableEntity="IfcSpace, IfcSpatialZone, IfcZone">
          <Description>Properties concerning work activities occurring or expected to occur within one or a set of similar spatial structure elements.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="1BPNitQ1v2EB7wyjuZ93Wy">
