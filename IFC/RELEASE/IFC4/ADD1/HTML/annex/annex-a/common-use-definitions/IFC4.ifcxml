        <IfcPropertySetTemplate GlobalId="1B$wq0qVSHuO00025QrE$V" Name="Pset_ProjectOrderMaintenanceWorkOrder" ApplicableEntity="IfcProjectOrder/MAINTENANCEWORKORDER">
          <Description>A MaintenanceWorkOrder is a detailed description of maintenance work that is to be performed. Note that the Scheduled Frequency property of the maintenance work order is used when the order is required as an instance of a scheduled work order.</Description>
