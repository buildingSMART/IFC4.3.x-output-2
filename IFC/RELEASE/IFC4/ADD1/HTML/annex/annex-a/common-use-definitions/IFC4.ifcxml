                <IfcRelAssociatesLibrary GlobalId="3C0x_$jiDFP9a0pK$GzcQF">
                  <RelatingLibrary Name="랜드마크 구분" Language="ko-KR">
                    <Description>이 건물은 역사적인 건물 있는지 여부를 나타내는 값</Description>
                  </RelatingLibrary>
