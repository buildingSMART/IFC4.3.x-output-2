        <IfcPropertySetTemplate GlobalId="027CG0qWCHuO00025QrE$V" Name="Pset_SanitaryTerminalTypeShower" ApplicableEntity="IfcSanitaryTerminal/SHOWER">
          <Description>Installation or waste water appliance that emits a spray of water to wash the human body (BS6100). HISTORY: In IFC4, Material and MaterialThickness properties removed. Use materials capabilities from IfcMaterialsResource schema. Datatype of color changed to IfcLabel (still a string value)</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="27WCtY6Cb2ie6cwQQjNgYP">
