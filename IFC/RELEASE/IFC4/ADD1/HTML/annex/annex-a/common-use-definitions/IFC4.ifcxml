            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0gFLx2TTH0MOTWIaZPFrKC" Name="Height" AccessState="READWRITE">
              <Description>Total outer heigth of the door lining. It should only be provided, if it is a rectangular door.</Description>
