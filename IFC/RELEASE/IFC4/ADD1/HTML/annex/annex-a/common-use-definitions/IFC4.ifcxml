                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2r2kB1Mib3oxO_TSIebzsx">
                  <RelatingLibrary Identification="TT" Name="TT" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3Sqno5dsD4CxwfQ2p9_n5B">
