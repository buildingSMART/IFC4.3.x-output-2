                <IfcRelAssociatesLibrary GlobalId="1B$0fsF7L1RvImg4_2GS36">
                  <RelatingLibrary Name="建物高さ制限" Language="ja-JP">
                    <Description>各地域の建築基準により許可される建物の高さの最大値。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3IkkvnGcz7IQfXczOSLYjY">
                  <RelatingLibrary Name="건물 높이 제한" Language="ko-KR">
                    <Description>TotalArea / BuildableArea로 표시되는 이용 가능한 비율의 최대값입니다.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3gb0e0qWSHuO00025QrE$V" Name="TotalArea" PrimaryMeasureType="IfcAreaMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Total planned area for the site. Used for programming the site space.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2Q6Cjpgpz0TuPflTcTwttf">
                  <RelatingLibrary Name="Bruttogrundstücksfläche" Language="de-DE">
                    <Description>Gesamte Grundstücksfläche für diese Bauaufgabe.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3tgL8z4VL4JwbOpP34OVSz">
                  <RelatingLibrary Name="Total Area" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2kDczSKdb3Ff_xkTcvjZNW">
                  <RelatingLibrary Name="SurfaceBruteProgrammee" Language="fr-FR">
                    <Description>Surface totale brute. Définie en phase de programmation.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2d28HiV9DADQIblgczeMHm">
                  <RelatingLibrary Name="延べ面積" Language="ja-JP">
                    <Description>敷地にたいする延べ計画面積。敷地空間の計画に使用。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3O4_rVmN12FvFygLUxuf5p">
                  <RelatingLibrary Name="연면적" Language="ko-KR">
                    <Description>부지에 대한 총 계획 면적. 호텔 공간 계획에 사용됩니다.</Description>
                  </RelatingLibrary>
