            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2rCl20qVOHuO00025QrE$V" Name="MomentOfInertiaYZ" PrimaryMeasureType="IfcMomentOfInertiaMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Moment of inertia about ys and zs (product moment of area). For example measured in mm4.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2SZuk4IdP63vgLDpz5gbx3">
                  <RelatingLibrary Name="Moment Of Inertia YZ" Language="en" />
