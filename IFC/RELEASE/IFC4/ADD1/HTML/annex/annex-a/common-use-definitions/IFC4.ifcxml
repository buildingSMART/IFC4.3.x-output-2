                  <RelatingLibrary Name="Description" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2NqOGjn013tPupz4OhWczU">
                  <RelatingLibrary Name="説明" Language="ja-JP">
                    <Description>鉄筋の説明。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2aqqE0qVyHuO00025QrE$V" Name="Reference" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>A descriptive label for the general reinforcement type.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2lUYmjA$L89QtGnHNP0tuT">
