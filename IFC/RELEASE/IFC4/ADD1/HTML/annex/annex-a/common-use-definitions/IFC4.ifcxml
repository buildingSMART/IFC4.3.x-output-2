                  <RelatingLibrary Name="TypeOccupation" Language="fr-FR">
                    <Description>Usage type de cet espace. Est défini selon le Code national en vigueur.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2vnbJrFQjEfAzrfFrKZXKR">
                  <RelatingLibrary Name="用途" Language="ja-JP">
