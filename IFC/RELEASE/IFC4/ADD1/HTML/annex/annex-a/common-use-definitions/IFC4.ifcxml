            <IfcRelAssociatesLibrary GlobalId="3qVA0mvY53tAIB$2XV5JOC">
              <RelatingLibrary Language="ja-JP">
                <Description>電磁式または熱動式のトリップ装置の電流調整値。</Description>
              </RelatingLibrary>
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3Y_dwH6_H5FwQQ0Jj3_emI" Name="AdjustmentValueType" PrimaryMeasureType="IfcLabel" AccessState="READWRITE">
              <Description>The type of adjustment value that is applied through the property set. This determines the properties that should be asserted (see below).</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0vzX8VdxP1aw87ts8fc_n7">
                  <RelatingLibrary Name="Adjustment Value Type" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0SjakVgLr08QOw2uqjFakO">
                  <RelatingLibrary Name="調整値の型" Language="ja-JP">
                    <Description>調整値のタイプを設定。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0TAP7on4LCu9xfin3rJ8i6">
                  <RelatingLibrary Name="조정 형식" Language="ko-KR">
                    <Description>조정 값 유형을 설정합니다.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0ACzvZJuXFzPlk3xssfmUe">
                  <RelatingLibrary Identification="RANGE" Name="Range" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="1hLTKfDBT05uab55cWA$5J">
                  <RelatingLibrary Identification="LIST" Name="List" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_ENUMERATEDVALUE</TemplateType>
              <Enumerators Name="PEnum_AdjustmentValueType">
                <EnumerationValues>
                  <IfcLabel>
                    <Value>RANGE</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>LIST</Value>
                  </IfcLabel>
                </EnumerationValues>
              </Enumerators>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2mlGQ0qViHuO00025QrE$V" Name="AdjustmentRange" PrimaryMeasureType="IfcElectricCurrentMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Upper and lower current adjustment limits for an AdjustmentValueType = RANGE. Note that this property should not have a value for an  AdjustmentValueType = LIST.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3xp8Yilgn46uZt73AUqw6Q">
                  <RelatingLibrary Name="Adjustment Range" Language="en" />
                </IfcRelAssociatesLibrary>
