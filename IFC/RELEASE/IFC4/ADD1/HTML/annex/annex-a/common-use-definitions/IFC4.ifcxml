                <IfcRelAssociatesLibrary GlobalId="2BWIojezr14AT8FwjVjghX">
                  <RelatingLibrary Name="許容電流1" Language="ja-JP">
                    <Description>時間/特性曲線の許容範囲を[％]で指定。</Description>
                  </RelatingLibrary>
