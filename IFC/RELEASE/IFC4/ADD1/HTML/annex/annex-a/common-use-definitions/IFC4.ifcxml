                  <RelatingLibrary Name="Klimaanlage zentral" Language="de-DE">
                    <Description>Anforderung, ob die Klimaanlage zentral gesteuert werden soll (WAHR), oder nicht (FALSCH). Soll nur angegeben werden, wenn die Eigenschaft "Klimaanlage" mit WAHR gegeben ist.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="1zIwhEWXj14eU_lKbkrdr7">
