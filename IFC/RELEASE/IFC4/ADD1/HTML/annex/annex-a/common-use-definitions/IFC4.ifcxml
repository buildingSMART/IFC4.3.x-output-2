            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0TZSm0qWyHuO00025QrE$V" Name="GroupCode" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>e.g. panels, worksurfaces, storage, etc.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1lo77fRWH24eWnIZ0_CdpH">
                  <RelatingLibrary Name="Group Code" Language="en" />
                </IfcRelAssociatesLibrary>
