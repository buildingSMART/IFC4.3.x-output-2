              </RelatingLibrary>
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="38Jxk0qWeHuO00025QrE$V" Name="OccupancyType" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Occupancy type for this object. It is defined according to the presiding national building code.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3mZHYACS1FeQOwgORWrJjZ">
                  <RelatingLibrary Name="Nutzungsart" Language="de-DE">
                    <Description>Nutzungsart des Raums gemäß der gültigen Raumnutzungstabelle des Raumprogramms.</Description>
