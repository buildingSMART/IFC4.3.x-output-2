            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3v9GlTSDzClwzgroqc5m82" Name="LongTimeFunction" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Applying long time function
A flag indicating that the long time function (i.e. the thermal tripping) of the device is used. The value should be set to TRUE for all devices except those that allows the Long time function of the device not to be used.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3ksC$2enX5kfeVYBnSoM3_">
                  <RelatingLibrary Name="Long Time Function" Language="en" />
                </IfcRelAssociatesLibrary>
