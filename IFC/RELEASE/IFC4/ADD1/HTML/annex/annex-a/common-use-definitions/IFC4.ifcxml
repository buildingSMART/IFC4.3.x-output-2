                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="2htM00qSKHuO00025QrE$V" Name="Pset_BuildingSystemCommon" ApplicableEntity="IfcBuildingSystem">
