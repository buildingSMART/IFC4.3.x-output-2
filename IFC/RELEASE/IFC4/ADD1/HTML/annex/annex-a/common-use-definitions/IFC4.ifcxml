          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="08Yam0qS4HuO00025QrE$V" Name="Reference" PrimaryMeasureType="IfcIdentifier" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Reference ID for this specified type in this project (e.g. type 'A-1'), provided, if there is no classification reference to a recognized classification system used.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0rURD933P9WeVOparWlsvF">
