            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2biwU0qVOHuO00025QrE$V" Name="MomentOfInertiaY" PrimaryMeasureType="IfcMomentOfInertiaMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Moment of inertia about ys (second moment of area, about ys). For example measured in mm4.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2pKs5_rLH6reGif2Qj1ruD">
