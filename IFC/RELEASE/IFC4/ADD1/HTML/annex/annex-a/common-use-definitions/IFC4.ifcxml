          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0l_mm0qVKHuO00025QrE$V" Name="TypeDesignator" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Type designator for the precast concrete slab, expressing mainly the component type. Possible values are “Hollow-core”, “Double-tee”, “Flat plank”, etc.</Description>
