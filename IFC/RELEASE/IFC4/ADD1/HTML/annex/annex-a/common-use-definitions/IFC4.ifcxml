                  <IfcLabel>
                    <Value>OTHER</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>NOTKNOWN</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>UNSET</Value>
                  </IfcLabel>
                </EnumerationValues>
              </Enumerators>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
