                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2RxWltAjDAPhxrUt6toXTR" Name="ExposureClass" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Classification of exposure to environmental conditions, usually specified in accordance with the concrete design code which is applied in the project.</Description>
              <HasAssociations>
