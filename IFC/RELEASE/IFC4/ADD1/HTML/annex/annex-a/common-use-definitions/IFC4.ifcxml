              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0PFC40qSKHuO00025QrE$V" Name="NetPlannedArea" PrimaryMeasureType="IfcAreaMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Total planned net area for the building  Used for programming the building.</Description>
