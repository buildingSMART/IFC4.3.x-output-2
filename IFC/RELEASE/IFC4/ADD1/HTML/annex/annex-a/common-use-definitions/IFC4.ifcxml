            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="03Tys0qRuHuO00025QrE$V" Name="TotalAirflow" PrimaryMeasureType="IfcVolumetricFlowRateMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The total design supply air flowrate required for the system for either heating or cooling conditions, whichever is greater.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="16xVdvp9TEFAztZ84BPYRb">
                  <RelatingLibrary Name="Total Airflow" Language="en" />
                </IfcRelAssociatesLibrary>
