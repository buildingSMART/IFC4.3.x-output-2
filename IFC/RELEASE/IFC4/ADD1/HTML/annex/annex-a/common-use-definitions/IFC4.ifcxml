                <IfcRelAssociatesLibrary GlobalId="33lSG4vdf8m90DaxZ0zCOW">
                  <RelatingLibrary Name="허용 시간1" Language="ko-KR">
                    <Description>[%] 시간 / 특성 곡선의 허용 시간을 설정</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3kRL_0qVeHuO00025QrE$V" Name="TimeToleranceLimit1" PrimaryMeasureType="IfcElectricCurrentMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The current limit in [x In] limiting the application of TimeTolerance1, if any. If the value is set to 0, the value of the TimeTolerance1 is valid for the whole time/current-curve.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3M_TxhskT81f8RH8l094cl">
                  <RelatingLibrary Name="Time Tolerance Limit1" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0i4wU5MVn4$v7KRfhInaQ1">
                  <RelatingLibrary Name="許容限界時間1" Language="ja-JP">
                    <Description>許容時間1を制限する電流制限値。
値が0の場合は、制限はない。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2KihmSl5r389Z$Suzjn6DA">
