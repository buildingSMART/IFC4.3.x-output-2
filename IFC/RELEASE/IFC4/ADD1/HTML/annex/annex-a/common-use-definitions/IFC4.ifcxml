                    <Value>EXISTING</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>DEMOLISH</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>TEMPORARY</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>OTHER</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>NOTKNOWN</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>UNSET</Value>
                  </IfcLabel>
                </EnumerationValues>
              </Enumerators>
            </IfcPropertyTemplate>
