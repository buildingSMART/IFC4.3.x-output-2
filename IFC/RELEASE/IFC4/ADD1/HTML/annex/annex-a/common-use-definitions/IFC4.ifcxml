        <IfcPropertySetTemplate GlobalId="3lbf20qUeHuO00025QrE$V" Name="Pset_LampTypeCommon" ApplicableEntity="IfcLamp">
          <Description>A lamp is a component within a light fixture that is designed to emit light. 

History: Name changed from Pset_LampEmitterTypeCommon in IFC 2x3.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="0QxNefDu5AeQGjweKzUr6f">
              <RelatingLibrary Name="Lamp Type Common" Language="en" />
            </IfcRelAssociatesLibrary>
