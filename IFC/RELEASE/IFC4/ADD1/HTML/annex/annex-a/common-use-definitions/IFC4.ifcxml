                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2XmEU5oRn1XutRnd$G$pqc" Name="ReinforcementVolumeRatio" PrimaryMeasureType="IfcMassDensityMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The required ratio of the effective mass of the reinforcement to the effective volume of the concrete of a reinforced concrete structural element.</Description>
