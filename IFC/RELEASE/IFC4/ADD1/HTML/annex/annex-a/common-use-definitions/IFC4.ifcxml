            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0pV42acCLEIwfKf4JFHv3g" Name="ShortTimeFunction" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Applying short time function A flag indicating that the short time function of the device is used. The value should be set to FALSE for devices not having a short time function, or if the short time function is not selected to be used.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2OFEZZTjr8MvgJB3nF9iB3">
                  <RelatingLibrary Name="Short Time Function" Language="en" />
