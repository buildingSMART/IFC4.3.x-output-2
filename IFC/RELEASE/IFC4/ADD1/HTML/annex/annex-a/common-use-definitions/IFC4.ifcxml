            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0P_KM0qWqHuO00025QrE$V" Name="FireRating" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
