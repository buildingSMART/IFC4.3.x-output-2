                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="22u$Tb3JL2IBwmp$JCO9x9">
                  <RelatingLibrary Name="卓越風の風速" Language="ja-JP">
                    <Description>PrevailingWindDirection 属性に示された風向から来た卓越風の風速。</Description>
