                <IfcRelAssociatesLibrary GlobalId="2k8XK$yqvF3PhBf_o9Spnh">
                  <RelatingLibrary Name="搭乗人数定員" Language="ja-JP">
                    <Description>搬送要素の人数に関する容量。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="05Qtm0qX8HuO00025QrE$V" Name="CapacityWeight" PrimaryMeasureType="IfcMassMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Capacity of the transport element measured by weight.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0QycpBO$j4yR4ENScxVO5V">
                  <RelatingLibrary Name="Lastkapazität" Language="de-DE">
                    <Description>Kapazität nach Gewicht, das maximal befördert werden kann.</Description>
                  </RelatingLibrary>
