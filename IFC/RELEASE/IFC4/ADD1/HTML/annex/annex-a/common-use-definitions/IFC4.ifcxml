                <Description>Définition de l'IAI : propriétés communes à la définition de toutes les occurrences de la classe IfcCurtainWall</Description>
              </RelatingLibrary>
            </IfcRelAssociatesLibrary>
            <IfcRelAssociatesLibrary GlobalId="14JWrygSn3RBdtk_YFSMpH">
              <RelatingLibrary Language="ja-JP">
                <Description>IfcCurtainWall(カーテンウォール)オブジェクトに関する共通プロパティセット定義。</Description>
              </RelatingLibrary>
