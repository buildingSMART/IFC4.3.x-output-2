                  <RelatingLibrary Identification="SOMEWHATPOSSIBLE" Name="Somewhat Possible" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3bsBfp29H0oRL4hozo7sK1">
