            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="099k20qSaHuO00025QrE$V" Name="NominalCondensingTemperature" PrimaryMeasureType="IfcThermodynamicTemperatureMeasure" SecondaryMeasureType="" AccessState="READWRITE">
