              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2akL20qSiHuO00025QrE$V" Name="DimensionalAccuracyClass" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
