                  <RelatingLibrary Name="Bewehrungsgrad Volumen" Language="de-DE">
                    <Description>Das geforderte Verhältnis der effektiven Masse der Bewehrung im Verhältnis zur effektiven Masse des Betons für dieses Element.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0IwIjXf5nFW9gXRJakZS3C">
                  <RelatingLibrary Name="Reinforcement Volume Ratio" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="03QJXaBBz9ugaDD64qh7Hr" Name="ReinforcementAreaRatio" PrimaryMeasureType="IfcAreaDensityMeasure" SecondaryMeasureType="" AccessState="READWRITE">
