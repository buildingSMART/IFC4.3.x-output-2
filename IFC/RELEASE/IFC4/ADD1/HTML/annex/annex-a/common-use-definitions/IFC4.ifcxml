              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="20S6g0qV4HuO00025QrE$V" Name="FireRating" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Fire rating for this object.
It is given according to the national fire safety classification.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1iv1JJHmL55hO8_PVSg08P">
