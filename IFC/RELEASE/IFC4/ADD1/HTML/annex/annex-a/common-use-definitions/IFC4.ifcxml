                <IfcRelAssociatesLibrary GlobalId="0Jc2yuN9L4gvmFoxnG_wMJ">
                  <RelatingLibrary Name="CourbePerteChargeHydraulique" Language="fr-FR">
                    <Description>Courbe de perte de charge hydraulique, courbe perte de charge - débit, perte de charge = f(DébitHydraulique).</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_TABLEVALUE</TemplateType>
            </IfcPropertyTemplate>
