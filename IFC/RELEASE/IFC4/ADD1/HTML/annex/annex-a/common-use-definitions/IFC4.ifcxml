          <PredefinedType>PSET_PERFORMANCEDRIVEN</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3g9520qS0HuO00025QrE$V" Name="Enabled" PrimaryMeasureType="IfcTimeSeries" SecondaryMeasureType="IfcBoolean" AccessState="READWRITE">
              <Description>Indicates whether alarm is enabled or disabled over time.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0El52TBzL8mgWkmPkVryHe">
