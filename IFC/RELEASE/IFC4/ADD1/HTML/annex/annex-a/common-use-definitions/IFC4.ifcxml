            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3QoVK0qWeHuO00025QrE$V" Name="OccupancyTimePerDay" PrimaryMeasureType="IfcTimeMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The amount of time during the day that the activity is required within this space.</Description>
              <HasAssociations>
