                  <RelatingLibrary Identification="CONVEXCONVEX" Name="Convex Convex" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2Wzlom7oPDAxasjvEIVRLT">
