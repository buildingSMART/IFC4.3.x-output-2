                <IfcRelAssociatesLibrary GlobalId="2H7Ke09hT4KPcCnznTSjoT">
                  <RelatingLibrary Name="貯水タンクカラー" Language="ja-JP">
                    <Description>本体色。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
