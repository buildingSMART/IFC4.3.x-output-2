                <IfcRelAssociatesLibrary GlobalId="1JUiSs7yT8N99Vu7dT0TG$">
                  <RelatingLibrary Name="許容電流2" Language="ja-JP">
                    <Description>[％]で指定された時間/特性曲線の許容範囲は、上記の許容電流限界1の時間で有効です。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2cD4CF3nnFigyznth1lKHP">
                  <RelatingLibrary Name="허용전류 2" Language="ko-KR">
                    <Description>[%]로 지정된 시간 / 특성 곡선의 허용 범위는 상기의 허용 전류 한계 1 시간에 유효합니다.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3YWPs0qVeHuO00025QrE$V" Name="IsCurrentTolerancePositiveOnly" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Indication whether the value of  CurrentTolerance1 is provided as a positive tolereance only  or not. If not, the value is proved as a pluss/minus tolerance.</Description>
              <HasAssociations>
