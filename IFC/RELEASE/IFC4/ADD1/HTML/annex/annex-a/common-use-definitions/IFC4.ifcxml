                    <Description>建物IDが恒久的なIDかどうかのブーリアン値。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="30Qh0q571Aghgn0TJwVs9h">
