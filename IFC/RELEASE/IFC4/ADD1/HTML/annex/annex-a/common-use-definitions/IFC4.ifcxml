        <IfcPropertySetTemplate GlobalId="1WZtM0qVOHuO00025QrE$V" Name="Pset_ProfileMechanical" ApplicableEntity="IfcProfileDef">
          <Description>This is a collection of mechanical properties that are applicable to virtually all profile classes. Most of these properties are especially used in structural analysis.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="0cDnyr6b13CwuEnN1k0_ZB">
              <RelatingLibrary Name="Profile Mechanical" Language="en" />
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1bxC00qVOHuO00025QrE$V" Name="MassPerLength" PrimaryMeasureType="IfcMassPerLengthMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Mass per length, i.e. mass of a beam with a unit length of extrusion. For example measured in kg/m.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0wGdpJytr9teELIKhibBHa">
                  <RelatingLibrary Name="Mass Per Length" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1giNG0qVOHuO00025QrE$V" Name="CrossSectionArea" PrimaryMeasureType="IfcAreaMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Area of the profile. For example measured in mm2. If given, the value of the cross section area shall be greater than zero.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="23zNFPVdH1tucoTCe7_rhO">
                  <RelatingLibrary Name="Cross Section Area" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1m3hw0qVOHuO00025QrE$V" Name="Perimeter" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Perimeter of the profile for calculating the surface area. For example measured in mm.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2NG79NHY54wetqgubHVZa8">
                  <RelatingLibrary Name="Perimeter" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1sdJO0qVOHuO00025QrE$V" Name="MinimumPlateThickness" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>This value may be needed for stress analysis and to handle buckling problems. It can also be derived from the given profile geometry or classification and therefore it is only an optional feature allowing for an explicit description. For example measured in mm.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0Xvd7ZFPj4hus0_pxI0gBm">
                  <RelatingLibrary Name="Minimum Plate Thickness" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="20lpI0qVOHuO00025QrE$V" Name="MaximumPlateThickness" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>This value may be needed for stress analysis and to handle buckling problems. It can also be derived from the given profile geometry or classification and therefore it is only an optional feature allowing for an explicit description. For example measured in mm.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1mmZS3gO5Az8hGETXyZFhw">
                  <RelatingLibrary Name="Maximum Plate Thickness" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2AI9o0qVOHuO00025QrE$V" Name="CentreOfGravityInX" PrimaryMeasureType="IfcLengthMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Location of the profile's centre of gravity (geometric centroid), measured along xp.</Description>
              <HasAssociations>
