        <IfcPropertySetTemplate GlobalId="2AZMk0qUSHuO00025QrE$V" Name="Pset_FlowInstrumentPHistory" ApplicableEntity="IfcFlowInstrument">
          <Description>Properties for history of flow instrument values.  HISTORY: Added in IFC4.</Description>
          <HasAssociations>
