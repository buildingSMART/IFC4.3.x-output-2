        <IfcPropertySetTemplate GlobalId="3anmO0qS0HuO00025QrE$V" Name="Pset_AlarmPHistory" ApplicableEntity="IfcAlarm">
          <Description>Properties for history of alarm values.  HISTORY: Added in IFC4.</Description>
          <HasAssociations>
