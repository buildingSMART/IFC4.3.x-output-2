                <EnumerationValues>
                  <IfcLabel>
                    <Value>PHASE_L1</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>PHASE_L2</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>PHASE_L3</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>NEUTRAL</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>PROTECTIVEEARTH</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>PROTECTIVEEARTHNEUTRAL</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>OTHER</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>NOTKNOWN</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>UNSET</Value>
                  </IfcLabel>
                </EnumerationValues>
              </Enumerators>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1BMno0qTyHuO00025QrE$V" Name="NumberOfPoles" PrimaryMeasureType="IfcInteger" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The number of live lines that is intended to be handled by the device.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0SB59kqX9F0u$tale4MVyD">
                  <RelatingLibrary Name="Number Of Poles" Language="en" />
