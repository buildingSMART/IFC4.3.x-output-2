            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3mnhu0qUWHuO00025QrE$V" Name="Description" PrimaryMeasureType="IfcText" SecondaryMeasureType="" AccessState="READWRITE">
