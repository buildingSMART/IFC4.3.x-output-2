        <IfcPropertySetTemplate GlobalId="2658C0qUOHuO00025QrE$V" Name="Pset_FireSuppressionTerminalTypeFireHydrant" ApplicableEntity="IfcFireSuppressionTerminal/FIREHYDRANT">
          <Description>Device, fitted to a pipe, through which a temporary supply of water may be provided (BS6100 330 6107)

For further details on fire hydrants, see www.firehydrant.org</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="2vWx4uXODB5R7jEX6RGyPc">
              <RelatingLibrary Name="Fire Suppression Terminal Type Fire Hydrant" Language="en" />
