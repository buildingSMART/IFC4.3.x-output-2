            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2RBEe0qSKHuO00025QrE$V" Name="LoadBearingCapacity" PrimaryMeasureType="IfcPlanarForceMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Maximum load bearing capacity of the floor structure throughtout the storey as designed.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1Dakh8Zav5Me1KN1cFynTu">
                  <RelatingLibrary Name="Deckentragfähigkeit" Language="de-DE">
                    <Description>Maximale Deckentragfähigkeit in diesem Geschoss.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="1SLAxaM0P0Su8qmV8wbdzP">
                  <RelatingLibrary Name="Load Bearing Capacity" Language="en" />
