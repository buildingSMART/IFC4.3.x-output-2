        <IfcPropertySetTemplate GlobalId="1O7KU0qS8HuO00025QrE$V" Name="Pset_AudioVisualApplianceTypeCommon" ApplicableEntity="IfcAudioVisualAppliance">
          <Description>An audio-visual appliance is a device that renders or captures audio and/or video.  HISTORY: Added in IFC4.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="35tha4M_P5bPPF4BCioxOP">
              <RelatingLibrary Name="Audio Visual Appliance Type Common" Language="en" />
