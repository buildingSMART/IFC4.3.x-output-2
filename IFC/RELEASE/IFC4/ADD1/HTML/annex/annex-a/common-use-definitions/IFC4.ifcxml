        <IfcPropertySetTemplate GlobalId="0UfmK0qTyHuO00025QrE$V" Name="Pset_ElectricalDeviceCommon" ApplicableEntity="IfcDistributionElement">
          <Description>A collection of properties that are commonly used by electrical device types.</Description>
