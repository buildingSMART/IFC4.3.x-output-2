                <IfcRelAssociatesLibrary GlobalId="0$U5on6urDLgPrraJmO9qK">
                  <RelatingLibrary Name="Surface programmée brute" Language="fr-FR">
                    <Description>Surface programmée brute totale du bâtiment. Telle que définie lors de la programmation.</Description>
                  </RelatingLibrary>
