            <IfcRelAssociatesLibrary GlobalId="1T19vfGCXEp81WzCGFafX_">
              <RelatingLibrary Language="ja-JP">
                <Description>（BS61003306107）から供給される一時的な水を通す配管に取り付けられる装置。

消火栓の詳細については、www.firehydrant.orgを参照。</Description>
              </RelatingLibrary>
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
