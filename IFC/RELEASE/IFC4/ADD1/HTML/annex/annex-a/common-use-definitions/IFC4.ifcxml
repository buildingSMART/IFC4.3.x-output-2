            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2DZaKjBUH2dxPBANn$hwum" Name="Perimeter" AccessState="READWRITE">
              <Description>Total perimeter of the outer lining of the window.</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1cNmGWD3v1TePV8mQ7QVPH" Name="Area" AccessState="READWRITE">
              <Description>Total area of the outer lining of the window.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
