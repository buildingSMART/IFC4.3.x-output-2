                  <RelatingLibrary Name="給気量" Language="ja-JP">
                    <Description>暖房、冷房の条件の、いずれか大きい条件で要求される設計給気量。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="1ZxuzS58P5Iu8XqszhA9on">
