                <IfcRelAssociatesLibrary GlobalId="0q7vA1oxj3seStPNh$HkGW">
                  <RelatingLibrary Name="Profondeur" Language="fr-FR">
                    <Description>La profondeur requise ou épaisseur de la réservation.</Description>
