              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2x9z80qVGHuO00025QrE$V" Name="FormStrippingStrength" PrimaryMeasureType="IfcPressureMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The minimum required compressive strength of the concrete at form stripping time.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="1ZPHR8u4L2PuXzog6IXB7Y">
                  <RelatingLibrary Name="Form Stripping Strength" Language="en" />
