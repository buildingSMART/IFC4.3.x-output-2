                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3RgMMOTXvB_w0YTtgtqdI$">
                  <RelatingLibrary Identification="PLANNEDCORRECTIVE" Name="Planned Corrective" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2VTKAwbj1EwAT2yKh6TjNr">
                  <RelatingLibrary Identification="SCHEDULED" Name="Scheduled" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="32Ma1ahkn3HPKV9Xb9l0CU">
                  <RelatingLibrary Identification="OTHER" Name="(other)" Language="en">
                    <Description>Value is not listed.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3vrOJpi5P2fxKLUaQUVv_e">
                  <RelatingLibrary Identification="NOTKNOWN" Name="(unknown)" Language="en">
                    <Description>Value is unknown.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="2JkQoRfVvBCeQSaN9jcobc">
                  <RelatingLibrary Identification="UNSET" Name="(unset)" Language="en">
                    <Description>Value has not been specified.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_ENUMERATEDVALUE</TemplateType>
              <Enumerators Name="PEnum_MaintenanceType">
                <EnumerationValues>
                  <IfcLabel>
                    <Value>CONDITIONBASED</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>CORRECTIVE</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>PLANNEDCORRECTIVE</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>SCHEDULED</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>OTHER</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>NOTKNOWN</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>UNSET</Value>
                  </IfcLabel>
                </EnumerationValues>
              </Enumerators>
            </IfcPropertyTemplate>
