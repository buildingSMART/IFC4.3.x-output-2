        <IfcPropertySetTemplate GlobalId="3H8Po0qSmHuO00025QrE$V" Name="Pset_Condition" ApplicableEntity="IfcElement">
          <Description>Determines the state or condition of an element at a particular point in time.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="3XLIkXpxnF8upqms0$wSeo">
              <RelatingLibrary Name="Condition" Language="en" />
            </IfcRelAssociatesLibrary>
            <IfcRelAssociatesLibrary GlobalId="1Nn0c5sxT6xx5fIC9AmN98">
              <RelatingLibrary Language="ja-JP">
                <Description>ある時点における、FM要素の状態・状況を規定する属性情報。</Description>
              </RelatingLibrary>
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3N5ts0qSmHuO00025QrE$V" Name="AssessmentDate" PrimaryMeasureType="IfcDate" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Date on which the overall condition is assessed</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2$JBfN1Mr6rxWGwo0iQo7P">
                  <RelatingLibrary Name="Assessment Date" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0ckWW5m8T1HBanH4__Y_ho">
                  <RelatingLibrary Name="評価日" Language="ja-JP">
                    <Description>全体状況を評価した日。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3Rt360qSmHuO00025QrE$V" Name="AssessmentCondition" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The overall condition of a product based on an assessment of the contributions to the overall condition made by the various criteria considered. The meanings given to the values of assessed condition should be agreed and documented by local agreements. For instance, is overall condition measured on a scale of 1 - 10 or by assigning names such as Good, OK, Poor.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3fiyWkN6j6wwHN_bsb7W$Z">
                  <RelatingLibrary Name="Assessment Condition" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0aG_xqQI1CwuHpHZHZy1iQ">
                  <RelatingLibrary Name="評価状態" Language="ja-JP">
                    <Description>様々な基準を用いた評価による製品に関する全体的な状態。評価された状態値の意味は、ローカル協定によって同意され、文書化されなければならない。例えば、状態を1から10の値で計測したり、Good, Ok, Poor等で表す。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3XENm0qSmHuO00025QrE$V" Name="AssessmentDescription" PrimaryMeasureType="IfcText" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Qualitative description of the condition.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3jcVkT3wH6reVnoGHbVu8y">
                  <RelatingLibrary Name="Assessment Description" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="1eCd7aLhT14xCus5wLG42k">
                  <RelatingLibrary Name="評価記述" Language="ja-JP">
                    <Description>状態に関する定性的な記述。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
