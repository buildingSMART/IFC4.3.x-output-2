              <Description>Total nominal length of the railing, not taking into account any cut-out's or other processing features.</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="3f7yQt9z5BzBdPGtEdFQmX" Name="Qto_RampFlightBaseQuantities" ApplicableEntity="IfcRampFlight">
          <Description>Base quantities that are common to the definition of all occurrences of ramp flights.</Description>
          <HasAssociations />
          <PredefinedType>QTO_OCCURRENCEDRIVEN</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0$4SwF86bE$QwmhYFmB6qK" Name="Length" AccessState="READWRITE">
              <Description>Total length of the ramp flight along the walking line.</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="32rx05gtnDvgjTvyGpM0Qo" Name="Width" AccessState="READWRITE">
              <Description>Thickness of the ramp flight. It should only be provided, if it is constant. </Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0l9KrFkQD63ASiMGwUYhev" Name="GrossArea" AccessState="READWRITE">
              <Description>Total area of the ramp flight (not the projected area). Openings, recesses and projections are not taken into account. Only given, if the ramp flight is prismatic.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3UNiisa31CHgS54Dr0LqVv" Name="NetArea" AccessState="READWRITE">
              <Description>Total area of the ramp flight (not the projected area). Openings and recesses are taken into account by subtraction, projections by addition. Only given, if the ramp flight is prismatic.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2U5inrjAXBdRQfq8aA_g1w" Name="GrossVolume" AccessState="READWRITE">
              <Description>Total gross volume of the ramp flight. Openings, recesses, and projections are not taken into account. </Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1MUWysZoL8ghicG71UcuDU" Name="NetVolume" AccessState="READWRITE">
              <Description>Total net volume of the ramp flight. Openings and recesses are taken into account by subtraction, projections by addition. </Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="0tZ2DanIT1_fCpsj7YYx3Q" Name="Qto_RoofBaseQuantities" ApplicableEntity="IfcRoof">
          <Description>Base quantities that are common to the definition of all occurrences of roof.</Description>
          <HasAssociations />
          <PredefinedType>QTO_OCCURRENCEDRIVEN</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1AUdAkPhDA3uvXqB7ZPuXH" Name="GrossArea" AccessState="READWRITE">
              <Description>Total gross area of the outer surface of the roof. It is the sum of all roof slab gross areas. Roof openings, like sky windows and other openings and cut-outs are not taken into account.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3W3FWXA_D7N8LiDSVV0OZ1" Name="NetArea" AccessState="READWRITE">
              <Description>Total net area of the outer surface of the roof. It is the suma of all roof slab net areas. Roof openings, like sky windows and other openings and cut-outs are taken into account.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3LDMt_gKP7fhlvKYOeKaAl" Name="ProjectedArea" AccessState="READWRITE">
              <Description>Total gross area of the outer surfaces of the roof, projected tp the ground. It is the sum of all projected roof slab gross areas. Roof openings, like sky windows and other openings and cut-outs are not taken into account.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="3Teer8dn50W9jjbKI5cee0" Name="Qto_SlabBaseQuantities" ApplicableEntity="IfcSlab">
          <Description>Base quantities that are common to the definition of all occurrences of slabs.</Description>
          <HasAssociations />
          <PredefinedType>QTO_OCCURRENCEDRIVEN</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2UTGf_BiL18OOVGTICUElh" Name="Width" AccessState="READWRITE">
              <Description>Nominal width (or thickness) of the slab. Only given, if the slab is prismatic (constant thickess). </Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1_JsCbDjb769cEIAfBEkpM" Name="Length" AccessState="READWRITE">
              <Description>Length (one direction of the non-projected foot print area) of the slab. It shall only be provided, if the slab is rectangular.</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1ysbeJzk94o9y2xlTxp2zz" Name="Depth" AccessState="READWRITE">
              <Description>Depth (one direction of the non-projected foot print area) of the slab. It shall only be provided, if the slab is rectangular.
&lt;blockquote class="note"&gt;NOTE&amp;nbsp; Also refered to as width, but not to be confused with the "Width" quantity, that denotes the thickness in the context of the slab.&lt;/blockquote&gt;</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0jBYoZsJf9ZwSlyQQfC972" Name="Perimeter" AccessState="READWRITE">
              <Description>Perimeter measured along the outer boundaries of the slab. Only given, if the slab is prismatic (constant thickness).</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3MyAHjlNf2RA0IjaJYLywF" Name="GrossArea" AccessState="READWRITE">
              <Description>Total area of the extruded area of the slab. Openings, recesses and projections are not taken into account. Only given, if the slab is prismatic.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2z2Nxnx6j1yPK9bh7R_AfY" Name="NetArea" AccessState="READWRITE">
              <Description>Total area of the extruded area of the slab. Openings and recesses are taken into account by subtraction, projections by addition. Only given, if the slab is prismatic.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0l0Tb6f_T7Mw5XeMCjK$eJ" Name="GrossVolume" AccessState="READWRITE">
              <Description>Total gross volume of the slab. Openings, recesses, and projections are not taken into account. </Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0OWWotv$H21u8wdBh1Dyym" Name="NetVolume" AccessState="READWRITE">
              <Description>Total net volume of the slab. Openings and recesses are taken into account by subtraction, projections by addition. </Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0yjDnfAo90ZuV1jp$QXG_5" Name="GrossWeight" AccessState="READWRITE">
              <Description>Total gross weight of the slab without add-on parts, not taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_WEIGHT</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3LS6NtaF1AHQl1B1RaYfwr" Name="NetWeight" AccessState="READWRITE">
              <Description>Total net weight of the slab without add-on parts, taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_WEIGHT</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="123sGE3bvFjAn$oGC569Go" Name="Qto_StairFlightBaseQuantities" ApplicableEntity="IfcStairFlight">
          <Description>Base quantities that are common to the definition of all occurrences of stair flights.</Description>
          <HasAssociations />
          <PredefinedType>QTO_OCCURRENCEDRIVEN</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0Q8_u6wurALOdj4gvCMVKk" Name="Length" AccessState="READWRITE">
              <Description>Total length of the stair flight along the walking line.</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0ANy67NIr6l8cD24xr7sUe" Name="GrossVolume" AccessState="READWRITE">
              <Description>Total gross volume of the stair flight. Openings, recesses, and projections are not taken into account. </Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2$N65dqKH2guUiktqZRJrW" Name="NetVolume" AccessState="READWRITE">
              <Description>Total net volume of the stair flight. Openings and recesses are taken into account by subtraction, projections by addition. </Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="2zKRxnkjv1bv37dX5qEzZM" Name="Qto_WallBaseQuantities" ApplicableEntity="IfcWall">
          <Description>Base quantities that are common to the definition of all occurrences of walls.</Description>
          <HasAssociations />
          <PredefinedType>QTO_OCCURRENCEDRIVEN</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2QV00pQgXD$OeoqPgEIsPX" Name="Length" AccessState="READWRITE">
              <Description>Total nominal length of the wall along the wall center line (even if different to the wall path).</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0z9pgYKbn98PpAP0WRhMtk" Name="Width" AccessState="READWRITE">
              <Description>Total nominal width (or thickness) of the wall measured perpendicular to the wall path. It should only be provided, if it is constant along the wall path.</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2kHs8i3cn2wfyf28OoF2YS" Name="Height" AccessState="READWRITE">
              <Description>Total nominal height of the wall. It should only be provided, if it is constant along the wall path. </Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2_ttGjP218hg5jprq2H2Ly" Name="GrossFootprintArea" AccessState="READWRITE">
              <Description>Area of the wall as viewed by a ground floor view, not taking any wall modifications (like recesses) into account. It is also referred to as the foot print of the wall.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1zd2yjE2j4wRZzR6uz8jBW" Name="NetFootprintArea" AccessState="READWRITE">
              <Description>Area of the wall as viewed by a ground floor view, taking all wall modifications (like recesses) into account. It is also referred to as the foot print of the wall. </Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="10tCX23tf7VA5ruwQpoI7D" Name="GrossSideArea" AccessState="READWRITE">
              <Description>Area of the wall as viewed by an elevation view of the middle plane of the wall.  It does not take into account any wall modifications (such as openings). </Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3rArjNF6H0590GyfS_JNOI" Name="NetSideArea" AccessState="READWRITE">
              <Description>Area of the wall as viewed by an elevation view of the middle plane. It does take into account all wall modifications (such as openings). </Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3lRttIBGn7SuLixhf3M2qI" Name="GrossVolume" AccessState="READWRITE">
              <Description>Volume of the wall, without taking into account the openings and the connection geometry.</Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="26CIEIdCj57QGSuePOxEso" Name="NetVolume" AccessState="READWRITE">
              <Description>Volume of the wall, after subtracting the openings and after considering the connection geometry. </Description>
              <HasAssociations />
              <TemplateType>Q_VOLUME</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="30KETLSJn38f$pJk9B0vkx" Name="GrossWeight" AccessState="READWRITE">
              <Description>Total gross weight of the wall, without add-on parts, not taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_WEIGHT</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="18FizmiDb16Q5RRGOABeWk" Name="NetWeight" AccessState="READWRITE">
              <Description>Total net weight of the wall, without add-on parts, taking into account possible processing features (cut-out's, etc.) or openings and recesses.</Description>
              <HasAssociations />
              <TemplateType>Q_WEIGHT</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="3Q2rjhI8XAMQZxJrcoBw9O" Name="Qto_WindowBaseQuantities" ApplicableEntity="IfcWindow">
          <Description>Base quantities that are common to the definition of all occurrences of windows.</Description>
          <HasAssociations />
