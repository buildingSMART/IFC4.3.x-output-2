                <IfcRelAssociatesLibrary GlobalId="2Bc4ysurb6RPkrdk1_lTZt">
                  <RelatingLibrary Name="전류 허용 값" Language="ko-KR">
                    <Description>허용 전류 한계 값 1 만 여부  위의 경우, 전류 허용 값은 플러스 / 마이너스 값.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3eTtw0qVeHuO00025QrE$V" Name="TimeTolerance1" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
