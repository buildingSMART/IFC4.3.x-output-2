            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0IrZM0qXKHuO00025QrE$V" Name="IsNormallyOpen" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>If TRUE, the valve is normally open. If FALSE is is normally closed.</Description>
