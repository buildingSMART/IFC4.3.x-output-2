        <IfcPropertySetTemplate GlobalId="1amP00qW8HuO00025QrE$V" Name="Pset_SanitaryTerminalTypeCistern" ApplicableEntity="IfcSanitaryTerminal/CISTERN">
          <Description>A water storage unit attached to a sanitary terminal that is fitted with a device, operated automatically or by the user, that discharges water to cleanse a water closet (toilet) pan, urinal or slop hopper. (BS6100 330 5008)</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="3fC0C7euX3JflLmdclhOHA">
              <RelatingLibrary Name="Sanitary Terminal Type Cistern" Language="en" />
            </IfcRelAssociatesLibrary>
            <IfcRelAssociatesLibrary GlobalId="39bZFCkJD48xSFkDRvIjTu">
              <RelatingLibrary Language="ja-JP">
                <Description>衛生配管に接続されている貯水装置で、自動または手動により、大便器（トイレ）パン、小便器や汚物ホッパーなどを排水により洗浄する。 （BS61003305008）</Description>
              </RelatingLibrary>
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0bmdiKSHn95RwBqtsFkT$j" Name="CisternHeight" PrimaryMeasureType="IfcLabel" AccessState="READWRITE">
              <Description>Enumeration that identifies the height of the cistern or, if set to 'None' if the urinal has no cistern and is flushed using mains or high pressure water through a flushing valve.</Description>
