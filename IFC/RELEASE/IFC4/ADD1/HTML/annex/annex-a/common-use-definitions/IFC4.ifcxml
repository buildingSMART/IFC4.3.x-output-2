            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0PrrQ0qSaHuO00025QrE$V" Name="NominalPowerConsumption" PrimaryMeasureType="IfcPowerMeasure" SecondaryMeasureType="" AccessState="READWRITE">
