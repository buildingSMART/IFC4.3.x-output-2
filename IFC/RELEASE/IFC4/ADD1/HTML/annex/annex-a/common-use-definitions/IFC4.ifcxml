        <IfcPropertySetTemplate GlobalId="2aqKI0qViHuO00025QrE$V" Name="Pset_ProtectiveDeviceTrippingUnitCurrentAdjustment" ApplicableEntity="IfcProtectiveDeviceTrippingUnit">
          <Description>A set of current adjustment values that may be applied to an electronic or thermal tripping unit type.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="3Tv3k2KST4k9f7DUMeniyn">
              <RelatingLibrary Name="Protective Device Tripping Unit Current Adjustment" Language="en" />
