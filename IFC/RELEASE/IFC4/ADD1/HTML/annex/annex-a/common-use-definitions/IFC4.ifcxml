        <IfcPropertySetTemplate GlobalId="0B5P60qXCHuO00025QrE$V" Name="Pset_UnitaryControlElementPHistory" ApplicableEntity="IfcUnitaryControlElement">
          <Description>Properties for history and operating schedules of thermostats.  HISTORY: Added in IFC4.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="3gQKvwA6zDCwegJ7NAolG$">
              <RelatingLibrary Name="Unitary Control Element PHistory" Language="en" />
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_PERFORMANCEDRIVEN</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0GSjm0qXCHuO00025QrE$V" Name="Temperature" PrimaryMeasureType="IfcTimeSeries" SecondaryMeasureType="IfcThermodynamicTemperatureMeasure" AccessState="READWRITE">
              <Description>Indicates the current measured temperature.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3tHTOs7XnBGh4L8B91Yrxb">
                  <RelatingLibrary Name="Temperature" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_REFERENCEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0JRSo0qXCHuO00025QrE$V" Name="Mode" PrimaryMeasureType="IfcTimeSeries" SecondaryMeasureType="IfcIdentifier" AccessState="READWRITE">
              <Description>Indicates operation mode corresponding to Pset_UnitaryControlTypeCommon.Mode.  For example, 'HEAT', 'COOL', 'AUTO'.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0rh7vV0Cf7ShgURQSvRQN2">
                  <RelatingLibrary Name="Mode" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_REFERENCEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0N0LE0qXCHuO00025QrE$V" Name="Fan" PrimaryMeasureType="IfcTimeSeries" SecondaryMeasureType="IfcLogical" AccessState="READWRITE">
              <Description>Indicates fan operation where True is on, False is off, and Unknown is automatic.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="3Myg97BPPE_ABczFPowSxr">
                  <RelatingLibrary Name="Fan" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
