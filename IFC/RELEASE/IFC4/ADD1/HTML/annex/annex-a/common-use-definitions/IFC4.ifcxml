            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="38Zlgo4MT5Qw5N3uNdMkcX" Name="Perimeter" AccessState="READWRITE">
              <Description>Total perimeter of the outer lining of the door.</Description>
              <HasAssociations />
              <TemplateType>Q_LENGTH</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="2fTFaERUvE1u9ncP44Q1Bw" Name="Area" AccessState="READWRITE">
              <Description>Total area of the outer lining of the door.</Description>
              <HasAssociations />
              <TemplateType>Q_AREA</TemplateType>
            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="3XU8jrB9vFrvMNz5RkCbWh" Name="Qto_MemberBaseQuantities" ApplicableEntity="IfcMember">
          <Description>Base quantities that are common to the definition of all occurrences of members.</Description>
