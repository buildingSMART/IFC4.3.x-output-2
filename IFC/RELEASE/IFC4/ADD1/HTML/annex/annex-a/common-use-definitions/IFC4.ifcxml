            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0iAu3GB1T2o9EkC8sixFRH" Name="FireHydrantType" PrimaryMeasureType="IfcLabel" AccessState="READWRITE">
              <Description>Defines the range of hydrant types from which the required type can be selected where.

DryBarrel:	 A hydrant that has isolating valves fitted below ground and that may be used where the possibility of water freezing is a consideration.
WetBarrel:	 A hydrant that has isolating valves fitted above ground and that may be used where there is no possibility of water freezing.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="32IPXcD4TFYeoXINBb_O$O">
                  <RelatingLibrary Name="Fire Hydrant Type" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3aVNOI50TCChLYEeD8tJOi">
                  <RelatingLibrary Name="消火栓のタイプ" Language="ja-JP">
                    <Description>消火栓の必要なタイプを定義する。

乾式l：凍結の可能性のあるとき地中に開放弁セット。

湿式：凍結の可能性のないとき地上に開放弁セット。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="12y3JVnaH3Dx_mJy7Dealm">
                  <RelatingLibrary Identification="DRYBARREL" Name="Dry Barrel" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3gA3OeYNr1o9Qc4H6aESmp">
                  <RelatingLibrary Identification="WETBARREL" Name="Wet Barrel" Language="en" />
