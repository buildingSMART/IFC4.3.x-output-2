              <Description>Step value of current adjustment for an AdjustmentValueType = RANGE. Note that this property should not have a value for an  AdjustmentValueType = LIST.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="2PV0wRM_52mRAdT1pD$Jj_">
                  <RelatingLibrary Name="Adjustment Range Step Value" Language="en" />
