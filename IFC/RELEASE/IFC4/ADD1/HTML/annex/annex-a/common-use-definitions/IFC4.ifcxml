                  <RelatingLibrary Name="Topping Type" Language="en" />
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0yVsI0qVKHuO00025QrE$V" Name="EdgeDistanceToFirstAxis" PrimaryMeasureType="IfcPositiveLengthMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The distance from the left (‘West’) edge of the slab (in the direction of span of the components) to the axis of the first component.</Description>
              <HasAssociations>
