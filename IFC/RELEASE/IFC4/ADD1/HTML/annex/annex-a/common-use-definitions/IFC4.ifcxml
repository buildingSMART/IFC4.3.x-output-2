            </IfcPropertyTemplate>
          </HasPropertyTemplates>
        </IfcPropertySetTemplate>
        <IfcPropertySetTemplate GlobalId="1SK660qT0HuO00025QrE$V" Name="Pset_CoveringFlooring" ApplicableEntity="IfcCovering/FLOORING,">
          <Description>Properties common to the definition of all occurrence and type objects of covering with the predefined type set to FLOORING.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="0PwdVJAm1AJeYO5lRtO9gf">
              <RelatingLibrary Name="Covering Flooring" Language="en" />
