            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="24ORG0qXGHuO00025QrE$V" Name="FlowCoefficient" PrimaryMeasureType="IfcReal" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Flow coefficient (the quantity of fluid that passes through a fully open valve at unit pressure drop), typically expressed as the Kv or Cv value for the valve.</Description>
              <HasAssociations>
