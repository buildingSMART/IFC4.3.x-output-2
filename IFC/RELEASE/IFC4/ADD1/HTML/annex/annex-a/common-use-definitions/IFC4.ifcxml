                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3pCXE0qVeHuO00025QrE$V" Name="TimeTolerance2" PrimaryMeasureType="IfcPositiveRatioMeasure" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>The tolerance for the time of the time/current-curve in [%] valid for currents above TimeToleranceLimit1.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0dfs9FZErFsQL8kUeboDYK">
                  <RelatingLibrary Name="Time Tolerance2" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3tovEttZHF8eDDOk6IzVVF">
