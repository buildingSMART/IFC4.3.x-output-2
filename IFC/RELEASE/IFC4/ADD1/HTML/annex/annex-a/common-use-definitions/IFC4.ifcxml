            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="1Gk6S0qTyHuO00025QrE$V" Name="HasProtectiveEarth" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Indicates whether the electrical device has a protective earth connection (=TRUE) or not (= FALSE).</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0NF$yiR99DE8u$ET27I91m">
                  <RelatingLibrary Name="Has Protective Earth" Language="en" />
