        <IfcPropertySetTemplate GlobalId="0XOYG0qVWHuO00025QrE$V" Name="Pset_PropertyAgreement" ApplicableEntity="IfcSpatialStructureElement">
          <Description>A property agreement is an agreement that enables the occupation of a property for a period of time.

The objective is to capture the information within an  agreement that is relevant to a facilities manager. Design and construction information associated with the property is not considered. A property agreement may be applied to an instance of IfcSpatialStructureElement including to compositions defined through the IfcSpatialStructureElement.Element.CompositionEnum.

Note that the associated actors are captured by the IfcOccupant class.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="0Vnct$aED60uEjpGchwUxm">
              <RelatingLibrary Name="Property Agreement" Language="en" />
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="3MxbCTj6D5WRRFNgwF85B2" Name="AgreementType" PrimaryMeasureType="IfcLabel" AccessState="READWRITE">
              <Description>Identifies the predefined types of property agreement from which the type required may be set.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="0XtNu$cnPDMhdp4PYXYq4y">
                  <RelatingLibrary Name="Agreement Type" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0te4pjPTrCuwqu1S6Kza5t">
                  <RelatingLibrary Identification="ASSIGNMENT" Name="Assignment" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3jLod3RLn8s8PRRQRmdVPd">
                  <RelatingLibrary Identification="LEASE" Name="Lease" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3ZauwxWKn9BuxcorRYmYbk">
                  <RelatingLibrary Identification="TENANT" Name="Tenant" Language="en" />
