        <IfcPropertySetTemplate GlobalId="1kCWI0qT0HuO00025QrE$V" Name="Pset_CurtainWallCommon" ApplicableEntity="IfcCurtainWall">
          <Description>Properties common to the definition of all occurrences of IfcCurtainWall.</Description>
          <HasAssociations>
            <IfcRelAssociatesLibrary GlobalId="1v0IgHzVn4cvmOywXuc5tu">
