            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0kSL_TGuH03A_UVNvomUrf" Name="TrapType" PrimaryMeasureType="IfcLabel" AccessState="READWRITE">
              <Description>Identifies the predefined types of waste trap used in combination with the floor trap from which the type required may be set.</Description>
              <HasAssociations>
