                    <Description>시간 조정 값을 1에서 16로 설정. 범위는없는 것을주의.</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_LISTVALUE</TemplateType>
            </IfcPropertyTemplate>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="34Q6q0qViHuO00025QrE$V" Name="AdjustmentDesignation" PrimaryMeasureType="IfcLabel" SecondaryMeasureType="" AccessState="READWRITE">
