                <EnumerationValues>
                  <IfcLabel>
                    <Value>CERAMICDISC</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>LEVERHANDLE</Value>
                  </IfcLabel>
                  <IfcLabel>
                    <Value>NONCONCUSSIVESELFCLOSING</Value>
                  </IfcLabel>
                  <IfcLabel>
