            <IfcRelAssociatesLibrary GlobalId="2rKUZ32wPF0QtaJj4ybjD4">
              <RelatingLibrary Language="ja-JP">
                <Description>トリッピング関数は、電子トリッピング装置に適用される。
（例えば、トリッピング装置は、電子トリッピング定義されたプロパティセットタイプを持っている）
これらは、熱,熱電磁,RCDトリッピング装置に適用されない。
このプロパティセットは、電子保護装置の遅延短絡保護(L-curve)を表す。</Description>
              </RelatingLibrary>
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
            <IfcPropertyTemplate xsi:type="IfcSimplePropertyTemplate" GlobalId="0ASG40qViHuO00025QrE$V" Name="IsSelectable" PrimaryMeasureType="IfcBoolean" SecondaryMeasureType="" AccessState="READWRITE">
              <Description>Indication whether the L-function can be switched off or not.</Description>
              <HasAssociations>
                <IfcRelAssociatesLibrary GlobalId="35m9jj$_5FZxble$OQf1lz">
                  <RelatingLibrary Name="Is Selectable" Language="en" />
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="3ri9LRWXzA_QEQq26km_Vu">
                  <RelatingLibrary Name="切り替え" Language="ja-JP">
                    <Description>装置の “ON-OFF”状態を電気的表示が切り替え可能かどうか。</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
                <IfcRelAssociatesLibrary GlobalId="0pKZEY4mbDWwgIrJQTad6r">
                  <RelatingLibrary Name="전환" Language="ko-KR">
                    <Description>장치의 "ON-OFF"상태를 전기적으로 표시가 교체 가능합니까?</Description>
                  </RelatingLibrary>
                </IfcRelAssociatesLibrary>
              </HasAssociations>
              <TemplateType>P_SINGLEVALUE</TemplateType>
            </IfcPropertyTemplate>
