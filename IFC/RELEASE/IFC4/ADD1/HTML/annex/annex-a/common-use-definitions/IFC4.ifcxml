            <IfcRelAssociatesLibrary GlobalId="0N0BwWxbvF$hDPvCkgk6aK">
              <RelatingLibrary Language="ja-JP">
                <Description>漏電回路遮断機は、人々と器材を漏電電流の影響から保護する動作を行います。</Description>
              </RelatingLibrary>
            </IfcRelAssociatesLibrary>
          </HasAssociations>
          <PredefinedType>PSET_TYPEDRIVENOVERRIDE</PredefinedType>
          <HasPropertyTemplates>
