<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcSharedBldgElements"/>
  <Name>Pset_SlabCommon</Name>
  <Definition>Definition from IAI: Properties common to the definition of all IfcSlab.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcSlab</TypedClass>
  <TypeName></TypeName>
  <PropertyDefs>
    <PropertyDef id="102">
      <Name>Reference</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcIdentifier"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="n/a"/>
        <MaxValue value="n/a"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Reference ID for this slab type in this project (e.g. type 'A-1')
      </Definition>
    </PropertyDef>

    <PropertyDef id="34">
      <Name>Description</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Textual description for this floor type.
      </Definition>
    </PropertyDef>

    <PropertyDef id="239">
      <Name>FireRating</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="empty string"/>
      </ValueDef>
      <Definition>
Fire rating of slab.
      </Definition>
    </PropertyDef>

    <PropertyDef id="238">
      <Name>ThermalTransmittanceCoefficient</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcThermalTransmittanceMeasure"/>
          <UnitType type="ThermalTransmittanceUnit"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Thermal transmittance coefficient (U-Value) of a material.
      </Definition>
    </PropertyDef>

    <PropertyDef id="216">
      <Name>AcousticRating</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcString"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Rating for sound protection (Sound Transference Factor =STF).
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>