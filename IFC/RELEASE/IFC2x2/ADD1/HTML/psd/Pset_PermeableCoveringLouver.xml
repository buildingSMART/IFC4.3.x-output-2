<?xml version="1.0"?>
<!DOCTYPE PropertySetDef SYSTEM "PSD_R2x.dtd">
<?xml-stylesheet type="text/xsl" href="PSD_R2x.xsl"?>
<PropertySetDef>
  <IfcVersion version="2.x" schema="IfcArchitectureDomain"/>
  <Name>Pset_PermeableCoveringLouver</Name>
  <Definition>Definition from IAI: Properties common to the definition of all types "Louver" of all IfcPermeableCovering.</Definition>
  <Typed>True</Typed>
  <TypedClass>IfcPermeableCovering</TypedClass>
  <TypeName>Louver</TypeName>
  <PropertyDefs>
    <PropertyDef id="163">
      <Name>FinSpacing</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="see type"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Distance between adjacent fins.
      </Definition>
    </PropertyDef>

    <PropertyDef id="562">
      <Name>FinAngle</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPlaneAngleMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="360"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Slope angle of the fins, in cross-sectional view with finished (or exterior) face on the right side of the section. Horizontal fin angle is taken to be zero ("0") angle.
      </Definition>
    </PropertyDef>

    <PropertyDef id="559">
      <Name>FinDepth</Name>
      <PropertyType>
        <TypePropertySingleValue>
          <DataType type="IfcPositiveLengthMeasure"/>
        </TypePropertySingleValue>
      </PropertyType>
      <ValueDef>
        <MinValue value="0"/>
        <MaxValue value="see type"/>
        <DefaultValue value="0"/>
      </ValueDef>
      <Definition>
Fin depth measure, in cross-sectional view.
      </Definition>
    </PropertyDef>

  </PropertyDefs>
</PropertySetDef>